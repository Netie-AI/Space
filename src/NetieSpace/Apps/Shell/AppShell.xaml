<UserControl x:Class="NetieSpace.Apps.Shell.AppShell"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:NetieSpace.Apps.Shell"
             AllowDrop="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="AppTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid Background="{DynamicResource ShellPaper}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource ShellSidebar}"
                    BorderBrush="{DynamicResource ShellLine}" BorderThickness="0,0,1,0">
                <DockPanel Margin="16,18,16,16">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,20">
                        <Border Width="32" Height="32" CornerRadius="{StaticResource ShellRadiusControl}" Background="{DynamicResource ShellAccent}">
                            <TextBlock x:Name="AppGlyph" FontWeight="Bold" FontSize="16"
                                       Foreground="{DynamicResource ShellAccentInk}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="AppName" Style="{StaticResource ShellSection}"
                                   Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel x:Name="FamilyPanel" DockPanel.Dock="Bottom" Margin="0,12,0,0"/>
                    <Button x:Name="PaletteButton" DockPanel.Dock="Top" Margin="0,0,0,12"
                            AutomationProperties.Name="Quick search" ToolTip="Search every tool and recent file (Ctrl+K)"
                            HorizontalContentAlignment="Stretch">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="Ctrl+K" Style="{StaticResource ShellCaption}" VerticalAlignment="Center"/>
                            <TextBlock Text="Quick search" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Button>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <StackPanel x:Name="NavPanel"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1">
                <Border Height="3" VerticalAlignment="Top" Background="{DynamicResource ShellAccent}" Panel.ZIndex="2"/>
                <local:HomeView x:Name="Home"/>
                <local:ToolPageView x:Name="ToolPage" Visibility="Collapsed"/>
            </Grid>
        </Grid>

        <!-- The whole window is a drop target: this shows it while a file is over it. It never takes the mouse. -->
        <Border x:Name="DropOverlay" Visibility="Collapsed" IsHitTestVisible="False" Panel.ZIndex="20"
                Background="{DynamicResource ShellPaper}" Opacity="0.94" AutomationProperties.Name="Drop a file">
            <Border Margin="24" BorderBrush="{DynamicResource ShellAccent}" BorderThickness="3" CornerRadius="16"
                    Background="{DynamicResource ShellAccentTint}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock x:Name="DropTitle" Style="{StaticResource ShellTitle}" TextAlignment="Center"
                               Foreground="{DynamicResource ShellAccentStrong}"/>
                    <TextBlock Text="Release to see the tools that suit it" Style="{StaticResource ShellMutedText}"
                               FontSize="14" TextAlignment="Center" Margin="0,8,0,0"
                               Foreground="{DynamicResource ShellInk}"/>
                </StackPanel>
            </Border>
        </Border>

        <local:CommandPaletteView x:Name="Palette" Visibility="Collapsed" Panel.ZIndex="30"/>

        <Grid x:Name="HelpOverlay" Visibility="Collapsed" Panel.ZIndex="31">
            <Border x:Name="HelpScrim" Background="#99000000"/>
            <Border Style="{StaticResource ShellCard}" Width="520" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Padding="24" AutomationProperties.Name="Keyboard help">
                <StackPanel>
                    <TextBlock Text="Keyboard help" Style="{StaticResource ShellTitle}" FontSize="20"/>
                    <StackPanel x:Name="HelpRows" Margin="0,14,0,0"/>
                    <Button x:Name="HelpCloseButton" Content="Close" AutomationProperties.Name="Close help"
                            HorizontalAlignment="Right" Margin="0,18,0,0" MinWidth="88"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
