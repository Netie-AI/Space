<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      Light chrome of the Netie app family (PDF / Image / Video). Merged into AppShell only, so the
      Quick Look dark-glass implicit styles in App.xaml stay untouched everywhere else. Self-contained:
      it defines its own fonts and brushes and references nothing from App.xaml.
      Values are distilled from the document chrome (white fields, #D6D6D6 hairlines, #2C2C2C ink,
      4px corners, soft grey hover) with the product accent #5EC4B8 on the single action button.
    -->

    <FontFamily x:Key="ShellBodyFont">Bahnschrift, Segoe UI Variable Text, Segoe UI Variable, Helvetica Neue, Segoe UI</FontFamily>
    <FontFamily x:Key="ShellDisplayFont">Bahnschrift, Segoe UI Variable Display, Segoe UI Variable, Helvetica Neue, Segoe UI</FontFamily>

    <!-- ShellPaper, ShellSidebar, ShellSurface, ShellInk, ShellMuted, ShellLine, ShellHover, ShellPress, ShellDanger, ShellThumb,
         ShellThumbHover and ShellFocus are not defined here either: ShellThemeInstaller puts the light or the dark set (ShellPalette)
         in Application.Resources, and everything reads them with DynamicResource, so the window repaints when Windows switches theme. -->
    <!-- ShellAccent, ShellAccentHover, ShellAccentPress, ShellAccentTint, ShellAccentStrong and ShellAccentInk are
         not defined here: each app process installs its own (PDF red, Image teal, Video violet, MD slate) in
         Application.Resources through AppAccents, and everything below reads them with DynamicResource. -->

    <!-- One visual system: spacing steps 4 / 8 / 12 / 16 / 24 / 32, radii 6 (controls) and 10 (cards, tiles),
         type 24 title / 15 section / 13 body / 12 label / 11.5 caption. -->
    <CornerRadius x:Key="ShellRadiusControl">6</CornerRadius>
    <CornerRadius x:Key="ShellRadiusCard">10</CornerRadius>

    <!-- The keyboard focus ring: 2 px, 3 px outside the control, the same on every control that takes focus. -->
    <Style x:Key="ShellFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3" Stroke="{DynamicResource ShellFocus}" StrokeThickness="2" RadiusX="8" RadiusY="8"
                               SnapsToDevicePixels="True" IsHitTestVisible="False"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Text -->
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource ShellBodyFont}"/>
        <Setter Property="Foreground" Value="{DynamicResource ShellInk}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>
    <Style x:Key="ShellMutedText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="{DynamicResource ShellMuted}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="ShellTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontFamily" Value="{StaticResource ShellDisplayFont}"/>
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="ShellSection" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontFamily" Value="{StaticResource ShellDisplayFont}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- Buttons -->
    <Style x:Key="ShellButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource ShellFocusVisual}"/>
        <Setter Property="FontFamily" Value="{StaticResource ShellBodyFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource ShellInk}"/>
        <Setter Property="Background" Value="{DynamicResource ShellSurface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ShellLine}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,7"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource ShellRadiusControl}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource ShellHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource ShellPress}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource ShellButton}"/>

    <Style x:Key="ShellActionButton" TargetType="Button" BasedOn="{StaticResource ShellButton}">
        <Setter Property="Background" Value="{DynamicResource ShellAccent}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ShellAccent}"/>
        <Setter Property="Foreground" Value="{DynamicResource ShellAccentInk}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="18,9"/>
        <Setter Property="MinHeight" Value="38"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource ShellRadiusControl}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource ShellAccentHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource ShellAccentPress}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Sidebar rows: flat, left aligned; the selected row takes the accent tint -->
    <Style x:Key="ShellNavItem" TargetType="Button" BasedOn="{StaticResource ShellButton}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Margin" Value="0,0,0,2"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="MinHeight" Value="34"/>
    </Style>
    <Style x:Key="ShellNavItemOn" TargetType="Button" BasedOn="{StaticResource ShellNavItem}">
        <Setter Property="Background" Value="{DynamicResource ShellAccentTint}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- Tool tile on the home grid -->
    <Style x:Key="ShellTile" TargetType="Button" BasedOn="{StaticResource ShellButton}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="Margin" Value="0,0,12,12"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <!-- 226 + 12 gap: four across a 1280 wide window with the scroll bar showing
             (1280 - 240 sidebar - 64 margins - 12 scroll bar = 964). -->
        <Setter Property="Width" Value="226"/>
        <Setter Property="MinHeight" Value="68"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource ShellRadiusCard}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource ShellAccent}"/>
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource ShellSidebar}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource ShellPress}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Card: the one container for the preview, the result and the unavailable notice -->
    <Style x:Key="ShellCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ShellSurface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ShellLine}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource ShellRadiusCard}"/>
        <Setter Property="Padding" Value="16"/>
    </Style>

    <!-- Icon-font text (Segoe Fluent Icons on Windows 11, Segoe MDL2 Assets on Windows 10) -->
    <Style x:Key="ShellIcon" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
        <Setter Property="Foreground" Value="{DynamicResource ShellAccentStrong}"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextAlignment" Value="Center"/>
    </Style>
    <Style x:Key="ShellCaption" TargetType="TextBlock" BasedOn="{StaticResource ShellMutedText}">
        <Setter Property="FontSize" Value="11.5"/>
    </Style>

    <!-- Text input -->
    <Style TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource ShellBodyFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource ShellInk}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource ShellInk}"/>
        <Setter Property="Background" Value="{DynamicResource ShellSurface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ShellLine}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="9,6"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource ShellRadiusControl}">
                        <!-- No Padding here: the TextBox applies its own Padding inside PART_ContentHost,
                             so a second copy on the border pushed typed text 9 px right of the hint. -->
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource ShellFocus}"/>
                            <Setter TargetName="bd" Property="BorderThickness" Value="2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Drop-down -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="FontFamily" Value="{StaticResource ShellBodyFont}"/>
        <Setter Property="Background" Value="{DynamicResource ShellSurface}"/>
        <Setter Property="Foreground" Value="{DynamicResource ShellInk}"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ShellAccentTint}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="FocusVisualStyle" Value="{StaticResource ShellFocusVisual}"/>
        <Setter Property="FontFamily" Value="{StaticResource ShellBodyFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Background" Value="{DynamicResource ShellSurface}"/>
        <Setter Property="Foreground" Value="{DynamicResource ShellInk}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ShellLine}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="ToggleButton" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="{StaticResource ShellRadiusControl}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="28"/>
                                            </Grid.ColumnDefinitions>
                                            <Path Grid.Column="1" Data="M0,0 L4,4 L8,0" Stroke="{DynamicResource ShellInk}"
                                                  StrokeThickness="1.5" HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ShellSidebar}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                          Margin="10,6,32,6" VerticalAlignment="Center"
                                          HorizontalAlignment="Left"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
                        <Popup x:Name="Popup" Placement="Bottom" AllowsTransparency="True"
                               Focusable="False" IsOpen="{TemplateBinding IsDropDownOpen}"
                               PopupAnimation="None">
                            <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Background="{DynamicResource ShellSurface}" BorderBrush="{DynamicResource ShellLine}" BorderThickness="1"
                                    CornerRadius="{StaticResource ShellRadiusControl}" Margin="0,2,0,0" Padding="2">
                                <ScrollViewer CanContentScroll="True">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Expander: the "Details" fold under an error. A flat header with an arrow, the same focus ring as every control. -->
    <Style TargetType="Expander">
        <Setter Property="FontFamily" Value="{StaticResource ShellBodyFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource ShellMuted}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <DockPanel>
                        <ToggleButton x:Name="HeaderSite" DockPanel.Dock="Top" Cursor="Hand" HorizontalAlignment="Left"
                                      FocusVisualStyle="{StaticResource ShellFocusVisual}"
                                      Foreground="{TemplateBinding Foreground}"
                                      Content="{TemplateBinding Header}"
                                      IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <StackPanel Orientation="Horizontal" Background="Transparent">
                                        <Path x:Name="Arrow" Data="M0,0 L4,4 L0,8" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5"
                                              VerticalAlignment="Center" Margin="2,0,8,0"/>
                                        <ContentPresenter VerticalAlignment="Center" TextElement.FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Arrow" Property="Data" Value="M0,0 L4,4 L8,0"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="ExpandSite" DockPanel.Dock="Bottom" Visibility="Collapsed"/>
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Check box -->
    <Style TargetType="CheckBox">
        <Setter Property="FocusVisualStyle" Value="{StaticResource ShellFocusVisual}"/>
        <Setter Property="FontFamily" Value="{StaticResource ShellBodyFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource ShellInk}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="box" Width="18" Height="18" CornerRadius="3"
                                Background="{DynamicResource ShellSurface}" BorderBrush="{DynamicResource ShellLine}" BorderThickness="1"
                                VerticalAlignment="Center">
                            <Path x:Name="tick" Data="M3,9 L7,13 L14,4" Stroke="{DynamicResource ShellAccentInk}" StrokeThickness="2"
                                  Visibility="Collapsed" Margin="0"/>
                        </Border>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="box" Property="Background" Value="{DynamicResource ShellAccent}"/>
                            <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource ShellAccent}"/>
                            <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- List -->
    <Style TargetType="ListBoxItem">
        <Setter Property="FocusVisualStyle" Value="{StaticResource ShellFocusVisual}"/>
        <Setter Property="FontFamily" Value="{StaticResource ShellBodyFont}"/>
        <Setter Property="Foreground" Value="{DynamicResource ShellInk}"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="{StaticResource ShellRadiusControl}"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ShellHover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ShellAccentTint}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    </Style>

    <!-- Scroll bar: thin rounded thumb, no arrows -->
    <Style x:Key="ShellScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="th" Background="{DynamicResource ShellThumb}" CornerRadius="{StaticResource ShellRadiusControl}" Margin="2"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="th" Property="Background" Value="{DynamicResource ShellThumbHover}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ShellScrollPage" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <ControlTemplate x:Key="ShellScrollBarVertical" TargetType="ScrollBar">
        <Grid Background="Transparent">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ShellScrollPage}" Command="ScrollBar.PageUpCommand"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource ShellScrollThumb}"/>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ShellScrollPage}" Command="ScrollBar.PageDownCommand"/>
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
    </ControlTemplate>
    <ControlTemplate x:Key="ShellScrollBarHorizontal" TargetType="ScrollBar">
        <Grid Background="Transparent">
            <Track x:Name="PART_Track" IsDirectionReversed="False">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ShellScrollPage}" Command="ScrollBar.PageLeftCommand"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource ShellScrollThumb}"/>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ShellScrollPage}" Command="ScrollBar.PageRightCommand"/>
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
    </ControlTemplate>
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="12"/>
        <Setter Property="MinWidth" Value="12"/>
        <Setter Property="Template" Value="{StaticResource ShellScrollBarVertical}"/>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Height" Value="12"/>
                <Setter Property="MinHeight" Value="12"/>
                <Setter Property="Template" Value="{StaticResource ShellScrollBarHorizontal}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Progress -->
    <Style TargetType="ProgressBar">
        <Setter Property="Height" Value="6"/>
        <Setter Property="Foreground" Value="{DynamicResource ShellAccent}"/>
        <Setter Property="Background" Value="{DynamicResource ShellHover}"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
</ResourceDictionary>
