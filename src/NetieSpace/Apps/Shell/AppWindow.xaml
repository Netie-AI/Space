<Window x:Class="NetieSpace.Apps.Shell.AppWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NetieSpace.Apps.Shell"
        Width="1100" Height="720" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ShellPaper}">
    <!-- The chrome lives in AppTheme.xaml (merged by AppShell and its views, not here and not in App.xaml); the light or dark colours come from ShellTheme. -->
    <local:AppShell x:Name="Shell"/>
</Window>
