<UserControl x:Class="NetieSpace.Apps.Shell.CommandPaletteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:NetieSpace.Apps.Shell">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="AppTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="PaletteRow" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                <Setter Property="AutomationProperties.Name" Value="{Binding Title}"/>
                <Setter Property="Padding" Value="12,8"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Enabled}" Value="False">
                        <Setter Property="Opacity" Value="0.6"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <!-- A click outside the card closes it. -->
        <Border x:Name="Scrim" Background="#99000000"/>
        <Border Style="{StaticResource ShellCard}" Width="600" MaxHeight="520" Padding="12"
                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,80,0,0">
            <DockPanel>
                <TextBox x:Name="Query" DockPanel.Dock="Top" MinHeight="40" FontSize="15" Padding="12,6"
                         AutomationProperties.Name="Search tools and recent files"
                         ToolTip="Type 2 or 3 letters of a tool or file name. Up and Down choose, Enter opens, Esc closes."/>
                <TextBlock x:Name="Empty" DockPanel.Dock="Top" Margin="12,14,12,6" Visibility="Collapsed"
                           Style="{StaticResource ShellMutedText}" FontSize="13"
                           Text="Nothing matches. Try fewer letters."/>
                <ListBox x:Name="Rows" Margin="0,8,0,0" IsTabStop="False" Focusable="False"
                         AutomationProperties.Name="Search results"
                         ItemContainerStyle="{StaticResource PaletteRow}" MaxHeight="400"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel LastChildFill="True">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding KindText}" Style="{StaticResource ShellCaption}"
                                           VerticalAlignment="Center" Margin="12,0,0,0"/>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource ShellCaption}" TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
