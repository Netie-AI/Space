<UserControl x:Class="NetieSpace.Apps.Shell.ToolPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="AppTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Background="{StaticResource ShellPaper}">
        <StackPanel Margin="32,28,32,32" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock x:Name="TitleText" Style="{StaticResource ShellTitle}"/>
            <TextBlock x:Name="CategoryText" Style="{StaticResource ShellMutedText}" Margin="0,4,0,0"/>

            <Border x:Name="UnavailableBox" Visibility="Collapsed" Margin="0,20,0,0" Padding="14"
                    Background="{StaticResource ShellSidebar}" BorderBrush="{StaticResource ShellLine}"
                    BorderThickness="1" CornerRadius="4">
                <StackPanel>
                    <TextBlock x:Name="ReasonText" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock x:Name="OfferText" Style="{StaticResource ShellMutedText}" Margin="0,6,0,0"
                               Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <StackPanel x:Name="WorkPanel" Margin="0,20,0,0">
                <TextBlock Text="Files" Style="{StaticResource ShellSection}"/>
                <Border x:Name="DropZone" AllowDrop="True" Margin="0,8,0,0" Padding="14" MinHeight="96"
                        Background="{StaticResource ShellSidebar}" BorderBrush="{StaticResource ShellLine}"
                        BorderThickness="1" CornerRadius="6">
                    <StackPanel>
                        <StackPanel x:Name="FileRows"/>
                        <TextBlock x:Name="NoFilesText" Text="No files" Style="{StaticResource ShellMutedText}"/>
                        <Button x:Name="BrowseButton" Content="Browse" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="FilesMessage" Style="{StaticResource ShellMutedText}"
                           Foreground="{StaticResource ShellDanger}" Margin="0,6,0,0" Visibility="Collapsed"/>

                <StackPanel x:Name="OptionsHost" Margin="0,8,0,0"/>

                <TextBlock Text="Save to" Style="{StaticResource ShellSection}" Margin="0,20,0,0"/>
                <DockPanel Margin="0,8,0,0">
                    <Button x:Name="ChangeFolderButton" Content="Change" DockPanel.Dock="Right" MinHeight="28"
                            Padding="10,4" Margin="12,0,0,0"/>
                    <TextBlock x:Name="OutFolderText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </DockPanel>

                <Button x:Name="ActionButton" Style="{StaticResource ShellActionButton}"
                        HorizontalAlignment="Left" Margin="0,24,0,0" MaxWidth="560"/>

                <StackPanel x:Name="RunPanel" Margin="0,18,0,0" Visibility="Collapsed">
                    <ProgressBar x:Name="Bar" Minimum="0" Maximum="100"/>
                    <TextBlock x:Name="ProgressText" Style="{StaticResource ShellMutedText}" Margin="0,6,0,0"/>
                    <StackPanel x:Name="QueueRows" Margin="0,10,0,0"/>
                    <Button x:Name="CancelButton" Content="Cancel" HorizontalAlignment="Left" Margin="0,10,0,0"
                            MinHeight="28" Padding="10,4"/>
                </StackPanel>

                <StackPanel x:Name="ResultPanel" Margin="0,18,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="ResultText" TextWrapping="Wrap"/>
                    <StackPanel x:Name="ResultButtons" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="OpenButton" Content="Open" Margin="0,0,8,0"/>
                        <Button x:Name="ShowButton" Content="Show in folder"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
