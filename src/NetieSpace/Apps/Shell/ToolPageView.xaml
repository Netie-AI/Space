<UserControl x:Class="NetieSpace.Apps.Shell.ToolPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="AppTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Background="{StaticResource ShellPaper}">
        <!-- One star column with a MaxWidth: the page fills up to 680 and stays left aligned.
             A left-aligned StackPanel with MaxWidth shrinks to its content instead. -->
        <Grid Margin="32,20,32,32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="680"/>
            </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
            <Button x:Name="BackButton" Style="{StaticResource ShellNavItem}" HorizontalAlignment="Left"
                    Margin="-10,0,0,10" ToolTip="All tools">
                <StackPanel Orientation="Horizontal">
                    <Path Data="M7 2 L3 6 L7 10" Stroke="{StaticResource ShellInk}" StrokeThickness="1.6"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Width="10" Height="12" VerticalAlignment="Center"/>
                    <TextBlock Text="All tools" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <TextBlock x:Name="TitleText" Style="{StaticResource ShellTitle}"/>
            <TextBlock x:Name="CategoryText" Style="{StaticResource ShellMutedText}" Margin="0,4,0,0"/>

            <Border x:Name="UnavailableBox" Visibility="Collapsed" Margin="0,20,0,0" Padding="14"
                    Background="{StaticResource ShellSidebar}" BorderBrush="{StaticResource ShellLine}"
                    BorderThickness="1" CornerRadius="4">
                <StackPanel>
                    <TextBlock Text="Not available" Style="{StaticResource ShellSection}" Margin="0,0,0,6"/>
                    <TextBlock x:Name="ReasonText" TextWrapping="Wrap"/>
                    <TextBlock x:Name="OfferText" Style="{StaticResource ShellMutedText}" Margin="0,6,0,0"
                               Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <StackPanel x:Name="WorkPanel" Margin="0,20,0,0">
                <TextBlock Text="Files" Style="{StaticResource ShellSection}"/>
                <Grid x:Name="DropZone" AllowDrop="True" Margin="0,8,0,0" MinHeight="132" Background="Transparent">
                    <Rectangle Fill="{StaticResource ShellSidebar}" Stroke="{StaticResource ShellThumb}"
                               StrokeThickness="1.5" StrokeDashArray="4 3" RadiusX="8" RadiusY="8"/>
                    <StackPanel Margin="16" VerticalAlignment="Center">
                        <StackPanel x:Name="FileRows"/>
                        <TextBlock x:Name="NoFilesText" Text="Drop files" Style="{StaticResource ShellMutedText}"
                                   FontSize="13" HorizontalAlignment="Center"/>
                        <Button x:Name="BrowseButton" Content="Browse" HorizontalAlignment="Center"
                                Margin="0,10,0,0" MinWidth="96"/>
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="FilesMessage" Style="{StaticResource ShellMutedText}"
                           Foreground="{StaticResource ShellDanger}" Margin="0,6,0,0" Visibility="Collapsed"/>

                <StackPanel x:Name="OptionsHost" Margin="0,8,0,0"/>

                <TextBlock Text="Save to" Style="{StaticResource ShellSection}" Margin="0,20,0,0"/>
                <DockPanel Margin="0,8,0,0">
                    <Button x:Name="ChangeFolderButton" Content="Change" DockPanel.Dock="Right" MinHeight="32"
                            Padding="12,4" Margin="8,0,0,0"/>
                    <Border Background="{StaticResource ShellSidebar}" BorderBrush="{StaticResource ShellLine}"
                            BorderThickness="1" CornerRadius="4" Padding="10,0" MinHeight="32">
                        <TextBlock x:Name="OutFolderText" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </Border>
                </DockPanel>

                <Button x:Name="ActionButton" Style="{StaticResource ShellActionButton}"
                        HorizontalAlignment="Left" Margin="0,24,0,0" MaxWidth="560"/>

                <StackPanel x:Name="RunPanel" Margin="0,18,0,0" Visibility="Collapsed">
                    <ProgressBar x:Name="Bar" Minimum="0" Maximum="100"/>
                    <TextBlock x:Name="ProgressText" Style="{StaticResource ShellMutedText}" Margin="0,6,0,0"/>
                    <StackPanel x:Name="QueueRows" Margin="0,10,0,0"/>
                    <Button x:Name="CancelButton" Content="Cancel" HorizontalAlignment="Left" Margin="0,10,0,0"
                            MinHeight="28" Padding="10,4"/>
                </StackPanel>

                <StackPanel x:Name="ResultPanel" Margin="0,18,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="ResultText" TextWrapping="Wrap"/>
                    <StackPanel x:Name="ResultButtons" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="OpenButton" Content="Open" Margin="0,0,8,0"/>
                        <Button x:Name="ShowButton" Content="Show in folder"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
