<UserControl x:Class="NetieSpace.Apps.Shell.ToolPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="AppTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Background="{StaticResource ShellPaper}">
        <!-- Two columns: the work (options, files, action) up to 640 wide, and the document preview beside it.
             A star column with a MaxWidth keeps the work left aligned; a StackPanel with MaxWidth would shrink. -->
        <Grid Margin="32,20,32,32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="WorkColumn" Width="*" MaxWidth="640"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2">
                <Button x:Name="BackButton" Style="{StaticResource ShellNavItem}" HorizontalAlignment="Left"
                        Margin="-10,0,0,10">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M7 2 L3 6 L7 10" Stroke="{StaticResource ShellInk}" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Width="10" Height="12" VerticalAlignment="Center"/>
                        <TextBlock Text="All tools" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <StackPanel Orientation="Horizontal">
                    <Border x:Name="TitleBadge" Width="48" Height="48" CornerRadius="{StaticResource ShellRadiusCard}"
                            Background="{DynamicResource ShellAccentTint}" VerticalAlignment="Center">
                        <Grid>
                            <TextBlock x:Name="TitleGlyph" Style="{StaticResource ShellIcon}" FontSize="24"/>
                            <Path x:Name="TitlePath" Stroke="{DynamicResource ShellAccentStrong}" StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Stretch="Uniform" Width="24" Height="24" Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" Style="{StaticResource ShellTitle}"/>
                        <TextBlock x:Name="CategoryText" Style="{StaticResource ShellMutedText}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="0">
                <Border x:Name="UnavailableBox" Visibility="Collapsed" Margin="0,24,0,0"
                        Style="{StaticResource ShellCard}" Background="{StaticResource ShellSidebar}">
                    <StackPanel>
                        <TextBlock Text="Not available" Style="{StaticResource ShellSection}" Margin="0,0,0,8"/>
                        <TextBlock x:Name="ReasonText" TextWrapping="Wrap"/>
                        <TextBlock x:Name="OfferText" Style="{StaticResource ShellMutedText}" Margin="0,8,0,0"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <StackPanel x:Name="WorkPanel" Margin="0,24,0,0">
                    <!-- The result sits first so it is on screen without scrolling. -->
                    <StackPanel x:Name="ResultPanel" Margin="0,0,0,24" Visibility="Collapsed">
                        <Border x:Name="ResultCard" Style="{StaticResource ShellCard}" Padding="14"
                                BorderBrush="{DynamicResource ShellAccent}" BorderThickness="1.5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="ResultThumbBox" Grid.Column="0" Width="84" Height="108" VerticalAlignment="Top"
                                        Background="{StaticResource ShellSidebar}" BorderBrush="{StaticResource ShellLine}"
                                        BorderThickness="1" CornerRadius="{StaticResource ShellRadiusControl}" ClipToBounds="True">
                                    <Grid>
                                        <Image x:Name="ResultThumb" Stretch="Uniform" Margin="4"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <TextBlock x:Name="ResultThumbBadge" Style="{StaticResource ShellCaption}" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Top">
                                    <StackPanel Orientation="Horizontal">
                                        <Border x:Name="ResultMark" Width="22" Height="22" CornerRadius="11"
                                                Background="{DynamicResource ShellAccent}" VerticalAlignment="Center">
                                            <TextBlock x:Name="ResultMarkGlyph" Style="{StaticResource ShellIcon}" FontSize="12"
                                                       Foreground="{DynamicResource ShellAccentInk}"/>
                                        </Border>
                                        <TextBlock x:Name="ResultTitle" Style="{StaticResource ShellSection}" Margin="10,0,0,0"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <TextBlock x:Name="ResultDetail" Style="{StaticResource ShellMutedText}" Margin="32,4,0,0"/>
                                    <TextBlock x:Name="ResultText" Style="{StaticResource ShellCaption}" TextWrapping="Wrap" Margin="32,6,0,0"/>
                                    <StackPanel x:Name="ResultButtons" Orientation="Horizontal" Margin="32,14,0,0">
                                        <Button x:Name="OpenButton" Content="Open" Style="{StaticResource ShellActionButton}"
                                                MinHeight="32" Padding="16,6" Margin="0,0,8,0"/>
                                        <Button x:Name="ShowButton" Content="Show in folder"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <TextBlock x:Name="FilesLabel" Text="Files" Style="{StaticResource ShellSection}"/>
                    <ContentPresenter x:Name="PanelHost" Margin="0,8,0,0"/>
                    <Grid x:Name="DropZone" AllowDrop="True" Margin="0,8,0,0" MinHeight="132" Background="Transparent">
                        <Rectangle Fill="{StaticResource ShellSidebar}" Stroke="{StaticResource ShellThumb}"
                                   StrokeThickness="1.5" StrokeDashArray="4 3" RadiusX="10" RadiusY="10"/>
                        <StackPanel Margin="16" VerticalAlignment="Center">
                            <StackPanel x:Name="FileRows"/>
                            <TextBlock x:Name="NoFilesText" Text="Drop files" Style="{StaticResource ShellMutedText}"
                                       FontSize="13" HorizontalAlignment="Center"/>
                            <Button x:Name="BrowseButton" Content="Browse" HorizontalAlignment="Center"
                                    Margin="0,12,0,0" MinWidth="96"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="FilesMessage" Style="{StaticResource ShellMutedText}"
                               Foreground="{StaticResource ShellDanger}" Margin="0,8,0,0" Visibility="Collapsed"/>

                    <StackPanel x:Name="OptionsCard" Margin="0,24,0,0">
                        <TextBlock Text="Options" Style="{StaticResource ShellSection}"/>
                        <StackPanel x:Name="OptionsHost" Margin="0,0,0,0"/>
                    </StackPanel>

                    <TextBlock Text="Save to" Style="{StaticResource ShellSection}" Margin="0,24,0,0"/>
                    <DockPanel Margin="0,8,0,0">
                        <Button x:Name="ChangeFolderButton" Content="Change" DockPanel.Dock="Right" MinHeight="32"
                                Padding="12,4" Margin="8,0,0,0"/>
                        <Border Background="{StaticResource ShellSidebar}" BorderBrush="{StaticResource ShellLine}"
                                BorderThickness="1" CornerRadius="{StaticResource ShellRadiusControl}" Padding="10,0" MinHeight="32">
                            <TextBlock x:Name="OutFolderText" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                        </Border>
                    </DockPanel>

                    <Button x:Name="ActionButton" Style="{StaticResource ShellActionButton}"
                            HorizontalAlignment="Left" Margin="0,24,0,0" MaxWidth="560"/>

                    <StackPanel x:Name="RunPanel" Margin="0,18,0,0" Visibility="Collapsed">
                        <ProgressBar x:Name="Bar" Minimum="0" Maximum="100"/>
                        <TextBlock x:Name="ProgressText" Style="{StaticResource ShellMutedText}" Margin="0,6,0,0"/>
                        <StackPanel x:Name="QueueRows" Margin="0,10,0,0"/>
                        <Button x:Name="CancelButton" Content="Cancel" HorizontalAlignment="Left" Margin="0,10,0,0"
                                MinHeight="28" Padding="10,4"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- Beside the work: pages of the first file, or its picture. -->
            <Border x:Name="PreviewPanel" Grid.Row="1" Grid.Column="1" Style="{StaticResource ShellCard}" Padding="14"
                    Width="288" Margin="32,24,0,0" VerticalAlignment="Top" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="PreviewTitle" Style="{StaticResource ShellSection}" FontSize="13"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="PreviewCaption" Style="{StaticResource ShellCaption}" Margin="0,2,0,0"/>
                    <ScrollViewer x:Name="PreviewStripScroll" Margin="0,12,0,0" MaxHeight="480"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <WrapPanel x:Name="PreviewStrip"/>
                    </ScrollViewer>
                    <Border x:Name="PreviewPictureBox" Margin="0,12,0,0" Background="{StaticResource ShellSidebar}"
                            CornerRadius="{StaticResource ShellRadiusControl}" Visibility="Collapsed">
                        <Image x:Name="PreviewPicture" MaxHeight="320" Stretch="Uniform" Margin="6"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <Border x:Name="PreviewPlaceholder" Margin="0,12,0,0" Height="140" Visibility="Collapsed"
                            Background="{DynamicResource ShellAccentTint}" CornerRadius="{StaticResource ShellRadiusControl}">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="PreviewBadge" Style="{StaticResource ShellSection}" FontSize="20"
                                       Foreground="{DynamicResource ShellAccentStrong}" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="PreviewNote" Style="{StaticResource ShellCaption}" Margin="12,6,12,0"
                                       HorizontalAlignment="Center" TextAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="PreviewMore" Style="{StaticResource ShellCaption}" Margin="0,10,0,0"
                               Visibility="Collapsed"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
