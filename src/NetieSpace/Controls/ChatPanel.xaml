<UserControl x:Class="NetieSpace.Controls.ChatPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border BorderBrush="{StaticResource GlassHighlight}" BorderThickness="1,0,0,0"
            Background="#14000000">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="20,18" BorderBrush="{StaticResource GlassHighlight}" BorderThickness="0,0,0,1">
                <StackPanel>
                    <TextBlock Text="AI Chat"
                               FontFamily="{StaticResource DisplayFont}"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="PDF: Ctrl+C → Look Up · other: right-click"
                               FontFamily="{StaticResource BodyFont}"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="11.5" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <ScrollViewer x:Name="MessagesScroll" Grid.Row="1"
                          VerticalScrollBarVisibility="Auto" Padding="18,14">
                <StackPanel x:Name="MessagesPanel"/>
            </ScrollViewer>

            <Border Grid.Row="2" Margin="16,0,16,8" Padding="12" CornerRadius="14"
                    Background="#1AFFFFFF" BorderBrush="#38FFFFFF" BorderThickness="1"
                    Visibility="Collapsed" x:Name="SelectionBanner">
                <DockPanel LastChildFill="True">
                    <Button Content="Ask" DockPanel.Dock="Right" Margin="10,0,0,0"
                            Style="{StaticResource AccentButton}" Click="AskSelection_Click"/>
                    <TextBlock x:Name="SelectionText" TextWrapping="Wrap"
                               FontFamily="{StaticResource BodyFont}"
                               Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                </DockPanel>
            </Border>

            <Border Grid.Row="3" Padding="16,12,16,16" BorderBrush="{StaticResource GlassHighlight}" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="InputBox" MinHeight="44" Padding="14,12"
                             Background="#1AFFFFFF" Foreground="{StaticResource TextBrush}"
                             BorderBrush="#38FFFFFF" BorderThickness="1"
                             FontFamily="{StaticResource BodyFont}" FontSize="13.5"
                             TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" KeyDown="InputBox_KeyDown"/>
                    <Button x:Name="SendButton" Grid.Column="1" Content="Send"
                            Margin="10,0,0,0" Style="{StaticResource AccentButton}"
                            Click="SendButton_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
