<Window x:Class="NetieSpace.Views.ApiSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Setup — NETIE SPACE"
        Width="560" Height="720"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ResizeMode="NoResize"
        Loaded="Window_Loaded">

    <Border x:Name="RootBorder" Margin="16" Background="Transparent">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.5" Color="#000000"/>
        </Border.Effect>

        <Border CornerRadius="22" BorderThickness="1"
                BorderBrush="{StaticResource GlassBorder}" ClipToBounds="True">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1" Opacity="0.62">
                    <GradientStop Color="#B0141820" Offset="0"/>
                    <GradientStop Color="#98101218" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <Grid>
                <Border CornerRadius="22" IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,0.35">
                            <GradientStop Color="#20FFFFFF" Offset="0"/>
                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="52"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" BorderBrush="{StaticResource GlassHighlight}" BorderThickness="0,0,0,1"
                            MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                        <Grid Margin="20,0">
                            <TextBlock Text="Setup" FontFamily="{StaticResource DisplayFont}"
                                       Foreground="{StaticResource TextBrush}" FontSize="16" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                            <Button Content="✕" Style="{StaticResource IconCloseButton}"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Click="CloseButton_Click"/>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="24,18,24,24">

                            <!-- 1. Netie subscription first -->
                            <Border Background="#285EC4B8" CornerRadius="14" Padding="16" Margin="0,0,0,16"
                                    BorderBrush="#605EC4B8" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="1 · Netie Space plan (recommended)"
                                               FontFamily="{StaticResource DisplayFont}"
                                               Foreground="#E8FFF8" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Text="Unlock the full app first — device license, updates, and the path to Ult hosted AI. Start here before pasting random keys."
                                               Foreground="#D0E8E4" FontSize="12.5" TextWrapping="Wrap" Margin="0,8,0,12"/>
                                    <WrapPanel>
                                        <Button x:Name="BuyNetieButton" Content="Get Netie subscription"
                                                Style="{StaticResource AccentButton}" HorizontalAlignment="Left"
                                                Click="BuyNetieButton_Click"/>
                                        <Button x:Name="ManageBillingButton" Content="Manage billing"
                                                Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                                Click="ManageBillingButton_Click"
                                                ToolTip="Stripe Customer Portal after you have paid once"/>
                                    </WrapPanel>
                                    <TextBlock x:Name="LicenseStatusText" Foreground="#A8D8D0" FontSize="11.5"
                                               Margin="0,10,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- 2. BYO / FreeRoute — masked, no inline edit -->
                            <TextBlock Text="2 · Bring your own key (FreeRoute / BYO)"
                                       FontFamily="{StaticResource DisplayFont}"
                                       Foreground="{StaticResource TextBrush}" FontSize="13.5" FontWeight="SemiBold"
                                       Margin="0,0,0,6"/>
                            <TextBlock Text="Keys are masked after save (first/last chars only). You cannot edit an existing key — delete it, then add a new one. Prefer Connect OpenVault as the source of truth."
                                       Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap"
                                       Margin="0,0,0,12"/>

                            <!-- Gemini -->
                            <TextBlock Text="Google AI Studio (Gemini)" Foreground="{StaticResource TextBrush}" FontSize="12" Margin="0,0,0,6"/>
                            <DockPanel Margin="0,0,0,6">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                                    <Button x:Name="GeminiDeleteBtn" Content="Delete" Style="{StaticResource GhostButton}"
                                            Padding="10,6" Margin="0,0,6,0" Click="GeminiDelete_Click"/>
                                    <Button x:Name="GeminiAddBtn" Content="Add new" Style="{StaticResource GhostButton}"
                                            Padding="10,6" Click="GeminiAdd_Click"/>
                                </StackPanel>
                                <TextBlock x:Name="GeminiMaskText" VerticalAlignment="Center"
                                           Foreground="{StaticResource MutedBrush}" FontSize="13"
                                           FontFamily="Consolas, Cascadia Mono, Courier New"/>
                            </DockPanel>
                            <DockPanel x:Name="GeminiAddRow" Visibility="Collapsed" Margin="0,0,0,12">
                                <Button DockPanel.Dock="Right" Content="Save" Style="{StaticResource AccentButton}"
                                        Padding="12,6" Margin="8,0,0,0" Click="GeminiSaveNew_Click"/>
                                <PasswordBox x:Name="GeminiNewBox" Height="36" Padding="10,8"
                                             Background="#1AFFFFFF" Foreground="{StaticResource TextBrush}"
                                             BorderBrush="#38FFFFFF" BorderThickness="1"
                                             CaretBrush="{StaticResource AccentBrush}"/>
                            </DockPanel>
                            <Border Height="1" Background="#22FFFFFF" Margin="0,0,0,12" x:Name="GeminiSpacer"/>

                            <!-- Groq -->
                            <TextBlock Text="Groq API key" Foreground="{StaticResource TextBrush}" FontSize="12" Margin="0,0,0,6"/>
                            <DockPanel Margin="0,0,0,6">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                                    <Button x:Name="GroqDeleteBtn" Content="Delete" Style="{StaticResource GhostButton}"
                                            Padding="10,6" Margin="0,0,6,0" Click="GroqDelete_Click"/>
                                    <Button x:Name="GroqAddBtn" Content="Add new" Style="{StaticResource GhostButton}"
                                            Padding="10,6" Click="GroqAdd_Click"/>
                                </StackPanel>
                                <TextBlock x:Name="GroqMaskText" VerticalAlignment="Center"
                                           Foreground="{StaticResource MutedBrush}" FontSize="13"
                                           FontFamily="Consolas, Cascadia Mono, Courier New"/>
                            </DockPanel>
                            <DockPanel x:Name="GroqAddRow" Visibility="Collapsed" Margin="0,0,0,12">
                                <Button DockPanel.Dock="Right" Content="Save" Style="{StaticResource AccentButton}"
                                        Padding="12,6" Margin="8,0,0,0" Click="GroqSaveNew_Click"/>
                                <PasswordBox x:Name="GroqNewBox" Height="36" Padding="10,8"
                                             Background="#1AFFFFFF" Foreground="{StaticResource TextBrush}"
                                             BorderBrush="#38FFFFFF" BorderThickness="1"
                                             CaretBrush="{StaticResource AccentBrush}"/>
                            </DockPanel>
                            <Border Height="1" Background="#22FFFFFF" Margin="0,0,0,12"/>

                            <!-- SEA-LION -->
                            <TextBlock Text="SEA-LION API key" Foreground="{StaticResource TextBrush}" FontSize="12" Margin="0,0,0,6"/>
                            <DockPanel Margin="0,0,0,6">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                                    <Button x:Name="SeaLionDeleteBtn" Content="Delete" Style="{StaticResource GhostButton}"
                                            Padding="10,6" Margin="0,0,6,0" Click="SeaLionDelete_Click"/>
                                    <Button x:Name="SeaLionAddBtn" Content="Add new" Style="{StaticResource GhostButton}"
                                            Padding="10,6" Click="SeaLionAdd_Click"/>
                                </StackPanel>
                                <TextBlock x:Name="SeaLionMaskText" VerticalAlignment="Center"
                                           Foreground="{StaticResource MutedBrush}" FontSize="13"
                                           FontFamily="Consolas, Cascadia Mono, Courier New"/>
                            </DockPanel>
                            <DockPanel x:Name="SeaLionAddRow" Visibility="Collapsed" Margin="0,0,0,12">
                                <Button DockPanel.Dock="Right" Content="Save" Style="{StaticResource AccentButton}"
                                        Padding="12,6" Margin="8,0,0,0" Click="SeaLionSaveNew_Click"/>
                                <PasswordBox x:Name="SeaLionNewBox" Height="36" Padding="10,8"
                                             Background="#1AFFFFFF" Foreground="{StaticResource TextBrush}"
                                             BorderBrush="#38FFFFFF" BorderThickness="1"
                                             CaretBrush="{StaticResource AccentBrush}"/>
                            </DockPanel>
                            <Border Height="1" Background="#22FFFFFF" Margin="0,0,0,12"/>

                            <!-- OpenRouter -->
                            <TextBlock Text="OpenRouter API key" Foreground="{StaticResource TextBrush}" FontSize="12" Margin="0,0,0,6"/>
                            <DockPanel Margin="0,0,0,6">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                                    <Button x:Name="OpenRouterDeleteBtn" Content="Delete" Style="{StaticResource GhostButton}"
                                            Padding="10,6" Margin="0,0,6,0" Click="OpenRouterDelete_Click"/>
                                    <Button x:Name="OpenRouterAddBtn" Content="Add new" Style="{StaticResource GhostButton}"
                                            Padding="10,6" Click="OpenRouterAdd_Click"/>
                                </StackPanel>
                                <TextBlock x:Name="OpenRouterMaskText" VerticalAlignment="Center"
                                           Foreground="{StaticResource MutedBrush}" FontSize="13"
                                           FontFamily="Consolas, Cascadia Mono, Courier New"/>
                            </DockPanel>
                            <DockPanel x:Name="OpenRouterAddRow" Visibility="Collapsed" Margin="0,0,0,14">
                                <Button DockPanel.Dock="Right" Content="Save" Style="{StaticResource AccentButton}"
                                        Padding="12,6" Margin="8,0,0,0" Click="OpenRouterSaveNew_Click"/>
                                <PasswordBox x:Name="OpenRouterNewBox" Height="36" Padding="10,8"
                                             Background="#1AFFFFFF" Foreground="{StaticResource TextBrush}"
                                             BorderBrush="#38FFFFFF" BorderThickness="1"
                                             CaretBrush="{StaticResource AccentBrush}"/>
                            </DockPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <Button Content="Open Gemini site" Style="{StaticResource GhostButton}"
                                        Click="OpenGeminiSite_Click"/>
                            </StackPanel>

                            <!-- 3. OpenVault -->
                            <Border Background="#18000000" CornerRadius="12" Padding="14" Margin="0,0,0,14"
                                    BorderBrush="#30FFFFFF" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="3 · Connect OpenVault"
                                               FontFamily="{StaticResource DisplayFont}"
                                               Foreground="{StaticResource TextBrush}" FontSize="13.5" FontWeight="SemiBold"/>
                                    <TextBlock Text="OpenVault (D:\OpenVault · http://127.0.0.1:5000) is the source of truth for API keys, passwords, and high-security secrets. Netie keeps only a masked offline cache."
                                               Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap"
                                               Margin="0,6,0,10"/>
                                    <TextBlock x:Name="VaultStatusText" Foreground="#A8D8D0" FontSize="11.5"
                                               Margin="0,0,0,10" TextWrapping="Wrap"
                                               Text="Checking OpenVault…"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Connect / sync keys" Style="{StaticResource AccentButton}"
                                                Margin="0,0,10,0" Click="ConnectOpenVault_Click"/>
                                        <Button Content="Local password vault" Style="{StaticResource GhostButton}"
                                                Click="OpenLocalVault_Click"
                                                ToolTip="Offline DPAPI fallback — not a second SoT"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock x:Name="StatusText" Foreground="{StaticResource Accent2Brush}"
                                       FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>
    </Border>
</Window>
