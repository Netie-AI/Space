<Window x:Class="NetieSpace.Views.ApiSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="API Keys — NETIE SPACE"
        Width="520" Height="580"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ResizeMode="NoResize"
        Loaded="Window_Loaded">

    <Border x:Name="RootBorder" Margin="16" Background="Transparent">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.5" Color="#000000"/>
        </Border.Effect>

        <Border CornerRadius="22" BorderThickness="1"
                BorderBrush="{StaticResource GlassBorder}" ClipToBounds="True">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1" Opacity="0.62">
                    <GradientStop Color="#B0141820" Offset="0"/>
                    <GradientStop Color="#98101218" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <Grid>
                <Border CornerRadius="22" IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,0.35">
                            <GradientStop Color="#20FFFFFF" Offset="0"/>
                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="52"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" BorderBrush="{StaticResource GlassHighlight}" BorderThickness="0,0,0,1"
                            MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                        <Grid Margin="20,0">
                            <TextBlock Text="API Keys" FontFamily="{StaticResource DisplayFont}"
                                       Foreground="{StaticResource TextBrush}" FontSize="16" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                            <Button Content="✕" Style="{StaticResource IconCloseButton}"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Click="CloseButton_Click"/>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="24,18,24,24">
                            <TextBlock Text="Free first: Google AI Studio (Gemini), then Groq / SEA-LION / OpenRouter. Preview and convert work without a key."
                                       Foreground="{StaticResource MutedBrush}" FontSize="12.5" TextWrapping="Wrap"
                                       Margin="0,0,0,16"/>

                            <TextBlock Text="Google AI Studio (free)" Foreground="{StaticResource TextBrush}" FontSize="12" Margin="0,0,0,6"/>
                            <TextBox x:Name="GeminiKeyBox" Height="36" Padding="10,8" Margin="0,0,0,14"
                                     Background="#1AFFFFFF" Foreground="{StaticResource TextBrush}"
                                     BorderBrush="#38FFFFFF" BorderThickness="1" CaretBrush="{StaticResource AccentBrush}"/>

                            <TextBlock Text="Groq API key" Foreground="{StaticResource TextBrush}" FontSize="12" Margin="0,0,0,6"/>
                            <TextBox x:Name="GroqKeyBox" Height="36" Padding="10,8" Margin="0,0,0,14"
                                     Background="#1AFFFFFF" Foreground="{StaticResource TextBrush}"
                                     BorderBrush="#38FFFFFF" BorderThickness="1" CaretBrush="{StaticResource AccentBrush}"/>

                            <TextBlock Text="SEA-LION API key" Foreground="{StaticResource TextBrush}" FontSize="12" Margin="0,0,0,6"/>
                            <TextBox x:Name="SeaLionKeyBox" Height="36" Padding="10,8" Margin="0,0,0,14"
                                     Background="#1AFFFFFF" Foreground="{StaticResource TextBrush}"
                                     BorderBrush="#38FFFFFF" BorderThickness="1" CaretBrush="{StaticResource AccentBrush}"/>

                            <TextBlock Text="OpenRouter API key" Foreground="{StaticResource TextBrush}" FontSize="12" Margin="0,0,0,6"/>
                            <TextBox x:Name="OpenRouterKeyBox" Height="36" Padding="10,8" Margin="0,0,0,18"
                                     Background="#1AFFFFFF" Foreground="{StaticResource TextBrush}"
                                     BorderBrush="#38FFFFFF" BorderThickness="1" CaretBrush="{StaticResource AccentBrush}"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <Button Content="Save keys" Style="{StaticResource AccentButton}"
                                        Margin="0,0,10,0" Click="SaveButton_Click"/>
                                <Button x:Name="BuyApiButton" Content="Buy API"
                                        Style="{StaticResource GhostButton}"
                                        Click="BuyApiButton_Click"/>
                                <TextBlock Text="Currently unavailable" Foreground="{StaticResource MutedBrush}"
                                           FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </StackPanel>

                            <TextBlock x:Name="StatusText" Foreground="{StaticResource Accent2Brush}"
                                       FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>
    </Border>
</Window>
