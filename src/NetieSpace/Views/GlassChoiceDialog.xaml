<Window x:Class="NetieSpace.Views.GlassChoiceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose" Width="460" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True">
    <Border x:Name="Root" CornerRadius="16" BorderBrush="{StaticResource GlassBorder}" BorderThickness="1"
            Padding="20,16" ClipToBounds="True">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1" Opacity="0.92">
                <GradientStop Color="#E8181C28" Offset="0"/>
                <GradientStop Color="#D0101420" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <StackPanel>
            <TextBlock x:Name="TitleText" FontFamily="{StaticResource DisplayFont}"
                       FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                       TextWrapping="Wrap" Margin="0,0,0,6"/>
            <TextBlock x:Name="BodyText" FontFamily="{StaticResource BodyFont}"
                       FontSize="12.5" Foreground="{StaticResource MutedBrush}"
                       TextWrapping="Wrap" Margin="0,0,0,16"/>
            <StackPanel x:Name="ExtraPanel" Margin="0,0,0,12" Visibility="Collapsed"/>
            <WrapPanel x:Name="ButtonPanel" Orientation="Horizontal" HorizontalAlignment="Right"/>
        </StackPanel>
    </Border>
</Window>
