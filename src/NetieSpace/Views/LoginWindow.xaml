<Window x:Class="NetieSpace.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SIGN IN — NETIE SPACE"
        Width="440" Height="640"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ResizeMode="NoResize"
        Loaded="Window_Loaded">

    <Border x:Name="RootBorder" Margin="14" Background="Transparent">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.55" Color="#000000"/>
        </Border.Effect>

        <Border CornerRadius="24" BorderThickness="1"
                BorderBrush="{StaticResource GlassBorder}" ClipToBounds="True">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1" Opacity="0.72">
                    <GradientStop Color="#C0141820" Offset="0"/>
                    <GradientStop Color="#A8101218" Offset="0.55"/>
                    <GradientStop Color="#98101828" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <Grid>
                <Border CornerRadius="24" IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,0.4">
                            <GradientStop Color="#28FFFFFF" Offset="0"/>
                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <Grid Margin="28,22,28,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                        <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource IconCloseButton}"
                                Click="CloseButton_Click"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="28" Height="28" CornerRadius="8" Margin="0,0,12,0"
                                    Background="#10141C" ClipToBounds="True">
                                <Image Source="pack://application:,,,/Assets/netie-icon.png"
                                       Stretch="UniformToFill"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                            <TextBlock Text="NETIE SPACE" FontFamily="{StaticResource DisplayFont}"
                                       Foreground="{StaticResource TextBrush}" FontSize="18" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </DockPanel>

                    <TextBlock Grid.Row="1" Margin="0,18,0,0" TextWrapping="Wrap"
                               Text="Sign in with email. One laptop per license. Offline edit works after activate — AI still needs network."
                               Foreground="{StaticResource MutedBrush}" FontSize="12.5" LineHeight="18"/>

                    <StackPanel Grid.Row="2" Margin="0,22,0,0">
                        <TextBlock Text="Email" Foreground="#A0A8B8" FontSize="12" Margin="0,0,0,6"/>
                        <TextBox x:Name="EmailBox" Height="40" Padding="12,10" Margin="0,0,0,14"
                                 Background="#28FFFFFF" Foreground="#F2F4F8"
                                 BorderBrush="#50FFFFFF" BorderThickness="1"
                                 CaretBrush="#5EC4B8" FontSize="14"/>

                        <TextBlock Text="Password" Foreground="#A0A8B8" FontSize="12" Margin="0,0,0,6"/>
                        <PasswordBox x:Name="PasswordBox" Height="40" Padding="12,10" Margin="0,0,0,8"
                                     Background="#28FFFFFF" Foreground="#F2F4F8"
                                     BorderBrush="#50FFFFFF" BorderThickness="1"
                                     CaretBrush="#5EC4B8" FontSize="14"/>

                        <TextBlock x:Name="StatusText" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Foreground="{StaticResource Accent2Brush}" FontSize="12"/>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Margin="0,12,0,0">
                        <Button x:Name="SignInButton" Content="Sign in &amp; activate this PC"
                                Style="{StaticResource EditorChipPrimary}"
                                Height="42" Margin="0,0,0,10" HorizontalAlignment="Stretch"
                                Click="SignInButton_Click"/>
                        <Button x:Name="RegisterButton" Content="Create account"
                                Style="{StaticResource EditorChip}"
                                Height="40" Margin="0,0,0,10" HorizontalAlignment="Stretch"
                                Click="RegisterButton_Click"/>
                        <Button x:Name="BuyButton" Content="Get Netie subscription"
                                Style="{StaticResource EditorChipPrimary}"
                                Height="40" Margin="0,0,0,10" HorizontalAlignment="Stretch"
                                Visibility="Collapsed"
                                Click="BuyButton_Click"/>
                        <Button x:Name="ActivateAfterPayButton" Content="Activate this laptop"
                                Style="{StaticResource EditorChip}"
                                Height="40" Margin="0,0,0,10" HorizontalAlignment="Stretch"
                                Visibility="Collapsed"
                                Click="ActivateAfterPayButton_Click"/>
                        <Button Content="Continue offline (if already activated)"
                                Style="{StaticResource GhostButton}"
                                HorizontalAlignment="Stretch"
                                Click="OfflineButton_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Border>
</Window>
