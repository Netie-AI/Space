<Window x:Class="NetieSpace.Views.PasswordVaultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Password Vault — NETIE SPACE"
        Width="640" Height="520"
        MinWidth="480" MinHeight="400"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ResizeMode="CanResizeWithGrip"
        Loaded="Window_Loaded">

    <Border x:Name="RootBorder" Margin="16" Background="Transparent">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.5" Color="#000000"/>
        </Border.Effect>
        <Border CornerRadius="22" BorderThickness="1"
                BorderBrush="{StaticResource GlassBorder}" ClipToBounds="True">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1" Opacity="0.62">
                    <GradientStop Color="#B0141820" Offset="0"/>
                    <GradientStop Color="#98101218" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="52"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" BorderBrush="{StaticResource GlassHighlight}" BorderThickness="0,0,0,1"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid Margin="20,0">
                        <TextBlock Text="Password Vault" FontFamily="{StaticResource DisplayFont}"
                                   Foreground="{StaticResource TextBrush}" FontSize="16" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <Button Content="✕" Style="{StaticResource IconCloseButton}"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Click="CloseButton_Click"/>
                    </Grid>
                </Border>

                <TextBlock Grid.Row="1" Margin="24,12,24,8"
                           Text="Local DPAPI vault on this Windows user — like iCloud Passwords, Space-side. Sync across devices lands with Space bridge."
                           Foreground="{StaticResource MutedBrush}" FontSize="12.5" TextWrapping="Wrap"/>

                <Border Grid.Row="2" Margin="20,0,20,8" CornerRadius="14" Background="#14FFFFFF"
                        BorderBrush="#28FFFFFF" BorderThickness="1" ClipToBounds="True">
                    <ListBox x:Name="EntryList" Background="Transparent" BorderThickness="0" Padding="6"
                             SelectionChanged="EntryList_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,2"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="bd" CornerRadius="10" Padding="12,10"
                                                    Background="#12FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#335EC4B8"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextBrush}"
                                               FontSize="13.5" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Username}" Foreground="{StaticResource MutedBrush}"
                                               FontSize="12" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <Grid Grid.Row="3" Margin="20,4,20,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBox x:Name="TitleBox" Grid.ColumnSpan="2" Margin="0,0,0,6" Padding="10,8"
                             Style="{StaticResource GlassTextBox}" Tag="Title"/>
                    <TextBox x:Name="UserBox" Grid.Row="1" Margin="0,0,6,6" Padding="10,8"
                             Style="{StaticResource GlassTextBox}" Tag="Username"/>
                    <TextBox x:Name="PassBox" Grid.Row="1" Grid.Column="1" Margin="6,0,0,6" Padding="10,8"
                             Style="{StaticResource GlassTextBox}" Tag="Password"/>
                    <TextBox x:Name="UrlBox" Grid.Row="2" Grid.ColumnSpan="2" Margin="0,0,0,6" Padding="10,8"
                             Style="{StaticResource GlassTextBox}" Tag="URL"/>
                    <TextBox x:Name="NotesBox" Grid.Row="3" Grid.ColumnSpan="2" Padding="10,8" Height="56"
                             Style="{StaticResource GlassTextBox}" Tag="Notes" AcceptsReturn="True" TextWrapping="Wrap"/>
                </Grid>

                <WrapPanel Grid.Row="4" Margin="16,0,16,16">
                    <Button Content="New" Style="{StaticResource EditorChip}" Click="New_Click" Margin="0,0,8,6"/>
                    <Button Content="Save" Style="{StaticResource EditorChipPrimary}" Click="Save_Click" Margin="0,0,8,6"/>
                    <Button Content="Delete" Style="{StaticResource EditorChip}" Click="Delete_Click" Margin="0,0,8,6"/>
                    <Button Content="Copy password" Style="{StaticResource EditorChip}" Click="CopyPass_Click" Margin="0,0,8,6"/>
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="8,0,0,6"
                               Foreground="{StaticResource Accent2Brush}" FontSize="12"/>
                </WrapPanel>
            </Grid>
        </Border>
    </Border>
</Window>
