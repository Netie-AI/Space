<Window x:Class="NetieSpace.Views.PdfOrganizeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Organize pages — NETIE SPACE"
        Width="820" Height="680"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        Topmost="True"
        ResizeMode="CanResizeWithGrip"
        MinWidth="560" MinHeight="480"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        Loaded="Window_Loaded">

    <!-- Liquid glass + rounded · Margin=0 (no big acrylic halo) · ~12% transparent -->
    <Border x:Name="RootBorder" Margin="0" Background="Transparent">
        <Border CornerRadius="18" BorderThickness="1"
                BorderBrush="{StaticResource GlassBorder}" ClipToBounds="True">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1" Opacity="0.90">
                    <GradientStop Color="#E6181C28" Offset="0"/>
                    <GradientStop Color="#D0101420" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Border CornerRadius="18" IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,0.4">
                            <GradientStop Color="#28FFFFFF" Offset="0"/>
                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="48"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" BorderBrush="{StaticResource GlassHighlight}" BorderThickness="0,0,0,1"
                            MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                        <Grid Margin="18,0">
                            <TextBlock Text="Organize pages" FontFamily="{StaticResource DisplayFont}"
                                       Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                            <Button Content="✕" Style="{StaticResource IconCloseButton}"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Click="CloseButton_Click"/>
                        </Grid>
                    </Border>

                    <TextBlock Grid.Row="1" Margin="18,10,18,6"
                               Text="4 pages per row · teal slot shows insert · long-press to peek. Apply writes a new PDF."
                               Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap"/>

                    <Border Grid.Row="2" Margin="14,0,14,6" CornerRadius="14" Background="#18FFFFFF"
                            BorderBrush="#33FFFFFF" BorderThickness="1" ClipToBounds="True">
                        <Grid>
                        <ListBox x:Name="PageList"
                                 Background="Transparent" BorderThickness="0"
                                 Padding="10"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 AllowDrop="True"
                                 PreviewMouseLeftButtonDown="PageList_PreviewMouseLeftButtonDown"
                                 PreviewMouseMove="PageList_PreviewMouseMove"
                                 PreviewMouseLeftButtonUp="PageList_PreviewMouseLeftButtonUp"
                                 GiveFeedback="PageList_GiveFeedback"
                                 Drop="PageList_Drop"
                                 DragOver="PageList_DragOver"
                                 DragLeave="PageList_DragLeave"
                                 SelectionMode="Single">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel ItemWidth="168" ItemHeight="210"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="4"/>
                                    <Setter Property="Width" Value="160"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="bd" CornerRadius="12" Padding="8"
                                                        Background="#18FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#445EC4B8"/>
                                                        <Setter TargetName="bd" Property="BorderBrush" Value="#AA5EC4B8"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#28FFFFFF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Width="144">
                                        <Border Width="128" Height="160" CornerRadius="8" Background="#0E1218"
                                                BorderBrush="#48FFFFFF" BorderThickness="1"
                                                HorizontalAlignment="Center">
                                            <Grid>
                                                <Image Source="{Binding Thumb}" Stretch="Uniform" Margin="3"/>
                                                <TextBlock Text="{Binding ThumbLabel}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="{StaticResource Accent2Brush}"
                                                           FontSize="18" FontWeight="SemiBold"
                                                           Visibility="{Binding ThumbLabelVisibility}"/>
                                                <Border VerticalAlignment="Bottom" Background="#CC0E1218"
                                                        CornerRadius="0,0,7,7" Padding="4,2">
                                                    <TextBlock Text="{Binding SlotBadge}" FontSize="11"
                                                               Foreground="#F2F4F8" HorizontalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <TextBlock Text="{Binding RotateLabel}" Margin="0,6,0,0"
                                                   Foreground="{StaticResource Accent2Brush}"
                                                   FontSize="11" HorizontalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Border x:Name="DropInsertLine" Width="5" Height="176" CornerRadius="2"
                                Background="#FF5EC4B8" HorizontalAlignment="Left" VerticalAlignment="Top"
                                Visibility="Collapsed" IsHitTestVisible="False" Opacity="1"/>
                        <Border x:Name="DropGhost" Width="148" Height="188" CornerRadius="12"
                                BorderBrush="#FF5EC4B8" BorderThickness="3" Background="#AA5EC4B8"
                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                Visibility="Collapsed" IsHitTestVisible="False" Opacity="0.92"/>
                        </Grid>
                    </Border>

                    <Popup x:Name="PeekPopup" Placement="Mouse" AllowsTransparency="True" StaysOpen="False">
                        <Border CornerRadius="14" Background="#F2141820" BorderBrush="#AA5EC4B8" BorderThickness="1"
                                Padding="8" MaxWidth="360" MaxHeight="440">
                            <Image x:Name="PeekImage" Stretch="Uniform" MaxWidth="340" MaxHeight="420"/>
                        </Border>
                    </Popup>

                    <WrapPanel Grid.Row="3" Margin="12,4,12,6">
                        <Button Content="↑ Up" Style="{StaticResource EditorChip}" Click="MoveUp_Click" Margin="0,0,8,6"/>
                        <Button Content="↓ Down" Style="{StaticResource EditorChip}" Click="MoveDown_Click" Margin="0,0,8,6"/>
                        <Button Content="Rotate 90°" Style="{StaticResource EditorChip}" Click="Rotate_Click" Margin="0,0,8,6"/>
                        <Button Content="Delete" Style="{StaticResource EditorChip}" Click="Delete_Click" Margin="0,0,8,6"/>
                        <Button Content="Add files…" Style="{StaticResource EditorChipPrimary}"
                                Click="InsertImage_Click" Margin="0,0,8,6"/>
                        <Button Content="Merge…" Style="{StaticResource EditorChip}"
                                Click="OpenMerge_Click" Margin="0,0,8,6"/>
                    </WrapPanel>

                    <DockPanel Grid.Row="4" Margin="12,0,12,12" LastChildFill="True">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
                            <Button Content="Cancel" Style="{StaticResource EditorChip}" Margin="0,0,8,0"
                                    IsCancel="True" Click="CloseButton_Click"/>
                            <Button Content="Apply" Style="{StaticResource EditorChipPrimary}"
                                    IsDefault="True" Click="Apply_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="StatusText"
                                   Foreground="{StaticResource Accent2Brush}" FontSize="12"
                                   VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </DockPanel>
                </Grid>
            </Grid>
        </Border>
    </Border>
</Window>
