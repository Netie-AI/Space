                                                    Click="PdfSignLibrary_Click"/>
                                            <Button Content="Stamp image…" Style="{StaticResource DocChip}"
                                                    Click="PdfSignStamp_Click"/>
                                            <Border Width="1" Height="22" Background="#D6D6D6" Margin="4,0,10,6" VerticalAlignment="Center"/>
