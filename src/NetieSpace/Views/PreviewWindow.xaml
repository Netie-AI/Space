                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE70F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                       FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Fill &amp; Sign" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="PdfEditPdfBtn" Style="{StaticResource DocModeBtn}"
                                            Visibility="Collapsed"
                                            Click="PdfEditTextMode_Click" ToolTip="Native text only — click a word to replace">
