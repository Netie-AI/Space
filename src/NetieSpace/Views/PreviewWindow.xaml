                                        Click="DocZoomIn_Click" ToolTip="Zoom in"/>
                                <Button x:Name="DocFitBtn" Content="Fit" Style="{StaticResource DocChip}"
                                        Margin="6,0,0,0" MinHeight="28" Padding="10,4"
                                        Click="DocFit_Click" ToolTip="Fit page to window"/>
                                <Button x:Name="DocAreaBtn" Content="Area" Style="{StaticResource DocChip}"
