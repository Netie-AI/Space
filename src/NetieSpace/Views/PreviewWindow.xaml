<Window x:Class="NetieSpace.Views.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:controls="clr-namespace:NetieSpace.Controls"
        Title="NETIE SPACE Preview"
        Width="980" Height="680"
        MinWidth="640" MinHeight="420"
        ResizeMode="CanResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="True"
        Topmost="True"
        KeyDown="Window_KeyDown"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        SourceInitialized="Window_SourceInitialized"
        AllowDrop="True"
        PreviewDragOver="Window_PreviewDragOver"
        Drop="Window_Drop">

    <Window.Resources>
        <Style x:Key="DocChip" TargetType="Button">
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,8,6"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#D6D6D6"/>
            <Setter Property="Foreground" Value="#2C2C2C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E8F2FF"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#0B5CAB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#D6E8F8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DocChipPrimary" TargetType="Button">
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,8,6"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Background" Value="#0B5CAB"/>
            <Setter Property="BorderBrush" Value="#0B5CAB"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#094A8C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#083A70"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DocRailButton" TargetType="Button" BasedOn="{StaticResource DocChip}">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="DocIconBtn" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="7"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#2C2C2C"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E8F2FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#D6E8F8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <!-- Same fix as IconGhostButton (App.xaml): keep the app TextBlock style off the glyph. -->
            <Style.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="FontFamily" Value="{Binding FontFamily, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
                    <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
                </Style>
            </Style.Resources>
        </Style>
        <Style x:Key="DocModeBtn" TargetType="Button">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#2C2C2C"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#EEEEEE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DocModeOn" TargetType="Button" BasedOn="{StaticResource DocModeBtn}">
            <Setter Property="Background" Value="#E8F2FF"/>
            <Setter Property="BorderBrush" Value="#0B5CAB"/>
            <Setter Property="Foreground" Value="#0B5CAB"/>
        </Style>
        <Style x:Key="HudBtn" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Foreground" Value="#F2F4F8"/>
            <Setter Property="Background" Value="#33FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#55FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DocShareBtn" TargetType="Button" BasedOn="{StaticResource DocChipPrimary}">
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="MinHeight" Value="32"/>
        </Style>
        <Style x:Key="DocTabBtn" TargetType="Button">
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="#6E6E6E"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DocTabOn" TargetType="Button" BasedOn="{StaticResource DocTabBtn}">
            <Setter Property="Foreground" Value="#0B5CAB"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderBrush" Value="#0B5CAB"/>
        </Style>
        <Style x:Key="DocThumbBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Margin=0: acrylic HWND must match rounded shell (Margin left a sharp rectangle behind) -->
    <Border x:Name="RootBorder" Margin="0" Background="Transparent"
            SnapsToDevicePixels="True" UseLayoutRounding="True">
        <Border x:Name="GlassShell"
                CornerRadius="24"
                BorderThickness="1"
                BorderBrush="{StaticResource GlassBorder}"
                ClipToBounds="True"
                RenderOptions.BitmapScalingMode="HighQuality">

            <Border.Background>
                <!-- Light frost so acrylic blur reads through -->
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1" Opacity="0.58">
                    <GradientStop Color="#A8141820" Offset="0"/>
                    <GradientStop Color="#90101218" Offset="0.55"/>
                    <GradientStop Color="#88101828" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <Grid>
                <!-- Specular wash overlay -->
                <Border x:Name="SpecularWash" CornerRadius="24" IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,0.4">
                            <GradientStop Color="#22FFFFFF" Offset="0"/>
                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Glass title bar -->
            <Border x:Name="TitleBarHost" Grid.Row="0" CornerRadius="24,24,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                    BorderBrush="{StaticResource GlassHighlight}" BorderThickness="0,0,0,1">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1" Opacity="0.5">
                        <GradientStop Color="#38FFFFFF" Offset="0"/>
                        <GradientStop Color="#08FFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>

                <!-- Peek glass title (hidden in PDF workbench). -->
                <Grid>
                <Grid x:Name="PeekTitleCluster" Margin="22,0,18,0" MinHeight="56">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0" VerticalAlignment="Center" LastChildFill="True" Margin="0,0,16,0">
                        <Border x:Name="BrandDot" DockPanel.Dock="Left" Width="10" Height="10" CornerRadius="5"
                                Margin="0,0,12,0" VerticalAlignment="Center"
                                Background="{StaticResource AccentBrush}" Opacity="0.95"/>
                        <TextBlock x:Name="BrandModeText" DockPanel.Dock="Left" Text="NETIE SPACE"
                                   FontFamily="{StaticResource DisplayFont}"
                                   Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <Border DockPanel.Dock="Left" Width="1" Height="16" Background="#33FFFFFF"
                                Margin="0,0,14,0" VerticalAlignment="Center"/>
                        <TextBox x:Name="FileNameEditBox" DockPanel.Dock="Left" Visibility="Collapsed"
                                 FontFamily="{StaticResource BodyFont}"
                                 FontSize="13" FontWeight="Medium"
                                 MaxWidth="420" MinWidth="120" Height="26" Padding="6,2"
                                 VerticalContentAlignment="Center" VerticalAlignment="Center"
                                 HorizontalAlignment="Left"
                                 Background="#33101820" Foreground="{StaticResource TextBrush}"
                                 BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
                                 CaretBrush="{StaticResource AccentBrush}"
                                 KeyDown="FileNameEditBox_KeyDown"
                                 LostKeyboardFocus="FileNameEditBox_LostFocus"/>
                        <!-- Fill child: takes the leftover width and ellipsises. Full name shows only on rename. -->
                        <TextBlock x:Name="FileNameText" Text="Preview"
                                   FontFamily="{StaticResource BodyFont}"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="13" FontWeight="Medium"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Left"
                                   Cursor="Hand"
                                   ToolTip="Click to rename"
                                   MouseLeftButtonUp="FileNameText_MouseLeftButtonUp"/>
                    </DockPanel>

                    <WrapPanel Grid.Column="1" MaxWidth="560" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,6,0,6">
                        <Button x:Name="EditModeButton" Content="Edit" Visibility="Collapsed"
                                Style="{StaticResource AccentButton}" Margin="0,0,10,0" Padding="16,8"
                                FontWeight="SemiBold" FontSize="13"
                                Click="EditModeButton_Click"
                                ToolTip="Edit tools"/>
                        <Button x:Name="EditInAppButton" Content="Workbench" Visibility="Collapsed"
                                Style="{StaticResource GhostButton}" Margin="0,0,10,0" Padding="14,8"
                                FontWeight="SemiBold" FontSize="13"
                                Click="EditInAppButton_Click"
                                ToolTip="Open the PDF workbench"/>
                        <Button x:Name="OpenInAppButton" Visibility="Collapsed"
                                Style="{StaticResource GhostButton}" Margin="0,0,10,0" Padding="14,8"
                                FontWeight="SemiBold" FontSize="13"
                                Click="OpenInAppButton_Click"/>
                        <Button x:Name="TextEditButton" Content="Edit" Visibility="Collapsed"
                                Style="{StaticResource AccentButton}" Margin="0,0,10,0" Padding="16,8"
                                FontWeight="SemiBold" FontSize="13"
                                Click="TextEditButton_Click"
                                ToolTip="Edit text"/>
                        <Button x:Name="SummaryToggleButton" Content="Summary"
                                Style="{StaticResource GhostButton}" Margin="0,0,8,0" Padding="12,6"
                                Click="SummaryToggleButton_Click"
                                ToolTip="AI summary"/>
                        <Button x:Name="ProviderButton" Content="AI: —"
                                Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                                Click="ProviderButton_Click"
                                ToolTip="Switch AI provider"/>
                        <Button x:Name="ContinueChatButton" Content="Chat"
                                Style="{StaticResource TealButton}" Margin="0,0,8,0"
                                Click="ContinueChatButton_Click"
                                ToolTip="Notes &amp; chat"/>
                        <Button x:Name="LookupClipButton" Content="&#xE721;"
                                Style="{StaticResource IconGhostButton}" Margin="0,0,8,0"
                                Click="LookupClipButton_Click"
                                ToolTip="Look up selection" AutomationProperties.Name="Look up selection"/>
                        <Button x:Name="RemoveBgButton" Content="Remove BG" Visibility="Collapsed"
                                Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                                Click="RemoveBgButton_Click"/>
                        <Button x:Name="OcrImageButton" Content="OCR" Visibility="Collapsed"
                                Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                                Click="OcrImageButton_Click"
                                ToolTip="Read text (OCR)"/>
                        <Button x:Name="CopyImageButton" Content="Copy" Visibility="Collapsed"
                                Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                                Click="CopyImageButton_Click"
                                ToolTip="Copy image"/>
                        <Button x:Name="CompressImageButton" Content="Compress" Visibility="Collapsed"
                                Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                                Click="CompressImageButton_Click"
                                ToolTip="Reduce file size"/>
                        <Button x:Name="RotateImageButton" Content="Rotate 90" Visibility="Collapsed"
                                Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                                Click="RotateImageButton_Click"
                                ToolTip="Rotate 90 deg clockwise (saves a copy)"/>
                        <Button x:Name="SendToComfyButton" Content="Send to Comfy..." Visibility="Collapsed"
                                Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                                Click="SendToComfyButton_Click"
                                ToolTip="Send to ComfyUI"/>
                        <Button x:Name="WindowsAiButton" Content="Windows AI..." Visibility="Collapsed"
                                Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                                Click="WindowsAiButton_Click"
                                ToolTip="Windows AI"/>
                        <!-- Share replaces the old text "convert" entry: icon only, sheet does the rest -->
                        <Button x:Name="ShareButton"
                                Style="{StaticResource IconGhostButton}" Margin="0,0,8,0"
                                Click="ShareButton_Click"
                                ToolTip="Share" AutomationProperties.Name="Share">
                            <Path Stroke="{StaticResource TextBrush}" StrokeThickness="1.7"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Stretch="Uniform" Width="16" Height="16"
                                  Data="M 12,3.4 L 12,14.6 M 8.2,7.2 L 12,3.4 L 15.8,7.2 M 7.6,10 L 5.6,10 C 4.7,10 4,10.7 4,11.6 L 4,19 C 4,19.9 4.7,20.6 5.6,20.6 L 18.4,20.6 C 19.3,20.6 20,19.9 20,19 L 20,11.6 C 20,10.7 19.3,10 18.4,10 L 16.4,10"/>
                        </Button>
                        <Button x:Name="SetupHelpButton" Content="&#xE713;"
                                Style="{StaticResource IconGhostButton}" Margin="0,0,8,0"
                                Click="SetupHelpButton_Click"
                                ToolTip="Settings" AutomationProperties.Name="Settings"/>
                        <StackPanel x:Name="ZoomStrip" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,8,0">
                            <Button x:Name="ZoomOutButton" Content="−" Style="{StaticResource GhostButton}"
                                    Margin="0,0,4,0" Padding="10,4" Click="ZoomOutButton_Click"/>
                            <TextBlock x:Name="ZoomLabel" Text="100%" VerticalAlignment="Center"
                                       Foreground="{StaticResource MutedBrush}" FontSize="11.5" MinWidth="40" TextAlignment="Center"/>
                            <Button x:Name="ZoomInButton" Content="+" Style="{StaticResource GhostButton}"
                                    Margin="0,0,4,0" Padding="10,4" Click="ZoomInButton_Click"/>
                            <Button x:Name="ZoomFitButton" Content="Fit" Style="{StaticResource GhostButton}"
                                    Padding="10,4" Click="ZoomFitButton_Click"/>
                        </StackPanel>
                        <Button x:Name="CloseChromeButton" Content="✕" Style="{StaticResource IconCloseButton}" Click="CloseButton_Click"
                                ToolTip="Close" AutomationProperties.Name="Close"/>
                    </WrapPanel>

                    <!-- Share sheet. Popups get their own HWND, so this draws cleanly over WebView2. -->
                    <Popup x:Name="SharePopup" PlacementTarget="{Binding ElementName=ShareButton}"
                           Placement="Bottom" HorizontalOffset="-268" VerticalOffset="10"
                           StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
                           Focusable="False">
                        <Border Width="326" CornerRadius="18" Padding="10"
                                Background="#F21A1E28" BorderBrush="#3AFFFFFF" BorderThickness="1"
                                Margin="12">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="26" ShadowDepth="6" Direction="270"
                                                  Color="#000000" Opacity="0.5"/>
                            </Border.Effect>
                            <StackPanel>
                                <DockPanel Margin="8,4,4,10">
                                    <Button DockPanel.Dock="Right" Content="✕" Width="24" Height="24"
                                            Style="{StaticResource MicroIconButton}"
                                            Click="ShareClose_Click" ToolTip="Close"/>
                                    <StackPanel>
                                        <TextBlock Text="Share" FontFamily="{StaticResource DisplayFont}"
                                                   Foreground="{StaticResource TextBrush}"
                                                   FontSize="15" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="ShareSubjectText" Text="Preview"
                                                   FontFamily="{StaticResource BodyFont}"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   FontSize="11" Margin="0,2,0,0"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="240"
                                                   HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </DockPanel>

                                <Button Style="{StaticResource ShareRowButton}" x:Name="ShareSelectionRow"
                                        Click="ShareCopySelection_Click">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Left" Style="{StaticResource ShareRowGlyph}">
                                            <TextBlock Text="❝" FontSize="13" Foreground="#D8FFF8"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Copy selection" Foreground="{StaticResource TextBrush}" FontSize="13"/>
                                            <TextBlock x:Name="ShareSelectionHint" Text="Whatever you highlighted in the preview"
                                                       Foreground="{StaticResource MutedBrush}" FontSize="10.5"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Button>

                                <Button Style="{StaticResource ShareRowButton}" Click="ShareCopyFile_Click">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Left" Style="{StaticResource ShareRowGlyph}">
                                            <TextBlock Text="⧉" FontSize="14" Foreground="#D8FFF8"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Copy file" Foreground="{StaticResource TextBrush}" FontSize="13"/>
                                            <TextBlock Text="Paste straight into Mail, Teams or a folder"
                                                       Foreground="{StaticResource MutedBrush}" FontSize="10.5"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Button>

                                <Border Height="1" Background="#1FFFFFFF" Margin="10,7"/>

                                <Button Style="{StaticResource ShareRowButton}" Click="ShareMailButton_Click">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Left" Style="{StaticResource ShareRowGlyph}">
                                            <TextBlock Text="✉" FontSize="14" Foreground="#D8FFF8"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Email a copy" Foreground="{StaticResource TextBrush}" FontSize="13"/>
                                            <TextBlock Text="Opens your mail app with the text prefilled"
                                                       Foreground="{StaticResource MutedBrush}" FontSize="10.5"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Button>

                                <Button Style="{StaticResource ShareRowButton}" Click="ShareOpenWithButton_Click">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Left" Style="{StaticResource ShareRowGlyph}">
                                            <TextBlock Text="↗" FontSize="14" Foreground="#D8FFF8"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Open with…" Foreground="{StaticResource TextBrush}" FontSize="13"/>
                                            <TextBlock Text="Hand off to any app Windows offers"
                                                       Foreground="{StaticResource MutedBrush}" FontSize="10.5"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Button>

                                <Button Style="{StaticResource ShareRowButton}" Click="ShareRevealButton_Click">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Left" Style="{StaticResource ShareRowGlyph}">
                                            <TextBlock Text="🗀" FontSize="13" Foreground="#D8FFF8"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Show in folder" Foreground="{StaticResource TextBrush}" FontSize="13"/>
                                            <TextBlock Text="Reveal in File Explorer"
                                                       Foreground="{StaticResource MutedBrush}" FontSize="10.5"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Button>

                                <Border Height="1" Background="#1FFFFFFF" Margin="10,7"/>

                                <TextBlock x:Name="ShareFormatsLabel" Text="Send as a different format"
                                           Foreground="{StaticResource MutedBrush}" FontSize="10.5"
                                           FontWeight="SemiBold" Margin="12,0,0,4"/>

                                <Button x:Name="ShareMdRow" Style="{StaticResource ShareRowButton}" Click="ConvertMdButton_Click">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Left" Style="{StaticResource ShareRowGlyph}">
                                            <TextBlock Text="M↓" FontSize="11" FontWeight="Bold" Foreground="#D8FFF8"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Markdown (.md)" VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextBrush}" FontSize="13"/>
                                    </DockPanel>
                                </Button>

                                <Button x:Name="SharePdfRow" Style="{StaticResource ShareRowButton}" Click="ConvertPdfButton_Click">
