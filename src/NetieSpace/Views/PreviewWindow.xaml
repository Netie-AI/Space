                                            Click="PdfModeFill_Click" ToolTip="Type into a cell or blank"
                                            Content="Fill"/>
                                    <Button x:Name="PdfModeCommentBtn" Style="{StaticResource DocChip}" MinWidth="96"
                                            Click="PdfModeComment_Click" ToolTip="Highlight markup"
                                            Content="Comment"/>
                                    <Button x:Name="PdfMoreButton" Content="More..." Style="{StaticResource DocModeBtn}"
