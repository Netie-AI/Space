                                        <TextBlock Text="Pages" FontSize="11" Foreground="#6E6E6E" Margin="0,0,0,6" FontWeight="SemiBold"/>
                                        <WrapPanel>
                                            <Button Content="Reorder…" Style="{StaticResource DocChip}" Click="PdfOrganize_Click"
                                                    ToolTip="Drag pages · rotate · delete"/>
                                            <Button Content="Merge…" Style="{StaticResource DocChip}" Click="PdfMerge_Click"/>
                                            <Button Content="Extract…" Style="{StaticResource DocChip}" Click="PdfExtract_Click"/>
                                            <Button Content="Split" Style="{StaticResource DocChip}" Click="PdfSplit_Click"/>
                                            <Button Content="Rotate 90°" Style="{StaticResource DocChip}" Click="PdfRotate90_Click"/>
                                            <Button Content="Reverse" Style="{StaticResource DocChip}" Click="PdfReverse_Click"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

