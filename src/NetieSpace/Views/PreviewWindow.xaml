                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Content="⇥" Style="{StaticResource MicroIconButton}"
                                    Click="SummaryUndockButton_Click"
                                    ToolTip="Put the summary back on top"/>
                            <TextBlock Text="Summary" FontFamily="{StaticResource DisplayFont}"
                                       Foreground="{StaticResource Accent2Brush}"
                                       FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </DockPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      Style="{StaticResource GlassScrollViewer}">
                            <!-- Mirrors the top strip so every existing summary write reaches both -->
                            <TextBlock x:Name="SummaryRailText"
                                       Text="{Binding Text, ElementName=SummaryText, Mode=OneWay}"
                                       FontFamily="{StaticResource BodyFont}"
                                       Foreground="{StaticResource TextBrush}"
                                       FontSize="12.5" LineHeight="18.5" TextWrapping="Wrap" Opacity="0.94"
                                       Cursor="Hand" MouseLeftButtonUp="SummaryText_MouseLeftButtonUp"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <Border x:Name="DocLeftNav" Grid.Column="1" Visibility="Collapsed"
                        Background="#F3F3F3" BorderBrush="#D6D6D6" BorderThickness="0,0,1,0">
                    <DockPanel Margin="6,8,6,8">
                        <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="0,0,0,8">
                            <Button x:Name="DocThumbsBtn" Content="&#xE8A9;" Style="{StaticResource DocIconBtn}"
                                    Width="32" Height="32" Click="DocThumbsToggle_Click"
                                    ToolTip="Hide page thumbnails"/>
                            <Button Content="&#xE7AD;" Style="{StaticResource DocIconBtn}"
                                    Width="32" Height="32" Click="PdfRotate90_Click"
                                    ToolTip="Rotate page 90"/>
                        </DockPanel>
                        <Button x:Name="DocThumbsMoreBtn" DockPanel.Dock="Bottom" Content="Load more"
                                Style="{StaticResource DocChip}" Margin="0,6,0,0" Visibility="Collapsed"
                                Click="DocThumbsMore_Click" ToolTip="Render the next batch of page thumbnails"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="DocThumbsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource DocThumbBtn}" Click="DocThumb_Click"
                                                ToolTip="Go to this page">
                                            <StackPanel>
                                                <Border BorderThickness="2" CornerRadius="2" Padding="1">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Active}" Value="True">
                                                                    <Setter Property="BorderBrush" Value="#0B5CAB"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Image Source="{Binding Image}" Width="96" Stretch="Uniform"/>
                                                </Border>
                                                <TextBlock Text="{Binding Page}" FontSize="11" Foreground="#6E6E6E"
                                                           HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <Border x:Name="ContentWellBorder" Grid.Column="2" Background="{StaticResource ContentWellBrush}"
                        CornerRadius="0,0,22,22" ClipToBounds="True" Margin="1,0,1,1"
                        SizeChanged="ContentWellBorder_SizeChanged">
                <Grid ClipToBounds="True" x:Name="ContentHost">
                    <Border x:Name="ContentWellInner" CornerRadius="0,0,21,21" ClipToBounds="True">
                    <Grid>
                    <ScrollViewer x:Name="ImageScroll" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                  PanningMode="Both"
                                  Style="{StaticResource GlassScrollViewer}"
                                  PreviewMouseWheel="ImageScroll_PreviewMouseWheel"
                                  SizeChanged="ImageScroll_SizeChanged"
                                  IsManipulationEnabled="True"
                                  ManipulationDelta="ImageScroll_ManipulationDelta"
                                  ManipulationInertiaStarting="ImageScroll_ManipulationInertiaStarting">
                        <Grid x:Name="ImageCanvas" Background="Transparent">
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16">
                                <Rectangle x:Name="ImageAlphaBoard" RadiusX="8" RadiusY="8"
                                           Visibility="Collapsed"
                                           Width="{Binding ActualWidth, ElementName=PreviewImage}"
                                           Height="{Binding ActualHeight, ElementName=PreviewImage}">
                                    <Rectangle.Fill>
                                        <DrawingBrush TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute">
                                            <DrawingBrush.Drawing>
                                                <DrawingGroup>
                                                    <GeometryDrawing Brush="#FF2A3140">
                                                        <GeometryDrawing.Geometry>
                                                            <RectangleGeometry Rect="0,0,16,16"/>
                                                        </GeometryDrawing.Geometry>
                                                    </GeometryDrawing>
                                                    <GeometryDrawing Brush="#FF3A4252">
                                                        <GeometryDrawing.Geometry>
                                                            <GeometryGroup>
                                                                <RectangleGeometry Rect="0,0,8,8"/>
                                                                <RectangleGeometry Rect="8,8,8,8"/>
                                                            </GeometryGroup>
                                                        </GeometryDrawing.Geometry>
                                                    </GeometryDrawing>
                                                </DrawingGroup>
                                            </DrawingBrush.Drawing>
                                        </DrawingBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                                <Image x:Name="PreviewImage" Stretch="Uniform"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       MouseLeftButtonDown="PreviewImage_MouseLeftButtonDown"
                                       MouseMove="PreviewImage_MouseMove"
                                       MouseLeftButtonUp="PreviewImage_MouseLeftButtonUp"
                                       MouseLeave="PreviewImage_MouseLeave"
                                       ToolTip="Drag out to copy the file">
                                    <Image.LayoutTransform>
                                        <ScaleTransform x:Name="ImageScale" ScaleX="1" ScaleY="1"/>
                                    </Image.LayoutTransform>
                                </Image>
                            </Grid>
                        </Grid>
                    </ScrollViewer>

                    <wv2:WebView2 x:Name="PreviewWebView"
                                  Visibility="Visible"
                                  SizeChanged="PreviewWebView_SizeChanged"/>

                    <!-- Captures image drops over WebView2 HWND when a PDF is open -->
                    <Border x:Name="PdfDropOverlay" Visibility="Collapsed" Background="#66000000"
                            AllowDrop="True" Panel.ZIndex="30"
                            DragOver="PdfDropOverlay_DragOver"
                            DragLeave="PdfDropOverlay_DragLeave"
                            Drop="Window_Drop">
                        <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                                Padding="28,18" CornerRadius="16"
                                Background="#40000000" BorderBrush="#665EC4B8" BorderThickness="1">
                            <TextBlock Text="Drop Word / image / PDF to append pages"
                                       FontFamily="{StaticResource DisplayFont}"
                                       Foreground="{StaticResource TextBrush}"
                                       FontSize="15" FontWeight="SemiBold"/>
                        </Border>
                    </Border>

                    <!-- Soft corner masks so HWND WebView2 doesn't read as a sharp rectangle -->
                    <Canvas x:Name="CornerMaskLayer" IsHitTestVisible="False" Panel.ZIndex="20">
                        <Path x:Name="CornerTL" Fill="{StaticResource ContentWellBrush}"/>
                        <Path x:Name="CornerTR" Fill="{StaticResource ContentWellBrush}"/>
                        <Path x:Name="CornerBL" Fill="{StaticResource ContentWellBrush}"/>
                        <Path x:Name="CornerBR" Fill="{StaticResource ContentWellBrush}"/>
                    </Canvas>

                    <!-- Video: light autoplay preview; Edit expands full Netie editor -->
                    <Grid x:Name="VideoPanel" Visibility="Collapsed" Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                        <MediaElement x:Name="PreviewVideo"
                                      LoadedBehavior="Manual"
                                      UnloadedBehavior="Stop"
                                      ScrubbingEnabled="True"
                                      Stretch="Uniform"
                                      MediaOpened="PreviewVideo_MediaOpened"
                                      MediaEnded="PreviewVideo_MediaEnded"/>
                        <!-- Leave-black / Add black / text: OV lane is not the picture.
                             Playhead on that packed range must show the card here or
                             Export "picture is not black" is the first cue. -->
                        <Border x:Name="VideoOverlayPreview" Visibility="Collapsed"
                                IsHitTestVisible="False" HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch">
                            <TextBlock x:Name="VideoOverlayPreviewText"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontSize="28" FontWeight="SemiBold"
                                       TextWrapping="Wrap" TextAlignment="Center"
                                       Margin="24"/>
                        </Border>
                        </Grid>
                        <Border Grid.Row="1" Margin="0,12,0,0" Padding="14,12" CornerRadius="16"
                                Background="#1AFFFFFF" BorderBrush="#40FFFFFF" BorderThickness="1">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="PlayPauseButton" Content="Pause" Style="{StaticResource AccentButton}"
                                            Click="PlayPauseButton_Click" Width="78" Padding="12,8"/>
                                    <Grid Grid.Column="1" Margin="14,0" VerticalAlignment="Center"
                                          SizeChanged="VideoSliderHost_SizeChanged">
                                        <Border Height="5" VerticalAlignment="Center" CornerRadius="2.5"
                                                Background="#28FFFFFF" Margin="6,0" IsHitTestVisible="False"/>
                                        <Border x:Name="MarkRangeTint" Height="5" VerticalAlignment="Center"
                                                CornerRadius="2.5" Background="#665EC4B8"
                                                HorizontalAlignment="Left" Width="0" Margin="6,0,0,0"
                                                Visibility="Collapsed" IsHitTestVisible="False"/>
                                        <Slider x:Name="VideoSlider"
                                                VerticalAlignment="Center"
                                                Minimum="0" Maximum="1"
                                                IsMoveToPointEnabled="True"
                                                Background="Transparent"
                                                PreviewMouseLeftButtonDown="VideoSlider_PreviewMouseDown"
                                                PreviewMouseLeftButtonUp="VideoSlider_PreviewMouseUp"
                                                LostMouseCapture="VideoSlider_LostMouseCapture"
                                                ValueChanged="VideoSlider_ValueChanged"/>
                                    </Grid>
                                    <TextBlock x:Name="VideoTimeText" Grid.Column="2"
                                               VerticalAlignment="Center" MinWidth="110"
                                               Foreground="{StaticResource MutedBrush}" FontSize="12"
                                               Text="00:00 / 00:00"/>
                                </Grid>

                                <TextBlock x:Name="VideoLightHint" Margin="0,10,0,0"
                                           Text="Light preview — press Edit for the full Netie video editor (timeline, split, export)."
                                           Foreground="{StaticResource MutedBrush}" FontSize="12.5"
                                           TextWrapping="Wrap"/>

                                <!-- Full editor chrome (hidden until Edit) -->
                                <StackPanel x:Name="VideoEditorChrome" Visibility="Collapsed" Margin="0,10,0,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                    <Button Content="Mark In" Style="{StaticResource EditorChip}"
                                            Click="MarkInButton_Click" ToolTip="Set Mark In at playhead"/>
                                    <Button Content="Mark Out" Style="{StaticResource EditorChip}"
                                            Click="MarkOutButton_Click" ToolTip="Set Mark Out at playhead"/>
                                    <TextBlock x:Name="MarkRangeText" VerticalAlignment="Center"
                                               Foreground="{StaticResource Accent2Brush}" FontSize="12"
                                               Text="In — · Out —"/>
                                </StackPanel>

                                <!-- Multi-track timeline (V1 / A1 / A2 / OV / CC) -->
                                <Border Margin="0,12,0,0" Padding="12,10" CornerRadius="12"
                                        Background="#14FFFFFF" BorderBrush="#28FFFFFF" BorderThickness="1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <WrapPanel>
                                            <Button x:Name="SplitButton" Content="✂ Split" Margin="0,0,8,6"
                                                    Style="{StaticResource EditorChipPrimary}"
                                                    Click="SplitAtPlayhead_Click"
                                                    ToolTip="Cut at playhead into two clips"/>
                                            <Button x:Name="CutMiddleButton" Content="Delete" Margin="0,0,8,6"
                                                    Style="{StaticResource EditorChipPrimary}"
                                                    IsEnabled="False" Click="CutMiddleButton_Click"
                                                    ToolTip="Select a clip first — remove it (merge or black gap)"/>
                                            <Button x:Name="BladeModeButton" Content="Select" Margin="0,0,8,6"
                                                    Style="{StaticResource EditorChip}"
                                                    Click="BladeModeButton_Click"
                                                    ToolTip="Click a clip to select, then Delete or drag to reorder"/>
                                            <Button Content="Fade In" Style="{StaticResource EditorChip}" Margin="0,0,8,6"
                                                    Click="FadeInButton_Click" ToolTip="0.5s fade in on selected clip"/>
                                            <Button Content="Fade Out" Style="{StaticResource EditorChip}" Margin="0,0,8,6"
                                                    Click="FadeOutButton_Click" ToolTip="0.5s fade out on selected clip"/>
                                            <Button Content="Wipe" Style="{StaticResource EditorChip}" Margin="0,0,8,6"
                                                    Click="WipeButton_Click"
                                                    ToolTip="0.5s wipe into the next clip (ffmpeg xfade wipeleft) — burns on Export"/>
                                            <Button Content="Text" Style="{StaticResource EditorChip}" Margin="0,0,8,6"
                                                    Click="OverlayTextButton_Click"
                                                    ToolTip="Overlay text on the canvas at the playhead — burns into Export"/>
                                            <Button Content="Captions" Style="{StaticResource EditorChip}" Margin="0,0,8,6"
                                                    Click="AutoCaptionsButton_Click"
                                                    ToolTip="Local AI subtitles (whisper.cpp) — ZH+EN auto"/>
                                            <TextBlock x:Name="TimelineHintText"
                                                       Text="Move playhead → Split → select clip → Delete"
                                                       FontFamily="{StaticResource BodyFont}"
                                                       Foreground="#E8FFFFFF"
                                                       FontSize="12" FontWeight="SemiBold"
                                                       VerticalAlignment="Center" Margin="0,0,0,6"
                                                       TextWrapping="Wrap"/>
                                        </WrapPanel>

                                        <!-- V1 -->
                                        <DockPanel Grid.Row="1" Margin="0,10,0,0" LastChildFill="True">
                                            <TextBlock Text="V1" Width="28" VerticalAlignment="Center"
                                                       Foreground="{StaticResource Accent2Brush}" FontSize="12" FontWeight="Bold"/>
                                            <Grid x:Name="TimelineTrackHost" Height="48"
                                                  Background="#18000000"
                                                  SizeChanged="TimelineTrackHost_SizeChanged"
                                                  PreviewMouseLeftButtonDown="TimelineTrack_PreviewMouseLeftButtonDown"
                                                  PreviewMouseMove="TimelineTrack_PreviewMouseMove"
                                                  PreviewMouseLeftButtonUp="TimelineTrack_PreviewMouseLeftButtonUp"
                                                  LostMouseCapture="TimelineTrack_LostMouseCapture"
                                                  PreviewMouseRightButtonUp="TimelineTrack_PreviewMouseRightButtonUp">
                                                <Border Height="36" VerticalAlignment="Center" CornerRadius="8"
                                                        Background="#2AFFFFFF" IsHitTestVisible="False"/>
                                                <Canvas x:Name="TimelineClipCanvas" Height="36" VerticalAlignment="Center"
                                                        IsHitTestVisible="True"/>
                                                <Border x:Name="TimelineKeepRange" Height="36" VerticalAlignment="Center"
                                                        CornerRadius="6" Background="Transparent"
                                                        HorizontalAlignment="Left" Width="0"
                                                        IsHitTestVisible="False" Visibility="Collapsed"/>
                                                <Border x:Name="TimelineDimLeft" Height="36" VerticalAlignment="Center"
                                                        CornerRadius="8,0,0,8" Background="#66000000"
                                                        HorizontalAlignment="Left" Width="0"
                                                        IsHitTestVisible="False"/>
                                                <Border x:Name="TimelineDimRight" Height="36" VerticalAlignment="Center"
                                                        CornerRadius="0,8,8,0" Background="#66000000"
                                                        HorizontalAlignment="Left" Width="0"
                                                        IsHitTestVisible="False"/>
                                                <Border x:Name="TimelinePlayhead" Width="3" Height="48"
                                                        VerticalAlignment="Center" Background="#FF5EC4B8"
                                                        HorizontalAlignment="Left" Margin="0"
                                                        IsHitTestVisible="False"/>
                                                <Border x:Name="TimelineInHandle" Width="12" Height="40"
                                                        VerticalAlignment="Center" CornerRadius="3"
                                                        Background="#5EC4B8" Cursor="SizeWE"
                                                        HorizontalAlignment="Left"
                                                        BorderBrush="#FFFFFF" BorderThickness="1"
                                                        ToolTip="Drag Mark In"/>
                                                <Border x:Name="TimelineOutHandle" Width="12" Height="40"
                                                        VerticalAlignment="Center" CornerRadius="3"
                                                        Background="#5EC4B8" Cursor="SizeWE"
                                                        HorizontalAlignment="Left"
                                                        BorderBrush="#FFFFFF" BorderThickness="1"
                                                        ToolTip="Drag Mark Out"/>
                                            </Grid>
                                        </DockPanel>

                                        <!-- A1 -->
                                        <DockPanel Grid.Row="2" Margin="0,4,0,0" LastChildFill="True">
                                            <TextBlock Text="A1" Width="28" VerticalAlignment="Center"
                                                       Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                                            <Grid x:Name="AudioTrack1Host" Height="22" Background="#12FFFFFF"
                                                  PreviewMouseLeftButtonDown="AudioTrack_PreviewMouseLeftButtonDown"
                                                  Tag="A1">
                                                <Canvas x:Name="AudioTrack1Canvas" Height="18" VerticalAlignment="Center"/>
                                            </Grid>
                                        </DockPanel>

                                        <!-- A2 (music / mute lane) -->
                                        <DockPanel Grid.Row="3" Margin="0,4,0,0" LastChildFill="True">
                                            <TextBlock Text="A2" Width="28" VerticalAlignment="Center"
                                                       Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                                            <Grid x:Name="AudioTrack2Host" Height="22" Background="#12FFFFFF"
                                                  AllowDrop="True"
                                                  PreviewMouseLeftButtonDown="AudioTrack_PreviewMouseLeftButtonDown"
                                                  Tag="A2"
                                                  ToolTip="Drop or move clips here for music / mute lane">
                                                <Canvas x:Name="AudioTrack2Canvas" Height="18" VerticalAlignment="Center"/>
                                            </Grid>
                                        </DockPanel>

                                        <!-- OV (Leave black / Add black / text) -->
                                        <DockPanel Grid.Row="4" Margin="0,4,0,0" LastChildFill="True">
                                            <TextBlock Text="OV" Width="28" VerticalAlignment="Center"
                                                       Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                                            <Grid x:Name="OverlayTrackHost" Height="22" Background="#12FFFFFF"
                                                  ToolTip="Overlay cards (Leave black / Add black / text) — packed start + length. Burns on Export.">
                                                <Canvas x:Name="OverlayTrackCanvas" Height="18" VerticalAlignment="Center"/>
                                            </Grid>
                                        </DockPanel>

                                        <!-- CC captions track -->
                                        <DockPanel Grid.Row="5" Margin="0,6,0,0" LastChildFill="True">
                                            <TextBlock Text="CC" Width="28" VerticalAlignment="Center"
                                                       Foreground="{StaticResource Accent2Brush}" FontSize="11" FontWeight="Bold"/>
                                            <Grid x:Name="CaptionTrackHost" Height="28" Background="#12FFFFFF"
                                                  ToolTip="Caption cues — drag to shift timing">
                                                <Canvas x:Name="CaptionTrackCanvas" Height="24" VerticalAlignment="Center"/>
                                            </Grid>
                                        </DockPanel>
                                    </Grid>
                                </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border x:Name="LoadingOverlay" Visibility="Collapsed">
                        <Border.Background>
                            <SolidColorBrush Color="#10141C" Opacity="0.72"/>
                        </Border.Background>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Border Padding="28,20" CornerRadius="16" BorderBrush="#38FFFFFF" BorderThickness="1"
                                    Background="#28FFFFFF">
                                <StackPanel>
                                    <TextBlock Text="Loading…"
                                               FontFamily="{StaticResource DisplayFont}"
                                               Foreground="{StaticResource TextBrush}"
                                               FontSize="17" FontWeight="SemiBold"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="LoadingText" Text=""
                                               FontFamily="{StaticResource BodyFont}"
                                               Foreground="{StaticResource MutedBrush}"
                                               FontSize="12" Margin="0,8,0,0"
                                               HorizontalAlignment="Center"/>
                                    <ProgressBar x:Name="LoadingProgress" Height="4" Margin="0,14,0,0"
                                                   Minimum="0" Maximum="100" Value="0"
                                                   Visibility="Collapsed"
                                                   Foreground="{StaticResource Accent2Brush}"
                                                   Background="#28FFFFFF"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                    </Grid>
                    </Border>
                </Grid>
                </Border>

                <!-- Popup HWND so tools/zoom paint over WebView2 (same trick as Share). -->
                <Popup x:Name="DocToolFloat" Grid.Column="2"
                       PlacementTarget="{Binding ElementName=ContentWellBorder}"
                       Placement="Relative" AllowsTransparency="True" StaysOpen="True"
                       PopupAnimation="Fade" Focusable="False">
                    <Border x:Name="DocFloatHost" CornerRadius="16" Padding="10,8" MaxWidth="720"
                            BorderBrush="#66FFFFFF" BorderThickness="1"
                            MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                        <Border.Background>
                            <SolidColorBrush Color="#D8F4F6F8"/>
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270"
                                              Color="#000000" Opacity="0.35"/>
                        </Border.Effect>
                    </Border>
                </Popup>
                <Popup x:Name="DocZoomFloat" Grid.Column="2"
                       PlacementTarget="{Binding ElementName=ContentWellBorder}"
                       Placement="Relative" AllowsTransparency="True" StaysOpen="True"
                       PopupAnimation="Fade" Focusable="False">
                    <Border x:Name="DocZoomHud" Padding="8,6" CornerRadius="14"
                            BorderBrush="#55FFFFFF" BorderThickness="1">
                        <Border.Background>
                            <SolidColorBrush Color="#99141820"/>
                        </Border.Background>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource HudBtn}" Click="DocZoomOut_Click"
                                    ToolTip="Zoom out" Content="-"/>
                            <TextBlock x:Name="DocZoomHudText" Text="100%" VerticalAlignment="Center"
                                       Foreground="#F2F4F8" FontSize="12" FontWeight="SemiBold"
                                       MinWidth="40" TextAlignment="Center" Margin="4,0"/>
                            <Button Style="{StaticResource HudBtn}" Click="DocZoomIn_Click"
                                    ToolTip="Zoom in" Content="+"/>
                        </StackPanel>
                    </Border>
                </Popup>

                <Border x:Name="PdfSpaceRail" Grid.Column="3" Visibility="Collapsed"
                        Background="#F3F3F3" BorderBrush="#D6D6D6"
                        BorderThickness="1,0,0,0" Padding="10,12,10,12">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="TOOLS" FontFamily="{StaticResource DisplayFont}"
                                       Foreground="#6E6E6E" FontSize="11"
                                       FontWeight="SemiBold" Margin="4,0,0,10"/>
                            <Button Style="{StaticResource DocRailButton}"
                                    Click="PdfFillAndSign_Click"
                                    ToolTip="Type in a cell and place a signature">
                                <DockPanel>
                                    <Border Width="22" Height="22" Background="#0B5CAB" CornerRadius="3"
                                            DockPanel.Dock="Left" Margin="0,0,10,0"/>
                                    <TextBlock Text="Fill &amp; Sign" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Button>
                            <Button Style="{StaticResource DocRailButton}"
                                    Click="PdfEditTextMode_Click"
                                    ToolTip="Native text — click a word to replace">
                                <DockPanel>
                                    <Border Width="22" Height="22" Background="#7A3E9D" CornerRadius="3"
                                            DockPanel.Dock="Left" Margin="0,0,10,0"/>
                                    <TextBlock Text="Edit PDF" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Button>
                            <Button Style="{StaticResource DocRailButton}"
                                    Click="PdfModeComment_Click"
                                    ToolTip="Highlight markup">
                                <DockPanel>
                                    <Border Width="22" Height="22" Background="#2E7D32" CornerRadius="3"
                                            DockPanel.Dock="Left" Margin="0,0,10,0"/>
                                    <TextBlock Text="Comment" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Button>
                            <Button Style="{StaticResource DocRailButton}"
                                    Click="PdfModeOrganize_Click"
                                    ToolTip="Reorder, extract, split, rotate, merge">
                                <DockPanel>
                                    <Border Width="22" Height="22" Background="#E65100" CornerRadius="3"
                                            DockPanel.Dock="Left" Margin="0,0,10,0"/>
                                    <TextBlock Text="Organize" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Button>
                            <Button Style="{StaticResource DocRailButton}"
                                    Click="PdfMerge_Click"
                                    ToolTip="Merge PDFs">
                                <DockPanel>
                                    <Border Width="22" Height="22" Background="#00838F" CornerRadius="3"
                                            DockPanel.Dock="Left" Margin="0,0,10,0"/>
                                    <TextBlock Text="Combine" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Button>
                            <Button Style="{StaticResource DocRailButton}"
                                    Click="PdfCreateBlank_Click"
                                    ToolTip="Create a blank Letter page next to this file">
                                <DockPanel>
                                    <Border Width="22" Height="22" Background="#546E7A" CornerRadius="3"
                                            DockPanel.Dock="Left" Margin="0,0,10,0"/>
                                    <TextBlock Text="Blank PDF" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Button>
                            <Button Style="{StaticResource DocRailButton}"
                                    Click="PdfExportAsMenu_Click">
                                <DockPanel>
                                    <Border Width="22" Height="22" Background="#1565C0" CornerRadius="3"
                                            DockPanel.Dock="Left" Margin="0,0,10,0"/>
                                    <TextBlock Text="Export" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Button>
                            <Button Style="{StaticResource DocRailButton}"
                                    Click="PdfProtect_Click">
                                <DockPanel>
                                    <Border Width="22" Height="22" Background="#C62828" CornerRadius="3"
                                            DockPanel.Dock="Left" Margin="0,0,10,0"/>
                                    <TextBlock Text="Protect" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <controls:ChatPanel x:Name="ChatPanel" Grid.Column="4" Visibility="Collapsed"/>
            </Grid>
        </Grid>
            </Grid>
        </Border>
    </Border>
</Window>
