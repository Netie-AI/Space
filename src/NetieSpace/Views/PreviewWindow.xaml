                                                <MenuItem x:Name="VideoPreset4KMenu" Header="Preset: 4K"
                                                          Click="ExportPresetButton_Click" Tag="Uhd4K"/>
                                                <Separator/>
                                                <MenuItem Header="LUT..." Click="LutButton_Click"
                                                          ToolTip="Apply .cube LUT on Export timeline"/>
                                            </ContextMenu>
