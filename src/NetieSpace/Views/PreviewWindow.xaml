                                        ToolTip="Select area for chat"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Grid x:Name="PeekActionStrip" DockPanel.Dock="Bottom" Visibility="Collapsed">
                        <Border Padding="22,6,22,10" Background="Transparent">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="AddChatClipButton" Content="Add to Chat" Style="{StaticResource GhostButton}"
