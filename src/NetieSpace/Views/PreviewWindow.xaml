<Window x:Class="NetieSpace.Views.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:controls="clr-namespace:NetieSpace.Controls"
        Title="NETIE SPACE Preview"
        Width="980" Height="680"
        MinWidth="640" MinHeight="420"
        ResizeMode="CanResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="True"
        Topmost="True"
        KeyDown="Window_KeyDown"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        SourceInitialized="Window_SourceInitialized"
        AllowDrop="True"
        PreviewDragOver="Window_PreviewDragOver"
        Drop="Window_Drop">

    <!-- Margin=0: acrylic HWND must match rounded shell (Margin left a sharp rectangle behind) -->
    <Border x:Name="RootBorder" Margin="0" Background="Transparent"
            SnapsToDevicePixels="True" UseLayoutRounding="True">
        <Border x:Name="GlassShell"
                CornerRadius="24"
                BorderThickness="1"
                BorderBrush="{StaticResource GlassBorder}"
                ClipToBounds="True"
                RenderOptions.BitmapScalingMode="HighQuality">

            <Border.Background>
                <!-- Light frost so acrylic blur reads through -->
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1" Opacity="0.58">
                    <GradientStop Color="#A8141820" Offset="0"/>
                    <GradientStop Color="#90101218" Offset="0.55"/>
                    <GradientStop Color="#88101828" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <Grid>
                <!-- Specular wash overlay -->
                <Border CornerRadius="24" IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,0.4">
                            <GradientStop Color="#22FFFFFF" Offset="0"/>
                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Glass title bar -->
            <Border Grid.Row="0" CornerRadius="24,24,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                    BorderBrush="{StaticResource GlassHighlight}" BorderThickness="0,0,0,1">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1" Opacity="0.5">
                        <GradientStop Color="#38FFFFFF" Offset="0"/>
                        <GradientStop Color="#08FFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>

                <Grid Margin="22,0,18,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="BrandDot" Width="10" Height="10" CornerRadius="5" Margin="0,0,12,0"
                                Background="{StaticResource AccentBrush}" Opacity="0.95"/>
                        <TextBlock x:Name="BrandModeText" Text="NETIE SPACE" FontFamily="{StaticResource DisplayFont}"
                                   Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="SemiBold"
                                   Margin="0,0,14,0"/>
                        <Border Width="1" Height="16" Background="#33FFFFFF" Margin="0,0,14,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="FileNameText" Text="Preview"
                                   FontFamily="{StaticResource BodyFont}"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="13" FontWeight="Medium"
                                   MaxWidth="340" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"
                                   Cursor="Hand"
                                   ToolTip="Click to rename"
                                   MouseLeftButtonUp="FileNameText_MouseLeftButtonUp"/>
                        <TextBox x:Name="FileNameEditBox" Visibility="Collapsed"
                                 FontFamily="{StaticResource BodyFont}"
                                 FontSize="13" FontWeight="Medium"
                                 MaxWidth="340" MinWidth="120" Height="26" Padding="6,2"
                                 VerticalContentAlignment="Center"
                                 Background="#33101820" Foreground="{StaticResource TextBrush}"
                                 BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
                                 CaretBrush="{StaticResource AccentBrush}"
                                 KeyDown="FileNameEditBox_KeyDown"
                                 LostKeyboardFocus="FileNameEditBox_LostFocus"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="EditModeButton" Content="Edit" Visibility="Collapsed"
                                Style="{StaticResource AccentButton}" Margin="0,0,10,0" Padding="16,8"
                                FontWeight="SemiBold" FontSize="13"
                                Click="EditModeButton_Click"
                                ToolTip="Morph into Netie PDF / Video editor"/>
                        <Button x:Name="TextEditButton" Content="Edit" Visibility="Collapsed"
                                Style="{StaticResource AccentButton}" Margin="0,0,10,0" Padding="16,8"
                                FontWeight="SemiBold" FontSize="13"
                                Click="TextEditButton_Click"
                                ToolTip="Edit text — autosaves as you type"/>
                        <Button x:Name="SummaryToggleButton" Content="Summary"
                                Style="{StaticResource GhostButton}" Margin="0,0,8,0" Padding="12,6"
                                Click="SummaryToggleButton_Click"
                                ToolTip="Show or hide AI summary (off skips AI calls)"/>
                        <Button x:Name="ProviderButton" Content="AI: —"
                                Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                                Click="ProviderButton_Click"
                                ToolTip="Switch AI provider instantly"/>
                        <Button x:Name="ContinueChatButton" Content="Chat"
                                Style="{StaticResource TealButton}" Margin="0,0,8,0"
                                Click="ContinueChatButton_Click"/>
                        <Button x:Name="RemoveBgButton" Content="Remove BG" Visibility="Collapsed"
                                Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                                Click="RemoveBgButton_Click"/>
                        <Button x:Name="ConvertMenuButton" Content="📄"
                                Style="{StaticResource GhostButton}" Margin="0,0,8,0" Padding="10,6"
                                Click="ConvertMenuButton_Click">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Convert to Markdown (.md)" Click="ConvertMdButton_Click"/>
                                    <MenuItem Header="Convert to PDF (.pdf)" Click="ConvertPdfButton_Click"/>
                                    <MenuItem Header="Edit as HTML (Word/Office)" Click="EditHtmlButton_Click"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <StackPanel x:Name="ZoomStrip" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,8,0">
                            <Button x:Name="ZoomOutButton" Content="−" Style="{StaticResource GhostButton}"
                                    Margin="0,0,4,0" Padding="10,4" Click="ZoomOutButton_Click"/>
                            <TextBlock x:Name="ZoomLabel" Text="100%" VerticalAlignment="Center"
                                       Foreground="{StaticResource MutedBrush}" FontSize="11.5" MinWidth="40" TextAlignment="Center"/>
                            <Button x:Name="ZoomInButton" Content="+" Style="{StaticResource GhostButton}"
                                    Margin="0,0,4,0" Padding="10,4" Click="ZoomInButton_Click"/>
                            <Button x:Name="ZoomFitButton" Content="Fit" Style="{StaticResource GhostButton}"
                                    Padding="10,4" Click="ZoomFitButton_Click"/>
                        </StackPanel>
                        <Button Content="✕" Style="{StaticResource IconCloseButton}" Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Preview summary OR native editor ribbon (Apple morph swap) -->
            <Border Grid.Row="1" BorderBrush="{StaticResource GlassHighlight}" BorderThickness="0,0,0,1"
                    Background="#16000000" AllowDrop="True"
                    DragOver="PdfChrome_DragOver" Drop="Window_Drop">
                <DockPanel>
                    <Border DockPanel.Dock="Bottom" Padding="22,6,22,10" Background="Transparent">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="LookupClipButton" Content="Look Up" Style="{StaticResource GhostButton}"
                                    Margin="0,0,8,0" Padding="10,4" Click="LookupClipButton_Click"/>
                            <Button x:Name="AddChatClipButton" Content="Add to Chat" Style="{StaticResource GhostButton}"
                                    Margin="0,0,8,0" Padding="10,4" Click="AddChatClipButton_Click"/>
                            <Button x:Name="OpenExternallyButton" Content="Open externally" Visibility="Collapsed"
                                    Style="{StaticResource GhostButton}" Margin="0,0,8,0" Padding="10,4"
                                    Click="OpenExternallyButton_Click"/>
                            <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                                       Foreground="{StaticResource Accent2Brush}" FontSize="11.5" FontWeight="Medium"/>
                            <TextBlock x:Name="ConvertStatusText" Margin="14,0,0,0" VerticalAlignment="Center"
                                       Foreground="#E8ECF4" FontSize="12.5" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" MaxWidth="480"/>
                        </StackPanel>
                    </Border>

                    <Grid>
                        <Border x:Name="PreviewSummaryHost" Padding="22,12,22,4" MaxHeight="96">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="72"
                                          Style="{StaticResource GlassScrollViewer}">
                                <TextBlock x:Name="SummaryText" Text="Generating summary..."
                                           FontFamily="{StaticResource BodyFont}"
                                           Foreground="{StaticResource TextBrush}"
                                           FontSize="13" LineHeight="19" TextWrapping="Wrap" Opacity="0.94"
                                           Cursor="Hand" MouseLeftButtonUp="SummaryText_MouseLeftButtonUp"/>
                            </ScrollViewer>
                        </Border>

                        <Border x:Name="PdfEditorRibbon" Visibility="Collapsed" Padding="18,12,18,4"
                                Background="#1A5EC4B8" BorderBrush="#335EC4B8" BorderThickness="0,0,0,0"
                                CornerRadius="0">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <TextBlock Text="All PDF tools" FontFamily="{StaticResource DisplayFont}"
                                               FontSize="12" FontWeight="SemiBold" Foreground="#D8FFF8"
                                               Opacity="0.9"/>
                                    <TextBlock DockPanel.Dock="Right" Text="Acrobat-class · drag to stamp"
                                               Foreground="#80A0A8B8" FontSize="11" VerticalAlignment="Center"/>
                                </DockPanel>
                                <WrapPanel Orientation="Horizontal">
                                    <Button Content="Merge" Style="{StaticResource EditorChip}" Click="PdfMerge_Click"/>
                                    <Button Content="Organize" Style="{StaticResource EditorChip}" Click="PdfOrganize_Click"/>
                                    <Button Content="Extract" Style="{StaticResource EditorChip}" Click="PdfExtract_Click"/>
                                    <Border Width="1" Height="22" Background="#33FFFFFF" Margin="4,0,12,0" VerticalAlignment="Center"/>
                                    <Button Content="Sign" Style="{StaticResource EditorChipPrimary}" Click="PdfSignType_Click"/>
                                    <Button Content="My signatures" Style="{StaticResource EditorChip}" Click="PdfSignLibrary_Click"
                                            ToolTip="Reuse, delete, or restyle saved signatures"/>
                                    <Button Content="Stamp image" Style="{StaticResource EditorChip}" Click="PdfSignStamp_Click"/>
                                    <Button x:Name="PdfSaveStampsButton" Content="Save" Style="{StaticResource EditorChipPrimary}"
                                            Click="PdfSaveStamps_Click" ToolTip="Save pending stamps / edits to a new PDF"/>
                                    <Button x:Name="PdfToolsButton" Content="Edit ▾" Style="{StaticResource EditorChip}"
                                            Click="PdfToolsButton_Click"
                                            ToolTip="Acrobat-style: Comment · Fill &amp; Sign · Edit text · Pages">
                                        <Button.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Comment — Highlight" Click="PdfCommentHighlight_Click"/>
                                                <MenuItem Header="Fill &amp; Sign — place signature" Click="PdfSignType_Click"/>
                                                <MenuItem Header="Edit text / OCR boxes…" Click="PdfEditTextMode_Click"
                                                          ToolTip="Show native text bounding boxes (OCR for scans next)"/>
                                                <MenuItem Header="Fill form fields…" Click="PdfFillForm_Click"/>
                                                <Separator/>
                                                <MenuItem Header="Organize pages…" Click="PdfOrganize_Click"/>
                                                <MenuItem Header="Split pages…" Click="PdfSplit_Click"/>
                                                <MenuItem Header="Rotate 90°…" Click="PdfRotate90_Click"/>
                                                <MenuItem Header="Reverse pages" Click="PdfReverse_Click"/>
                                                <Separator/>
                                                <MenuItem Header="Compress rewrite…" Click="PdfCompress_Click"/>
                                                <MenuItem Header="Save edits" Click="PdfSaveStamps_Click"/>
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border x:Name="VideoEditorRibbon" Visibility="Collapsed" Padding="18,12,18,4"
                                Background="#1A5EC4B8">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <TextBlock Text="All video tools" FontFamily="{StaticResource DisplayFont}"
                                               FontSize="12" FontWeight="SemiBold" Foreground="#D8FFF8"
                                               Opacity="0.9"/>
                                    <TextBlock DockPanel.Dock="Right" Text="Timeline · Split · Export"
                                               Foreground="#80A0A8B8" FontSize="11" VerticalAlignment="Center"/>
                                </DockPanel>
                                <WrapPanel Orientation="Horizontal">
                                    <Button x:Name="TrimVideoButton" Content="Export range (In→Out)" Style="{StaticResource EditorChip}"
                                            Click="TrimVideoButton_Click"
                                            ToolTip="CapCut: export only Mark In → Mark Out selection"/>
                                    <Button x:Name="ExportEditButton" Content="Export all (timeline)" Style="{StaticResource EditorChipPrimary}"
                                            Click="ExportEditButton_Click"
                                            ToolTip="CapCut: export full packed timeline (all clips)"/>
                                    <Button x:Name="AddVideoButton" Content="+ Clip" Style="{StaticResource EditorChip}"
                                            Click="AddVideoButton_Click"/>
                                    <Border Width="1" Height="22" Background="#33FFFFFF" Margin="4,0,12,0" VerticalAlignment="Center"/>
                                    <!-- Buttons instead of ComboBox — custom ComboBox template crashed PreviewWindow XAML load -->
                                    <Button x:Name="ExportMatchButton" Content="Match" Style="{StaticResource EditorChip}"
                                            Margin="0,0,4,0" Click="ExportPresetButton_Click" Tag="MatchSource"
                                            ToolTip="Export match source resolution"/>
                                    <Button x:Name="Export1080Button" Content="1080p" Style="{StaticResource EditorChip}"
                                            Margin="0,0,4,0" Click="ExportPresetButton_Click" Tag="Hd1080"
                                            ToolTip="Export 1080p"/>
                                    <Button x:Name="Export4KButton" Content="4K" Style="{StaticResource EditorChip}"
                                            Margin="0,0,8,0" Click="ExportPresetButton_Click" Tag="Uhd4K"
                                            ToolTip="Export 4K UHD"/>
                                    <Button x:Name="LutButton" Content="LUT…" Style="{StaticResource EditorChip}"
                                            Click="LutButton_Click"
                                            ToolTip="Apply .cube LUT on Export timeline"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- Body — opaque content well (hero), chrome yields -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition x:Name="ChatColumn" Width="0"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource ContentWellBrush}"
                        CornerRadius="0,0,22,22" ClipToBounds="True" Margin="1,0,1,1">
                <Grid ClipToBounds="True" x:Name="ContentHost">
                    <Border CornerRadius="0,0,21,21" ClipToBounds="True">
                    <Grid>
                    <ScrollViewer x:Name="ImageScroll" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                  PanningMode="Both"
                                  Style="{StaticResource GlassScrollViewer}"
                                  PreviewMouseWheel="ImageScroll_PreviewMouseWheel"
                                  SizeChanged="ImageScroll_SizeChanged"
                                  IsManipulationEnabled="True"
                                  ManipulationDelta="ImageScroll_ManipulationDelta"
                                  ManipulationInertiaStarting="ImageScroll_ManipulationInertiaStarting">
                        <Grid x:Name="ImageCanvas" Background="Transparent">
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16">
                                <Rectangle x:Name="ImageAlphaBoard" RadiusX="8" RadiusY="8"
                                           Visibility="Collapsed"
                                           Width="{Binding ActualWidth, ElementName=PreviewImage}"
                                           Height="{Binding ActualHeight, ElementName=PreviewImage}">
                                    <Rectangle.Fill>
                                        <DrawingBrush TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute">
                                            <DrawingBrush.Drawing>
                                                <DrawingGroup>
                                                    <GeometryDrawing Brush="#FF2A3140">
                                                        <GeometryDrawing.Geometry>
                                                            <RectangleGeometry Rect="0,0,16,16"/>
                                                        </GeometryDrawing.Geometry>
                                                    </GeometryDrawing>
                                                    <GeometryDrawing Brush="#FF3A4252">
                                                        <GeometryDrawing.Geometry>
                                                            <GeometryGroup>
                                                                <RectangleGeometry Rect="0,0,8,8"/>
                                                                <RectangleGeometry Rect="8,8,8,8"/>
                                                            </GeometryGroup>
                                                        </GeometryDrawing.Geometry>
                                                    </GeometryDrawing>
                                                </DrawingGroup>
                                            </DrawingBrush.Drawing>
                                        </DrawingBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                                <Image x:Name="PreviewImage" Stretch="Uniform"
                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Image.LayoutTransform>
                                        <ScaleTransform x:Name="ImageScale" ScaleX="1" ScaleY="1"/>
                                    </Image.LayoutTransform>
                                </Image>
                            </Grid>
                        </Grid>
                    </ScrollViewer>

                    <wv2:WebView2 x:Name="PreviewWebView"
                                  Visibility="Visible"
                                  SizeChanged="PreviewWebView_SizeChanged"/>

                    <!-- Captures image drops over WebView2 HWND when a PDF is open -->
                    <Border x:Name="PdfDropOverlay" Visibility="Collapsed" Background="#66000000"
                            AllowDrop="True" Panel.ZIndex="30"
                            DragOver="PdfDropOverlay_DragOver"
                            DragLeave="PdfDropOverlay_DragLeave"
                            Drop="Window_Drop">
                        <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                                Padding="28,18" CornerRadius="16"
                                Background="#40000000" BorderBrush="#665EC4B8" BorderThickness="1">
                            <TextBlock Text="Drop Word / image / PDF to append pages"
                                       FontFamily="{StaticResource DisplayFont}"
                                       Foreground="{StaticResource TextBrush}"
                                       FontSize="15" FontWeight="SemiBold"/>
                        </Border>
                    </Border>

                    <!-- Soft corner masks so HWND WebView2 doesn't read as a sharp rectangle -->
                    <Canvas x:Name="CornerMaskLayer" IsHitTestVisible="False" Panel.ZIndex="20">
                        <Path x:Name="CornerTL" Fill="{StaticResource ContentWellBrush}"/>
                        <Path x:Name="CornerTR" Fill="{StaticResource ContentWellBrush}"/>
                        <Path x:Name="CornerBL" Fill="{StaticResource ContentWellBrush}"/>
                        <Path x:Name="CornerBR" Fill="{StaticResource ContentWellBrush}"/>
                    </Canvas>

                    <!-- Video: light autoplay preview; Edit expands full Netie editor -->
                    <Grid x:Name="VideoPanel" Visibility="Collapsed" Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <MediaElement x:Name="PreviewVideo"
                                      Grid.Row="0"
                                      LoadedBehavior="Manual"
                                      UnloadedBehavior="Stop"
                                      ScrubbingEnabled="True"
                                      Stretch="Uniform"
                                      MediaOpened="PreviewVideo_MediaOpened"
                                      MediaEnded="PreviewVideo_MediaEnded"/>
                        <Border Grid.Row="1" Margin="0,12,0,0" Padding="14,12" CornerRadius="16"
                                Background="#1AFFFFFF" BorderBrush="#40FFFFFF" BorderThickness="1">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="PlayPauseButton" Content="Pause" Style="{StaticResource AccentButton}"
                                            Click="PlayPauseButton_Click" Width="78" Padding="12,8"/>
                                    <Grid Grid.Column="1" Margin="14,0" VerticalAlignment="Center"
                                          SizeChanged="VideoSliderHost_SizeChanged">
                                        <Border Height="5" VerticalAlignment="Center" CornerRadius="2.5"
                                                Background="#28FFFFFF" Margin="6,0" IsHitTestVisible="False"/>
                                        <Border x:Name="MarkRangeTint" Height="5" VerticalAlignment="Center"
                                                CornerRadius="2.5" Background="#665EC4B8"
                                                HorizontalAlignment="Left" Width="0" Margin="6,0,0,0"
                                                Visibility="Collapsed" IsHitTestVisible="False"/>
                                        <Slider x:Name="VideoSlider"
                                                VerticalAlignment="Center"
                                                Minimum="0" Maximum="1"
                                                IsMoveToPointEnabled="True"
                                                Background="Transparent"
                                                PreviewMouseLeftButtonDown="VideoSlider_PreviewMouseDown"
                                                PreviewMouseLeftButtonUp="VideoSlider_PreviewMouseUp"
                                                LostMouseCapture="VideoSlider_LostMouseCapture"
                                                ValueChanged="VideoSlider_ValueChanged"/>
                                    </Grid>
                                    <TextBlock x:Name="VideoTimeText" Grid.Column="2"
                                               VerticalAlignment="Center" MinWidth="110"
                                               Foreground="{StaticResource MutedBrush}" FontSize="12"
                                               Text="00:00 / 00:00"/>
                                </Grid>

                                <TextBlock x:Name="VideoLightHint" Margin="0,10,0,0"
                                           Text="Light preview — press Edit for the full Netie video editor (timeline, split, export)."
                                           Foreground="{StaticResource MutedBrush}" FontSize="12.5"
                                           TextWrapping="Wrap"/>

                                <!-- Full editor chrome (hidden until Edit) -->
                                <StackPanel x:Name="VideoEditorChrome" Visibility="Collapsed" Margin="0,10,0,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                    <Button Content="Mark In" Style="{StaticResource EditorChip}"
                                            Click="MarkInButton_Click" ToolTip="Set Mark In at playhead"/>
                                    <Button Content="Mark Out" Style="{StaticResource EditorChip}"
                                            Click="MarkOutButton_Click" ToolTip="Set Mark Out at playhead"/>
                                    <TextBlock x:Name="MarkRangeText" VerticalAlignment="Center"
                                               Foreground="{StaticResource Accent2Brush}" FontSize="12"
                                               Text="In — · Out —"/>
                                </StackPanel>

                                <!-- Multi-track timeline (V1 / A1 / A2) -->
                                <Border Margin="0,12,0,0" Padding="12,10" CornerRadius="12"
                                        Background="#14FFFFFF" BorderBrush="#28FFFFFF" BorderThickness="1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <WrapPanel>
                                            <Button x:Name="SplitButton" Content="✂ Split" Margin="0,0,8,6"
                                                    Style="{StaticResource EditorChipPrimary}"
                                                    Click="SplitAtPlayhead_Click"
                                                    ToolTip="Cut at playhead into two clips"/>
                                            <Button x:Name="CutMiddleButton" Content="Delete" Margin="0,0,8,6"
                                                    Style="{StaticResource EditorChipPrimary}"
                                                    IsEnabled="False" Click="CutMiddleButton_Click"
                                                    ToolTip="Select a clip first — remove it (merge or black gap)"/>
                                            <Button x:Name="BladeModeButton" Content="Select" Margin="0,0,8,6"
                                                    Style="{StaticResource EditorChip}"
                                                    Click="BladeModeButton_Click"
                                                    ToolTip="Click a clip to select, then Delete or drag to reorder"/>
                                            <Button Content="Fade In" Style="{StaticResource EditorChip}" Margin="0,0,8,6"
                                                    Click="FadeInButton_Click" ToolTip="0.5s fade in on selected clip"/>
                                            <Button Content="Fade Out" Style="{StaticResource EditorChip}" Margin="0,0,8,6"
                                                    Click="FadeOutButton_Click" ToolTip="0.5s fade out on selected clip"/>
                                            <Button Content="Captions" Style="{StaticResource EditorChip}" Margin="0,0,8,6"
                                                    Click="AutoCaptionsButton_Click"
                                                    ToolTip="Local AI subtitles (whisper.cpp) — ZH+EN auto"/>
                                            <TextBlock x:Name="TimelineHintText"
                                                       Text="Move playhead → Split → select clip → Delete"
                                                       FontFamily="{StaticResource BodyFont}"
                                                       Foreground="#E8FFFFFF"
                                                       FontSize="12" FontWeight="SemiBold"
                                                       VerticalAlignment="Center" Margin="0,0,0,6"
                                                       TextWrapping="Wrap"/>
                                        </WrapPanel>

                                        <!-- V1 -->
                                        <DockPanel Grid.Row="1" Margin="0,10,0,0" LastChildFill="True">
                                            <TextBlock Text="V1" Width="28" VerticalAlignment="Center"
                                                       Foreground="{StaticResource Accent2Brush}" FontSize="12" FontWeight="Bold"/>
                                            <Grid x:Name="TimelineTrackHost" Height="48"
                                                  Background="#18000000"
                                                  SizeChanged="TimelineTrackHost_SizeChanged"
                                                  PreviewMouseLeftButtonDown="TimelineTrack_PreviewMouseLeftButtonDown"
                                                  PreviewMouseMove="TimelineTrack_PreviewMouseMove"
                                                  PreviewMouseLeftButtonUp="TimelineTrack_PreviewMouseLeftButtonUp"
                                                  LostMouseCapture="TimelineTrack_LostMouseCapture"
                                                  PreviewMouseRightButtonUp="TimelineTrack_PreviewMouseRightButtonUp">
                                                <Border Height="36" VerticalAlignment="Center" CornerRadius="8"
                                                        Background="#2AFFFFFF" IsHitTestVisible="False"/>
                                                <Canvas x:Name="TimelineClipCanvas" Height="36" VerticalAlignment="Center"
                                                        IsHitTestVisible="True"/>
                                                <Border x:Name="TimelineKeepRange" Height="36" VerticalAlignment="Center"
                                                        CornerRadius="6" Background="Transparent"
                                                        HorizontalAlignment="Left" Width="0"
                                                        IsHitTestVisible="False" Visibility="Collapsed"/>
                                                <Border x:Name="TimelineDimLeft" Height="36" VerticalAlignment="Center"
                                                        CornerRadius="8,0,0,8" Background="#66000000"
                                                        HorizontalAlignment="Left" Width="0"
                                                        IsHitTestVisible="False"/>
                                                <Border x:Name="TimelineDimRight" Height="36" VerticalAlignment="Center"
                                                        CornerRadius="0,8,8,0" Background="#66000000"
                                                        HorizontalAlignment="Left" Width="0"
                                                        IsHitTestVisible="False"/>
                                                <Border x:Name="TimelinePlayhead" Width="3" Height="48"
                                                        VerticalAlignment="Center" Background="#FF5EC4B8"
                                                        HorizontalAlignment="Left" Margin="0"
                                                        IsHitTestVisible="False"/>
                                                <Border x:Name="TimelineInHandle" Width="12" Height="40"
                                                        VerticalAlignment="Center" CornerRadius="3"
                                                        Background="#5EC4B8" Cursor="SizeWE"
                                                        HorizontalAlignment="Left"
                                                        BorderBrush="#FFFFFF" BorderThickness="1"
                                                        ToolTip="Drag Mark In"/>
                                                <Border x:Name="TimelineOutHandle" Width="12" Height="40"
                                                        VerticalAlignment="Center" CornerRadius="3"
                                                        Background="#5EC4B8" Cursor="SizeWE"
                                                        HorizontalAlignment="Left"
                                                        BorderBrush="#FFFFFF" BorderThickness="1"
                                                        ToolTip="Drag Mark Out"/>
                                            </Grid>
                                        </DockPanel>

                                        <!-- A1 -->
                                        <DockPanel Grid.Row="2" Margin="0,4,0,0" LastChildFill="True">
                                            <TextBlock Text="A1" Width="28" VerticalAlignment="Center"
                                                       Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                                            <Grid x:Name="AudioTrack1Host" Height="22" Background="#12FFFFFF"
                                                  PreviewMouseLeftButtonDown="AudioTrack_PreviewMouseLeftButtonDown"
                                                  Tag="A1">
                                                <Canvas x:Name="AudioTrack1Canvas" Height="18" VerticalAlignment="Center"/>
                                            </Grid>
                                        </DockPanel>

                                        <!-- A2 (music / mute lane) -->
                                        <DockPanel Grid.Row="3" Margin="0,4,0,0" LastChildFill="True">
                                            <TextBlock Text="A2" Width="28" VerticalAlignment="Center"
                                                       Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                                            <Grid x:Name="AudioTrack2Host" Height="22" Background="#12FFFFFF"
                                                  AllowDrop="True"
                                                  PreviewMouseLeftButtonDown="AudioTrack_PreviewMouseLeftButtonDown"
                                                  Tag="A2"
                                                  ToolTip="Drop or move clips here for music / mute lane">
                                                <Canvas x:Name="AudioTrack2Canvas" Height="18" VerticalAlignment="Center"/>
                                            </Grid>
                                        </DockPanel>

                                        <!-- CC captions track -->
                                        <DockPanel Grid.Row="4" Margin="0,6,0,0" LastChildFill="True">
                                            <TextBlock Text="CC" Width="28" VerticalAlignment="Center"
                                                       Foreground="{StaticResource Accent2Brush}" FontSize="11" FontWeight="Bold"/>
                                            <Grid x:Name="CaptionTrackHost" Height="28" Background="#12FFFFFF"
                                                  ToolTip="Caption cues — drag to shift timing">
                                                <Canvas x:Name="CaptionTrackCanvas" Height="24" VerticalAlignment="Center"/>
                                            </Grid>
                                        </DockPanel>
                                    </Grid>
                                </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border x:Name="LoadingOverlay" Visibility="Collapsed">
                        <Border.Background>
                            <SolidColorBrush Color="#10141C" Opacity="0.72"/>
                        </Border.Background>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Border Padding="28,20" CornerRadius="16" BorderBrush="#38FFFFFF" BorderThickness="1"
                                    Background="#28FFFFFF">
                                <StackPanel>
                                    <TextBlock Text="Loading…"
                                               FontFamily="{StaticResource DisplayFont}"
                                               Foreground="{StaticResource TextBrush}"
                                               FontSize="17" FontWeight="SemiBold"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="LoadingText" Text=""
                                               FontFamily="{StaticResource BodyFont}"
                                               Foreground="{StaticResource MutedBrush}"
                                               FontSize="12" Margin="0,8,0,0"
                                               HorizontalAlignment="Center"/>
                                    <ProgressBar x:Name="LoadingProgress" Height="4" Margin="0,14,0,0"
                                                   Minimum="0" Maximum="100" Value="0"
                                                   Visibility="Collapsed"
                                                   Foreground="{StaticResource Accent2Brush}"
                                                   Background="#28FFFFFF"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                    </Grid>
                    </Border>
                </Grid>
                </Border>

                <controls:ChatPanel x:Name="ChatPanel" Grid.Column="1" Visibility="Collapsed"/>
            </Grid>
        </Grid>
            </Grid>
        </Border>
    </Border>
</Window>
