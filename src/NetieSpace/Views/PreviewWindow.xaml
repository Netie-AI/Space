            <!-- Body — opaque content well (hero), chrome yields -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SummaryRailColumn" Width="0"/>
                    <ColumnDefinition x:Name="DocLeftNavColumn" Width="0"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition x:Name="PdfSpaceRailColumn" Width="0"/>
                    <ColumnDefinition x:Name="ChatColumn" Width="0"/>
                </Grid.ColumnDefinitions>

                <!-- Summary docked left: same text, out of the way of the page -->
