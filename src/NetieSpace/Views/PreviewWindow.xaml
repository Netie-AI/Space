                        <Border x:Name="VideoEditorRibbon" Visibility="Collapsed" Padding="18,12,18,4"
                                Background="#1A5EC4B8">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <TextBlock Text="Video tools" FontFamily="{StaticResource DisplayFont}"
                                               FontSize="12" FontWeight="SemiBold" Foreground="#D8FFF8"
                                               Opacity="0.9"/>
                                    <TextBlock x:Name="VideoRibbonHint" DockPanel.Dock="Right" Text="Export · + Clip · Order · More"
                                               Foreground="#80A0A8B8" FontSize="11" VerticalAlignment="Center"/>
                                </DockPanel>
                                <WrapPanel x:Name="VideoPrimaryRow" Orientation="Horizontal">
                                    <Button x:Name="ExportEditButton" Content="Export all" Style="{StaticResource EditorChipPrimary}"
