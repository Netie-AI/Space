                                                <MenuItem Header="Export as…" Click="PdfExportAsMenu_Click"
                                                          ToolTip="Pick another format via the Share export picker"/>
                                                <Separator/>
                                                <MenuItem Header="Watermark…" Click="PdfWatermark_Click"
                                                          ToolTip="Stamp text across pages (pymupdf)"/>
                                                <MenuItem Header="Protect…" Click="PdfProtect_Click"
                                                          ToolTip="AES-256 password lock"/>
                                                <MenuItem Header="Unlock…" Click="PdfUnlock_Click"
                                                          ToolTip="Remove password (needs the password)"/>
                                                <MenuItem Header="Scan &amp; OCR…" Click="PdfOcr_Click"
                                                          ToolTip="Make a scanned PDF searchable (needs Tesseract)"/>
                                                <MenuItem Header="Cert sign (PFX)..." Click="PdfCertSign_Click"
                                                          ToolTip="Embed a PKCS#7 detached signature. Visual Sign stamp stays available."/>
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                    <Button x:Name="PdfLightSaveBtn" Content="Save" Style="{StaticResource DocChipPrimary}"
                                            Click="PdfSaveStamps_Click"
                                            ToolTip="Write signatures, typed text, and highlights into this PDF"/>
                                </WrapPanel>

                                <!-- Organize secondary -->
                                <Border x:Name="PdfOrganizePanel" Visibility="Collapsed" Margin="0,4,0,0"
