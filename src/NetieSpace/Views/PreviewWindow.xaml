<Window x:Class="NetieSpace.Views.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:controls="clr-namespace:NetieSpace.Controls"
        Title="NETIE SPACE Preview"
        Width="980" Height="680"
        MinWidth="640" MinHeight="420"
        ResizeMode="CanResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="True"
        Topmost="True"
        KeyDown="Window_KeyDown"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        SourceInitialized="Window_SourceInitialized"
        AllowDrop="True"
        PreviewDragOver="Window_PreviewDragOver"
        Drop="Window_Drop">

    <!-- Margin=0: acrylic HWND must match rounded shell (Margin left a sharp rectangle behind) -->
    <Border x:Name="RootBorder" Margin="0" Background="Transparent"
            SnapsToDevicePixels="True" UseLayoutRounding="True">
        <Border x:Name="GlassShell"
                CornerRadius="24"
                BorderThickness="1"
                BorderBrush="{StaticResource GlassBorder}"
                ClipToBounds="True"
                RenderOptions.BitmapScalingMode="HighQuality">

            <Border.Background>
                <!-- Light frost so acrylic blur reads through -->
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1" Opacity="0.58">
                    <GradientStop Color="#A8141820" Offset="0"/>
                    <GradientStop Color="#90101218" Offset="0.55"/>
                    <GradientStop Color="#88101828" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <Grid>
                <!-- Specular wash overlay -->
                <Border CornerRadius="24" IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,0.4">
                            <GradientStop Color="#22FFFFFF" Offset="0"/>
                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Glass title bar -->
            <Border Grid.Row="0" CornerRadius="24,24,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                    BorderBrush="{StaticResource GlassHighlight}" BorderThickness="0,0,0,1">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1" Opacity="0.5">
                        <GradientStop Color="#38FFFFFF" Offset="0"/>
                        <GradientStop Color="#08FFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>

                <!-- Two columns: brand+name flexes and TRIMS, buttons keep their space.
                     A long file name can never run under the buttons anymore. -->
                <Grid Margin="22,0,18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0" VerticalAlignment="Center" LastChildFill="True" Margin="0,0,16,0">
                        <Border x:Name="BrandDot" DockPanel.Dock="Left" Width="10" Height="10" CornerRadius="5"
                                Margin="0,0,12,0" VerticalAlignment="Center"
                                Background="{StaticResource AccentBrush}" Opacity="0.95"/>
                        <TextBlock x:Name="BrandModeText" DockPanel.Dock="Left" Text="NETIE SPACE"
                                   FontFamily="{StaticResource DisplayFont}"
                                   Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <Border DockPanel.Dock="Left" Width="1" Height="16" Background="#33FFFFFF"
                                Margin="0,0,14,0" VerticalAlignment="Center"/>
                        <TextBox x:Name="FileNameEditBox" DockPanel.Dock="Left" Visibility="Collapsed"
                                 FontFamily="{StaticResource BodyFont}"
                                 FontSize="13" FontWeight="Medium"
                                 MaxWidth="420" MinWidth="120" Height="26" Padding="6,2"
                                 VerticalContentAlignment="Center" VerticalAlignment="Center"
                                 HorizontalAlignment="Left"
                                 Background="#33101820" Foreground="{StaticResource TextBrush}"
                                 BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
                                 CaretBrush="{StaticResource AccentBrush}"
                                 KeyDown="FileNameEditBox_KeyDown"
                                 LostKeyboardFocus="FileNameEditBox_LostFocus"/>
                        <!-- Fill child: takes the leftover width and ellipsises. Full name shows only on rename. -->
                        <TextBlock x:Name="FileNameText" Text="Preview"
                                   FontFamily="{StaticResource BodyFont}"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="13" FontWeight="Medium"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Left"
                                   Cursor="Hand"
                                   ToolTip="Click to rename"
                                   MouseLeftButtonUp="FileNameText_MouseLeftButtonUp"/>
                    </DockPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="EditModeButton" Content="Edit" Visibility="Collapsed"
                                Style="{StaticResource AccentButton}" Margin="0,0,10,0" Padding="16,8"
                                FontWeight="SemiBold" FontSize="13"
                                Click="EditModeButton_Click"
                                ToolTip="Morph into Netie PDF / Video editor"/>
                        <Button x:Name="TextEditButton" Content="Edit" Visibility="Collapsed"
                                Style="{StaticResource AccentButton}" Margin="0,0,10,0" Padding="16,8"
                                FontWeight="SemiBold" FontSize="13"
                                Click="TextEditButton_Click"
                                ToolTip="Edit text — autosaves as you type"/>
                        <Button x:Name="SummaryToggleButton" Content="Summary"
                                Style="{StaticResource GhostButton}" Margin="0,0,8,0" Padding="12,6"
                                Click="SummaryToggleButton_Click"
                                ToolTip="Show or hide AI summary (off skips AI calls)"/>
                        <Button x:Name="ProviderButton" Content="AI: —"
                                Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                                Click="ProviderButton_Click"
                                ToolTip="Switch AI provider instantly"/>
                        <Button x:Name="ContinueChatButton" Content="Chat"
                                Style="{StaticResource TealButton}" Margin="0,0,8,0"
                                Click="ContinueChatButton_Click"
                                ToolTip="Side panel notes &amp; chat — saved on this file"/>
                        <Button x:Name="RemoveBgButton" Content="Remove BG" Visibility="Collapsed"
                                Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                                Click="RemoveBgButton_Click"/>
                        <Button x:Name="OcrImageButton" Content="OCR" Visibility="Collapsed"
                                Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                                Click="OcrImageButton_Click"
                                ToolTip="Read text from this image (local OCR; cloud stays opt-in)"/>
                        <Button x:Name="CopyImageButton" Content="Copy" Visibility="Collapsed"
                                Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                                Click="CopyImageButton_Click"
                                ToolTip="Copy this image (bitmap + file). Drag the picture out to drop it into a folder or chat."/>
                        <Button x:Name="CompressImageButton" Content="Compress" Visibility="Collapsed"
                                Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                                Click="CompressImageButton_Click"
                                ToolTip="Lower JPEG file size (quality picker)"/>
                        <Button x:Name="SendToComfyButton" Content="Send to Comfy..." Visibility="Collapsed"
                                Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                                Click="SendToComfyButton_Click"
                                ToolTip="Queue this image in local ComfyUI (127.0.0.1:8188). rembg / Copy still work if Comfy is down."/>
                        <!-- Share replaces the old text "convert" entry: icon only, sheet does the rest -->
                        <Button x:Name="ShareButton"
                                Style="{StaticResource IconGhostButton}" Margin="0,0,8,0"
                                Click="ShareButton_Click"
                                ToolTip="Share — the whole file, a converted copy, or just what you selected">
                            <Path Stroke="{StaticResource TextBrush}" StrokeThickness="1.7"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Stretch="Uniform" Width="16" Height="16"
                                  Data="M 12,3.4 L 12,14.6 M 8.2,7.2 L 12,3.4 L 15.8,7.2 M 7.6,10 L 5.6,10 C 4.7,10 4,10.7 4,11.6 L 4,19 C 4,19.9 4.7,20.6 5.6,20.6 L 18.4,20.6 C 19.3,20.6 20,19.9 20,19 L 20,11.6 C 20,10.7 19.3,10 18.4,10 L 16.4,10"/>
                        </Button>
                        <Button x:Name="SetupHelpButton" Content="&#xE713;"
                                Style="{StaticResource IconGhostButton}" Margin="0,0,8,0"
                                Click="SetupHelpButton_Click"
                                ToolTip="Settings — Netie plan · BYO keys · vault · FreeRoute tips"/>
                        <StackPanel x:Name="ZoomStrip" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,8,0">
                            <Button x:Name="ZoomOutButton" Content="−" Style="{StaticResource GhostButton}"
                                    Margin="0,0,4,0" Padding="10,4" Click="ZoomOutButton_Click"/>
                            <TextBlock x:Name="ZoomLabel" Text="100%" VerticalAlignment="Center"
                                       Foreground="{StaticResource MutedBrush}" FontSize="11.5" MinWidth="40" TextAlignment="Center"/>
                            <Button x:Name="ZoomInButton" Content="+" Style="{StaticResource GhostButton}"
                                    Margin="0,0,4,0" Padding="10,4" Click="ZoomInButton_Click"/>
                            <Button x:Name="ZoomFitButton" Content="Fit" Style="{StaticResource GhostButton}"
                                    Padding="10,4" Click="ZoomFitButton_Click"/>
                        </StackPanel>
                        <Button Content="✕" Style="{StaticResource IconCloseButton}" Click="CloseButton_Click"/>
                    </StackPanel>

                    <!-- Share sheet. Popups get their own HWND, so this draws cleanly over WebView2. -->
                    <Popup x:Name="SharePopup" PlacementTarget="{Binding ElementName=ShareButton}"
                           Placement="Bottom" HorizontalOffset="-268" VerticalOffset="10"
                           StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
                           Focusable="False">
                        <Border Width="326" CornerRadius="18" Padding="10"
                                Background="#F21A1E28" BorderBrush="#3AFFFFFF" BorderThickness="1"
                                Margin="12">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="26" ShadowDepth="6" Direction="270"
                                                  Color="#000000" Opacity="0.5"/>
                            </Border.Effect>
                            <StackPanel>
                                <DockPanel Margin="8,4,4,10">
                                    <Button DockPanel.Dock="Right" Content="✕" Width="24" Height="24"
                                            Style="{StaticResource MicroIconButton}"
                                            Click="ShareClose_Click" ToolTip="Close"/>
                                    <StackPanel>
                                        <TextBlock Text="Share" FontFamily="{StaticResource DisplayFont}"
                                                   Foreground="{StaticResource TextBrush}"
                                                   FontSize="15" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="ShareSubjectText" Text="Preview"
                                                   FontFamily="{StaticResource BodyFont}"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   FontSize="11" Margin="0,2,0,0"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="240"
                                                   HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </DockPanel>

                                <Button Style="{StaticResource ShareRowButton}" x:Name="ShareSelectionRow"
                                        Click="ShareCopySelection_Click">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Left" Style="{StaticResource ShareRowGlyph}">
                                            <TextBlock Text="❝" FontSize="13" Foreground="#D8FFF8"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Copy selection" Foreground="{StaticResource TextBrush}" FontSize="13"/>
                                            <TextBlock x:Name="ShareSelectionHint" Text="Whatever you highlighted in the preview"
                                                       Foreground="{StaticResource MutedBrush}" FontSize="10.5"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Button>

                                <Button Style="{StaticResource ShareRowButton}" Click="ShareCopyFile_Click">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Left" Style="{StaticResource ShareRowGlyph}">
                                            <TextBlock Text="⧉" FontSize="14" Foreground="#D8FFF8"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Copy file" Foreground="{StaticResource TextBrush}" FontSize="13"/>
                                            <TextBlock Text="Paste straight into Mail, Teams or a folder"
                                                       Foreground="{StaticResource MutedBrush}" FontSize="10.5"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Button>

                                <Border Height="1" Background="#1FFFFFFF" Margin="10,7"/>

                                <Button Style="{StaticResource ShareRowButton}" Click="ShareMailButton_Click">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Left" Style="{StaticResource ShareRowGlyph}">
                                            <TextBlock Text="✉" FontSize="14" Foreground="#D8FFF8"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Email a copy" Foreground="{StaticResource TextBrush}" FontSize="13"/>
                                            <TextBlock Text="Opens your mail app with the text prefilled"
                                                       Foreground="{StaticResource MutedBrush}" FontSize="10.5"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Button>

                                <Button Style="{StaticResource ShareRowButton}" Click="ShareOpenWithButton_Click">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Left" Style="{StaticResource ShareRowGlyph}">
                                            <TextBlock Text="↗" FontSize="14" Foreground="#D8FFF8"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Open with…" Foreground="{StaticResource TextBrush}" FontSize="13"/>
                                            <TextBlock Text="Hand off to any app Windows offers"
                                                       Foreground="{StaticResource MutedBrush}" FontSize="10.5"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Button>

                                <Button Style="{StaticResource ShareRowButton}" Click="ShareRevealButton_Click">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Left" Style="{StaticResource ShareRowGlyph}">
                                            <TextBlock Text="🗀" FontSize="13" Foreground="#D8FFF8"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Show in folder" Foreground="{StaticResource TextBrush}" FontSize="13"/>
                                            <TextBlock Text="Reveal in File Explorer"
                                                       Foreground="{StaticResource MutedBrush}" FontSize="10.5"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Button>

                                <Border Height="1" Background="#1FFFFFFF" Margin="10,7"/>

                                <TextBlock x:Name="ShareFormatsLabel" Text="Send as a different format"
                                           Foreground="{StaticResource MutedBrush}" FontSize="10.5"
                                           FontWeight="SemiBold" Margin="12,0,0,4"/>

                                <Button x:Name="ShareMdRow" Style="{StaticResource ShareRowButton}" Click="ConvertMdButton_Click">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Left" Style="{StaticResource ShareRowGlyph}">
                                            <TextBlock Text="M↓" FontSize="11" FontWeight="Bold" Foreground="#D8FFF8"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Markdown (.md)" VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextBrush}" FontSize="13"/>
                                    </DockPanel>
                                </Button>

                                <Button x:Name="SharePdfRow" Style="{StaticResource ShareRowButton}" Click="ConvertPdfButton_Click">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Left" Style="{StaticResource ShareRowGlyph}">
                                            <TextBlock Text="PDF" FontSize="9" FontWeight="Bold" Foreground="#D8FFF8"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="PDF (.pdf)" VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextBrush}" FontSize="13"/>
                                    </DockPanel>
                                </Button>

                                <Button x:Name="ShareHtmlRow" Style="{StaticResource ShareRowButton}" Click="EditHtmlButton_Click">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Left" Style="{StaticResource ShareRowGlyph}">
                                            <TextBlock Text="&lt;/&gt;" FontSize="10" FontWeight="Bold" Foreground="#D8FFF8"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Edit Word / HTML (autosave)" VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextBrush}" FontSize="13"/>
                                    </DockPanel>
                                </Button>

                                <Border Height="1" Background="#1FFFFFFF" Margin="10,7"/>

                                <TextBlock x:Name="ShareExportAsLabel" Text="Export as…"
                                           Foreground="{StaticResource MutedBrush}" FontSize="10.5"
                                           FontWeight="SemiBold" Margin="12,0,0,4"/>

                                <Button x:Name="ShareExportAsRow" Style="{StaticResource ShareRowButton}" Click="ShareExportAs_Click">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Left" Style="{StaticResource ShareRowGlyph}">
                                            <TextBlock Text="⇩" FontSize="14" FontWeight="Bold" Foreground="#D8FFF8"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Pick format &amp; save…" Foreground="{StaticResource TextBrush}" FontSize="13"/>
                                            <TextBlock x:Name="ShareExportAsHint" Text="PDF, Word, Excel, HTML…"
                                                       Foreground="{StaticResource MutedBrush}" FontSize="10.5"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
            </Border>

            <!-- Preview summary OR native editor ribbon (Apple morph swap) -->
            <Border Grid.Row="1" BorderBrush="{StaticResource GlassHighlight}" BorderThickness="0,0,0,1"
                    Background="#16000000" AllowDrop="True"
                    DragOver="PdfChrome_DragOver" Drop="Window_Drop">
                <DockPanel>
                    <!-- Action strip stays put when the summary collapses; the float handle rides on it -->
                    <Grid DockPanel.Dock="Bottom">
                        <Border Padding="22,6,22,10" Background="Transparent">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="LookupClipButton" Content="Look Up" Style="{StaticResource GhostButton}"
                                        Margin="0,0,8,0" Padding="10,4" Click="LookupClipButton_Click"/>
                                <Button x:Name="AddChatClipButton" Content="Add to Chat" Style="{StaticResource GhostButton}"
                                        Margin="0,0,8,0" Padding="10,4" Click="AddChatClipButton_Click"
                                        ToolTip="Stage this file (parsed) as an attachment — nothing sends until you press Send"/>
                                <Button x:Name="SendSlideChatButton" Content="Send slide" Style="{StaticResource GhostButton}"
                                        Margin="0,0,8,0" Padding="10,4" Click="SendSlideChatButton_Click"
                                        Visibility="Collapsed"
                                        ToolTip="Attach the visible slide image to chat — not the whole deck. Nothing sends until you press Send."/>
                                <Button x:Name="RegionSelectButton" Content="Select area" Style="{StaticResource GhostButton}"
                                        Margin="0,0,8,0" Padding="10,4" Click="RegionSelectButton_Click"
                                        ToolTip="Drag a box over text or a figure — it parses first, then stages as an attachment"/>
                                <Button x:Name="OpenExternallyButton" Content="Open externally" Visibility="Collapsed"
                                        Style="{StaticResource GhostButton}" Margin="0,0,8,0" Padding="10,4"
                                        Click="OpenExternallyButton_Click"/>
                                <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                                           Foreground="{StaticResource Accent2Brush}" FontSize="11.5" FontWeight="Medium"/>
                                <TextBlock x:Name="ConvertStatusText" Margin="14,0,0,0" VerticalAlignment="Center"
                                           Foreground="#E8ECF4" FontSize="12.5" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" MaxWidth="330"/>
                            </StackPanel>
                        </Border>

                        <!-- Floating handle: hides and shows the summary from the middle of the band -->
                        <Button x:Name="SummaryFloatChip" Content="⌃ Summary"
                                Style="{StaticResource FloatingHandleButton}"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Click="SummaryFloatChip_Click"
                                ToolTip="Hide or show the summary panel"/>
                    </Grid>

                    <Grid>
                        <Border x:Name="PreviewSummaryHost" Padding="22,10,14,4" MaxHeight="104">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Button x:Name="SummaryDockButton" Grid.Column="0" Content="⇤"
                                        Style="{StaticResource MicroIconButton}"
                                        VerticalAlignment="Top" Margin="0,1,10,0"
                                        Click="SummaryDockButton_Click"
                                        ToolTip="Pull the summary to a rail on the left"/>

                                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" MaxHeight="76"
                                              Style="{StaticResource GlassScrollViewer}">
                                    <TextBlock x:Name="SummaryText" Text="Generating summary..."
                                               FontFamily="{StaticResource BodyFont}"
                                               Foreground="{StaticResource TextBrush}"
                                               FontSize="13" LineHeight="19" TextWrapping="Wrap" Opacity="0.94"
                                               Cursor="Hand" MouseLeftButtonUp="SummaryText_MouseLeftButtonUp"/>
                                </ScrollViewer>

                                <Button x:Name="SummaryCollapseButton" Grid.Column="2" Content="⌃"
                                        Style="{StaticResource MicroIconButton}"
                                        VerticalAlignment="Top" Margin="10,1,0,0"
                                        Click="SummaryCollapseButton_Click"
                                        ToolTip="Collapse the summary panel"/>
                            </Grid>
                        </Border>

                        <Border x:Name="PdfEditorRibbon" Visibility="Collapsed" Padding="18,10,18,8"
                                Background="#1A5EC4B8" CornerRadius="0">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock x:Name="PdfRibbonTitle" Text="PDF tools"
                                               FontFamily="{StaticResource DisplayFont}"
                                               FontSize="12" FontWeight="SemiBold" Foreground="#D8FFF8"
                                               Opacity="0.95"/>
                                    <TextBlock x:Name="PdfRibbonHint" DockPanel.Dock="Right"
                                               Text="Pick a mode · tweaks appear below"
                                               Foreground="#80A0A8B8" FontSize="11" VerticalAlignment="Center"/>
                                </DockPanel>

                                <!-- Primary: modes only -->
                                <WrapPanel x:Name="PdfPrimaryRow" Orientation="Horizontal">
                                    <Button x:Name="PdfModeOrganizeBtn" Content="Organize" Style="{StaticResource EditorChip}"
                                            Click="PdfModeOrganize_Click" ToolTip="Pages: reorder, extract, split, rotate, merge"/>
                                    <Button x:Name="PdfModeSignBtn" Content="Sign" Style="{StaticResource EditorChip}"
                                            Click="PdfModeSign_Click" ToolTip="Place a signature — font &amp; library below"/>
                                    <Button x:Name="PdfModeFillBtn" Content="Fill" Style="{StaticResource EditorChip}"
                                            Click="PdfModeFill_Click" ToolTip="Type into table cells and blank lines"/>
                                    <Button x:Name="PdfModeCommentBtn" Content="Comment" Style="{StaticResource EditorChip}"
                                            Click="PdfModeComment_Click" ToolTip="Highlight markup"/>
                                    <Border Width="1" Height="22" Background="#33FFFFFF" Margin="4,0,10,6" VerticalAlignment="Center"/>
                                    <Button x:Name="PdfSaveStampsButton" Content="Save" Style="{StaticResource EditorChipPrimary}"
                                            Click="PdfSaveStamps_Click" ToolTip="Write signatures, typed text, and highlights into this PDF"/>
                                    <Button x:Name="PdfMoreButton" Content="More..." Style="{StaticResource EditorChip}"
                                            Click="PdfMoreButton_Click" ToolTip="Watermark, protect, scan OCR, export">
                                        <Button.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Edit text / OCR…" Click="PdfEditTextMode_Click"
                                                          ToolTip="Edit native text or seed OCR boxes, then Save into this PDF"/>
                                                <Separator/>
                                                <MenuItem Header="Compress…" IsEnabled="False"
                                                          ToolTip="Coming soon — not a fake rewrite"/>
                                                <MenuItem Header="Export as…" Click="PdfExportAsMenu_Click"
                                                          ToolTip="Pick another format via the Share export picker"/>
                                                <Separator/>
                                                <MenuItem Header="Watermark…" Click="PdfWatermark_Click"
                                                          ToolTip="Stamp text across pages (pymupdf)"/>
                                                <MenuItem Header="Protect…" Click="PdfProtect_Click"
                                                          ToolTip="AES-256 password lock"/>
                                                <MenuItem Header="Unlock…" Click="PdfUnlock_Click"
                                                          ToolTip="Remove password (needs the password)"/>
                                                <MenuItem Header="Scan &amp; OCR…" Click="PdfOcr_Click"
                                                          ToolTip="Make a scanned PDF searchable (needs Tesseract)"/>
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                </WrapPanel>

                                <!-- Organize secondary -->
                                <Border x:Name="PdfOrganizePanel" Visibility="Collapsed" Margin="0,4,0,0"
                                        Background="#14000000" CornerRadius="10" Padding="10,8">
                                    <StackPanel>
                                        <TextBlock Text="Pages" FontSize="11" Foreground="#A8FFF8" Margin="0,0,0,6" FontWeight="SemiBold"/>
                                        <WrapPanel>
                                            <Button Content="Reorder…" Style="{StaticResource EditorChip}" Click="PdfOrganize_Click"
                                                    ToolTip="Drag pages · rotate · delete"/>
                                            <Button Content="Merge…" Style="{StaticResource EditorChip}" Click="PdfMerge_Click"/>
                                            <Button Content="Extract…" Style="{StaticResource EditorChip}" Click="PdfExtract_Click"/>
                                            <Button Content="Split" Style="{StaticResource EditorChip}" Click="PdfSplit_Click"/>
                                            <Button Content="Rotate 90°" Style="{StaticResource EditorChip}" Click="PdfRotate90_Click"/>
                                            <Button Content="Reverse" Style="{StaticResource EditorChip}" Click="PdfReverse_Click"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Sign secondary -->
                                <Border x:Name="PdfSignPanel" Visibility="Collapsed" Margin="0,4,0,0"
                                        Background="#14000000" CornerRadius="10" Padding="10,8">
                                    <StackPanel>
                                        <TextBlock Text="Signature" FontSize="11" Foreground="#A8FFF8" Margin="0,0,0,6" FontWeight="SemiBold"/>
                                        <WrapPanel>
                                            <Button Content="New signature" Style="{StaticResource EditorChipPrimary}"
                                                    Click="PdfSignType_Click" ToolTip="Type name · pick font · place on page"/>
                                            <Button Content="My signatures" Style="{StaticResource EditorChip}"
                                                    Click="PdfSignLibrary_Click"/>
                                            <Button Content="Stamp image…" Style="{StaticResource EditorChip}"
                                                    Click="PdfSignStamp_Click"/>
                                            <Border Width="1" Height="22" Background="#33FFFFFF" Margin="4,0,10,6" VerticalAlignment="Center"/>
                                            <TextBlock Text="Font" VerticalAlignment="Center" Foreground="#C0C8D4"
                                                       Margin="0,0,6,6" FontSize="12"/>
                                            <ComboBox x:Name="PdfSignFontCombo" Width="160" Height="34" Margin="0,0,8,6"
                                                      VerticalContentAlignment="Center"
                                                      SelectionChanged="PdfSignFontCombo_SelectionChanged"/>
                                            <Button Content="A−" Style="{StaticResource EditorChip}" Click="PdfSizeDown_Click"
                                                    ToolTip="Smaller selected signature / text" MinWidth="40"/>
                                            <Button Content="A+" Style="{StaticResource EditorChip}" Click="PdfSizeUp_Click"
                                                    ToolTip="Larger selected signature / text" MinWidth="40"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Fill secondary -->
                                <Border x:Name="PdfFillPanel" Visibility="Collapsed" Margin="0,4,0,0"
                                        Background="#14000000" CornerRadius="10" Padding="10,8">
                                    <StackPanel>
                                        <TextBlock Text="Fill &amp; type" FontSize="11" Foreground="#A8FFF8" Margin="0,0,0,6" FontWeight="SemiBold"/>
                                        <WrapPanel>
                                            <TextBlock Text="Click a cell or blank, type, then Save. OCR seeds boxes on scanned pages."
                                                       Foreground="#C0C8D4" FontSize="12" VerticalAlignment="Center"
                                                       Margin="0,0,12,6" TextWrapping="Wrap" MaxWidth="360"/>
                                            <Button Content="OCR this page" Style="{StaticResource EditorChipPrimary}"
                                                    Click="PdfOcrSeed_Click"
                                                    ToolTip="Read the visible page with local OCR and drop editable text boxes"/>
                                            <Button Content="A−" Style="{StaticResource EditorChip}" Click="PdfSizeDown_Click" MinWidth="40"/>
                                            <Button Content="A+" Style="{StaticResource EditorChip}" Click="PdfSizeUp_Click" MinWidth="40"/>
                                            <Button Content="Exit Fill" Style="{StaticResource EditorChip}" Click="PdfExitFill_Click"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Comment secondary -->
                                <Border x:Name="PdfCommentPanel" Visibility="Collapsed" Margin="0,4,0,0"
                                        Background="#14000000" CornerRadius="10" Padding="10,8">
                                    <StackPanel>
                                        <TextBlock Text="Comment" FontSize="11" Foreground="#A8FFF8" Margin="0,0,0,6" FontWeight="SemiBold"/>
                                        <WrapPanel>
                                            <Button Content="Highlight" Style="{StaticResource EditorChip}"
                                                    Click="PdfCommentHighlight_Click"
                                                    ToolTip="Drag on the page to highlight. Save writes it into the PDF."/>
                                            <Button Content="Mark" Style="{StaticResource EditorChip}"
                                                    Click="PdfCommentMark_Click"
                                                    ToolTip="Drag to draw a mark. Save writes it into the PDF."/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border x:Name="VideoEditorRibbon" Visibility="Collapsed" Padding="18,12,18,4"
                                Background="#1A5EC4B8">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <TextBlock Text="Video tools" FontFamily="{StaticResource DisplayFont}"
                                               FontSize="12" FontWeight="SemiBold" Foreground="#D8FFF8"
                                               Opacity="0.9"/>
                                    <TextBlock x:Name="VideoRibbonHint" DockPanel.Dock="Right" Text="Export · + Clip · Order · More"
                                               Foreground="#80A0A8B8" FontSize="11" VerticalAlignment="Center"/>
                                </DockPanel>
                                <WrapPanel x:Name="VideoPrimaryRow" Orientation="Horizontal">
                                    <Button x:Name="ExportEditButton" Content="Export all" Style="{StaticResource EditorChipPrimary}"
                                            Click="ExportEditButton_Click"
                                            ToolTip="Export the full packed timeline (all clips)"/>
                                    <Button x:Name="AddVideoButton" Content="+ Clip" Style="{StaticResource EditorChip}"
                                            Click="AddVideoButton_Click"
                                            ToolTip="Add one or more videos onto V1 -- packs after existing clips in dialog order (no overlap). Drag to reorder. Fade/Wipe still burn on Export."/>
                                    <Button x:Name="OrderClipsButton" Content="Order..." Style="{StaticResource EditorChip}"
                                            Click="OrderClipsButton_Click"
                                            ToolTip="Arrange V1 clip order before Export. Top plays first. Drag or Up/Down."/>
                                    <Border Width="1" Height="22" Background="#33FFFFFF" Margin="4,0,10,6" VerticalAlignment="Center"/>
                                    <Button x:Name="VideoMoreButton" Content="More..." Style="{StaticResource EditorChip}"
                                            Click="VideoMoreButton_Click"
                                            ToolTip="Export range, resolution preset, LUT">
                                        <Button.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Export range (In to Out)" Click="TrimVideoButton_Click"
                                                          ToolTip="Export only Mark In to Mark Out"/>
                                                <Separator/>
                                                <MenuItem x:Name="VideoPresetMatchMenu" Header="Preset: Match source"
                                                          Click="ExportPresetButton_Click" Tag="MatchSource"/>
                                                <MenuItem x:Name="VideoPreset1080Menu" Header="Preset: 1080p"
                                                          Click="ExportPresetButton_Click" Tag="Hd1080"/>
                                                <MenuItem x:Name="VideoPreset4KMenu" Header="Preset: 4K"
                                                          Click="ExportPresetButton_Click" Tag="Uhd4K"/>
                                                <Separator/>
                                                <MenuItem Header="LUT..." Click="LutButton_Click"
                                                          ToolTip="Apply .cube LUT on Export timeline"/>
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- Body — opaque content well (hero), chrome yields -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SummaryRailColumn" Width="0"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition x:Name="ChatColumn" Width="0"/>
                </Grid.ColumnDefinitions>

                <!-- Summary docked left: same text, out of the way of the page -->
                <Border x:Name="SummaryRail" Grid.Column="0" Visibility="Collapsed"
                        Background="#1A000000" BorderBrush="{StaticResource GlassHighlight}"
                        BorderThickness="0,0,1,0" Padding="14,12,10,12" ClipToBounds="True">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Content="⇥" Style="{StaticResource MicroIconButton}"
                                    Click="SummaryUndockButton_Click"
                                    ToolTip="Put the summary back on top"/>
                            <TextBlock Text="Summary" FontFamily="{StaticResource DisplayFont}"
                                       Foreground="{StaticResource Accent2Brush}"
                                       FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </DockPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      Style="{StaticResource GlassScrollViewer}">
                            <!-- Mirrors the top strip so every existing summary write reaches both -->
                            <TextBlock x:Name="SummaryRailText"
                                       Text="{Binding Text, ElementName=SummaryText, Mode=OneWay}"
                                       FontFamily="{StaticResource BodyFont}"
                                       Foreground="{StaticResource TextBrush}"
                                       FontSize="12.5" LineHeight="18.5" TextWrapping="Wrap" Opacity="0.94"
                                       Cursor="Hand" MouseLeftButtonUp="SummaryText_MouseLeftButtonUp"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <Border Grid.Column="1" Background="{StaticResource ContentWellBrush}"
                        CornerRadius="0,0,22,22" ClipToBounds="True" Margin="1,0,1,1">
                <Grid ClipToBounds="True" x:Name="ContentHost">
                    <Border CornerRadius="0,0,21,21" ClipToBounds="True">
                    <Grid>
                    <ScrollViewer x:Name="ImageScroll" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                  PanningMode="Both"
                                  Style="{StaticResource GlassScrollViewer}"
                                  PreviewMouseWheel="ImageScroll_PreviewMouseWheel"
                                  SizeChanged="ImageScroll_SizeChanged"
                                  IsManipulationEnabled="True"
                                  ManipulationDelta="ImageScroll_ManipulationDelta"
                                  ManipulationInertiaStarting="ImageScroll_ManipulationInertiaStarting">
                        <Grid x:Name="ImageCanvas" Background="Transparent">
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16">
                                <Rectangle x:Name="ImageAlphaBoard" RadiusX="8" RadiusY="8"
                                           Visibility="Collapsed"
                                           Width="{Binding ActualWidth, ElementName=PreviewImage}"
                                           Height="{Binding ActualHeight, ElementName=PreviewImage}">
                                    <Rectangle.Fill>
                                        <DrawingBrush TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute">
                                            <DrawingBrush.Drawing>
                                                <DrawingGroup>
                                                    <GeometryDrawing Brush="#FF2A3140">
                                                        <GeometryDrawing.Geometry>
                                                            <RectangleGeometry Rect="0,0,16,16"/>
                                                        </GeometryDrawing.Geometry>
                                                    </GeometryDrawing>
                                                    <GeometryDrawing Brush="#FF3A4252">
                                                        <GeometryDrawing.Geometry>
                                                            <GeometryGroup>
                                                                <RectangleGeometry Rect="0,0,8,8"/>
                                                                <RectangleGeometry Rect="8,8,8,8"/>
                                                            </GeometryGroup>
                                                        </GeometryDrawing.Geometry>
                                                    </GeometryDrawing>
                                                </DrawingGroup>
                                            </DrawingBrush.Drawing>
                                        </DrawingBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                                <Image x:Name="PreviewImage" Stretch="Uniform"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       MouseLeftButtonDown="PreviewImage_MouseLeftButtonDown"
                                       MouseMove="PreviewImage_MouseMove"
                                       MouseLeftButtonUp="PreviewImage_MouseLeftButtonUp"
                                       MouseLeave="PreviewImage_MouseLeave"
                                       ToolTip="Drag out to copy the file">
                                    <Image.LayoutTransform>
                                        <ScaleTransform x:Name="ImageScale" ScaleX="1" ScaleY="1"/>
                                    </Image.LayoutTransform>
                                </Image>
                            </Grid>
                        </Grid>
                    </ScrollViewer>

                    <wv2:WebView2 x:Name="PreviewWebView"
                                  Visibility="Visible"
                                  SizeChanged="PreviewWebView_SizeChanged"/>

                    <!-- Captures image drops over WebView2 HWND when a PDF is open -->
                    <Border x:Name="PdfDropOverlay" Visibility="Collapsed" Background="#66000000"
                            AllowDrop="True" Panel.ZIndex="30"
                            DragOver="PdfDropOverlay_DragOver"
                            DragLeave="PdfDropOverlay_DragLeave"
                            Drop="Window_Drop">
                        <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                                Padding="28,18" CornerRadius="16"
                                Background="#40000000" BorderBrush="#665EC4B8" BorderThickness="1">
                            <TextBlock Text="Drop Word / image / PDF to append pages"
                                       FontFamily="{StaticResource DisplayFont}"
                                       Foreground="{StaticResource TextBrush}"
                                       FontSize="15" FontWeight="SemiBold"/>
                        </Border>
                    </Border>

                    <!-- Soft corner masks so HWND WebView2 doesn't read as a sharp rectangle -->
                    <Canvas x:Name="CornerMaskLayer" IsHitTestVisible="False" Panel.ZIndex="20">
                        <Path x:Name="CornerTL" Fill="{StaticResource ContentWellBrush}"/>
                        <Path x:Name="CornerTR" Fill="{StaticResource ContentWellBrush}"/>
                        <Path x:Name="CornerBL" Fill="{StaticResource ContentWellBrush}"/>
                        <Path x:Name="CornerBR" Fill="{StaticResource ContentWellBrush}"/>
                    </Canvas>

                    <!-- Video: light autoplay preview; Edit expands full Netie editor -->
                    <Grid x:Name="VideoPanel" Visibility="Collapsed" Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <MediaElement x:Name="PreviewVideo"
                                      Grid.Row="0"
                                      LoadedBehavior="Manual"
                                      UnloadedBehavior="Stop"
                                      ScrubbingEnabled="True"
                                      Stretch="Uniform"
                                      MediaOpened="PreviewVideo_MediaOpened"
                                      MediaEnded="PreviewVideo_MediaEnded"/>
                        <Border Grid.Row="1" Margin="0,12,0,0" Padding="14,12" CornerRadius="16"
                                Background="#1AFFFFFF" BorderBrush="#40FFFFFF" BorderThickness="1">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="PlayPauseButton" Content="Pause" Style="{StaticResource AccentButton}"
                                            Click="PlayPauseButton_Click" Width="78" Padding="12,8"/>
                                    <Grid Grid.Column="1" Margin="14,0" VerticalAlignment="Center"
                                          SizeChanged="VideoSliderHost_SizeChanged">
                                        <Border Height="5" VerticalAlignment="Center" CornerRadius="2.5"
                                                Background="#28FFFFFF" Margin="6,0" IsHitTestVisible="False"/>
                                        <Border x:Name="MarkRangeTint" Height="5" VerticalAlignment="Center"
                                                CornerRadius="2.5" Background="#665EC4B8"
                                                HorizontalAlignment="Left" Width="0" Margin="6,0,0,0"
                                                Visibility="Collapsed" IsHitTestVisible="False"/>
                                        <Slider x:Name="VideoSlider"
                                                VerticalAlignment="Center"
                                                Minimum="0" Maximum="1"
                                                IsMoveToPointEnabled="True"
                                                Background="Transparent"
                                                PreviewMouseLeftButtonDown="VideoSlider_PreviewMouseDown"
                                                PreviewMouseLeftButtonUp="VideoSlider_PreviewMouseUp"
                                                LostMouseCapture="VideoSlider_LostMouseCapture"
                                                ValueChanged="VideoSlider_ValueChanged"/>
                                    </Grid>
                                    <TextBlock x:Name="VideoTimeText" Grid.Column="2"
                                               VerticalAlignment="Center" MinWidth="110"
                                               Foreground="{StaticResource MutedBrush}" FontSize="12"
                                               Text="00:00 / 00:00"/>
                                </Grid>

                                <TextBlock x:Name="VideoLightHint" Margin="0,10,0,0"
                                           Text="Light preview — press Edit for the full Netie video editor (timeline, split, export)."
                                           Foreground="{StaticResource MutedBrush}" FontSize="12.5"
                                           TextWrapping="Wrap"/>

                                <!-- Full editor chrome (hidden until Edit) -->
                                <StackPanel x:Name="VideoEditorChrome" Visibility="Collapsed" Margin="0,10,0,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                    <Button Content="Mark In" Style="{StaticResource EditorChip}"
                                            Click="MarkInButton_Click" ToolTip="Set Mark In at playhead"/>
                                    <Button Content="Mark Out" Style="{StaticResource EditorChip}"
                                            Click="MarkOutButton_Click" ToolTip="Set Mark Out at playhead"/>
                                    <TextBlock x:Name="MarkRangeText" VerticalAlignment="Center"
                                               Foreground="{StaticResource Accent2Brush}" FontSize="12"
                                               Text="In — · Out —"/>
                                </StackPanel>

                                <!-- Multi-track timeline (V1 / A1 / A2) -->
                                <Border Margin="0,12,0,0" Padding="12,10" CornerRadius="12"
                                        Background="#14FFFFFF" BorderBrush="#28FFFFFF" BorderThickness="1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <WrapPanel>
                                            <Button x:Name="SplitButton" Content="✂ Split" Margin="0,0,8,6"
                                                    Style="{StaticResource EditorChipPrimary}"
                                                    Click="SplitAtPlayhead_Click"
                                                    ToolTip="Cut at playhead into two clips"/>
                                            <Button x:Name="CutMiddleButton" Content="Delete" Margin="0,0,8,6"
                                                    Style="{StaticResource EditorChipPrimary}"
                                                    IsEnabled="False" Click="CutMiddleButton_Click"
                                                    ToolTip="Select a clip first — remove it (merge or black gap)"/>
                                            <Button x:Name="BladeModeButton" Content="Select" Margin="0,0,8,6"
                                                    Style="{StaticResource EditorChip}"
                                                    Click="BladeModeButton_Click"
                                                    ToolTip="Click a clip to select, then Delete or drag to reorder"/>
                                            <Button Content="Fade In" Style="{StaticResource EditorChip}" Margin="0,0,8,6"
                                                    Click="FadeInButton_Click" ToolTip="0.5s fade in on selected clip"/>
                                            <Button Content="Fade Out" Style="{StaticResource EditorChip}" Margin="0,0,8,6"
                                                    Click="FadeOutButton_Click" ToolTip="0.5s fade out on selected clip"/>
                                            <Button Content="Wipe" Style="{StaticResource EditorChip}" Margin="0,0,8,6"
                                                    Click="WipeButton_Click"
                                                    ToolTip="0.5s wipe into the next clip (ffmpeg xfade wipeleft) — burns on Export"/>
                                            <Button Content="Text" Style="{StaticResource EditorChip}" Margin="0,0,8,6"
                                                    Click="OverlayTextButton_Click"
                                                    ToolTip="Overlay text on the canvas at the playhead — burns into Export"/>
                                            <Button Content="Captions" Style="{StaticResource EditorChip}" Margin="0,0,8,6"
                                                    Click="AutoCaptionsButton_Click"
                                                    ToolTip="Local AI subtitles (whisper.cpp) — ZH+EN auto"/>
                                            <TextBlock x:Name="TimelineHintText"
                                                       Text="Move playhead → Split → select clip → Delete"
                                                       FontFamily="{StaticResource BodyFont}"
                                                       Foreground="#E8FFFFFF"
                                                       FontSize="12" FontWeight="SemiBold"
                                                       VerticalAlignment="Center" Margin="0,0,0,6"
                                                       TextWrapping="Wrap"/>
                                        </WrapPanel>

                                        <!-- V1 -->
                                        <DockPanel Grid.Row="1" Margin="0,10,0,0" LastChildFill="True">
                                            <TextBlock Text="V1" Width="28" VerticalAlignment="Center"
                                                       Foreground="{StaticResource Accent2Brush}" FontSize="12" FontWeight="Bold"/>
                                            <Grid x:Name="TimelineTrackHost" Height="48"
                                                  Background="#18000000"
                                                  SizeChanged="TimelineTrackHost_SizeChanged"
                                                  PreviewMouseLeftButtonDown="TimelineTrack_PreviewMouseLeftButtonDown"
                                                  PreviewMouseMove="TimelineTrack_PreviewMouseMove"
                                                  PreviewMouseLeftButtonUp="TimelineTrack_PreviewMouseLeftButtonUp"
                                                  LostMouseCapture="TimelineTrack_LostMouseCapture"
                                                  PreviewMouseRightButtonUp="TimelineTrack_PreviewMouseRightButtonUp">
                                                <Border Height="36" VerticalAlignment="Center" CornerRadius="8"
                                                        Background="#2AFFFFFF" IsHitTestVisible="False"/>
                                                <Canvas x:Name="TimelineClipCanvas" Height="36" VerticalAlignment="Center"
                                                        IsHitTestVisible="True"/>
                                                <Border x:Name="TimelineKeepRange" Height="36" VerticalAlignment="Center"
                                                        CornerRadius="6" Background="Transparent"
                                                        HorizontalAlignment="Left" Width="0"
                                                        IsHitTestVisible="False" Visibility="Collapsed"/>
                                                <Border x:Name="TimelineDimLeft" Height="36" VerticalAlignment="Center"
                                                        CornerRadius="8,0,0,8" Background="#66000000"
                                                        HorizontalAlignment="Left" Width="0"
                                                        IsHitTestVisible="False"/>
                                                <Border x:Name="TimelineDimRight" Height="36" VerticalAlignment="Center"
                                                        CornerRadius="0,8,8,0" Background="#66000000"
                                                        HorizontalAlignment="Left" Width="0"
                                                        IsHitTestVisible="False"/>
                                                <Border x:Name="TimelinePlayhead" Width="3" Height="48"
                                                        VerticalAlignment="Center" Background="#FF5EC4B8"
                                                        HorizontalAlignment="Left" Margin="0"
                                                        IsHitTestVisible="False"/>
                                                <Border x:Name="TimelineInHandle" Width="12" Height="40"
                                                        VerticalAlignment="Center" CornerRadius="3"
                                                        Background="#5EC4B8" Cursor="SizeWE"
                                                        HorizontalAlignment="Left"
                                                        BorderBrush="#FFFFFF" BorderThickness="1"
                                                        ToolTip="Drag Mark In"/>
                                                <Border x:Name="TimelineOutHandle" Width="12" Height="40"
                                                        VerticalAlignment="Center" CornerRadius="3"
                                                        Background="#5EC4B8" Cursor="SizeWE"
                                                        HorizontalAlignment="Left"
                                                        BorderBrush="#FFFFFF" BorderThickness="1"
                                                        ToolTip="Drag Mark Out"/>
                                            </Grid>
                                        </DockPanel>

                                        <!-- A1 -->
                                        <DockPanel Grid.Row="2" Margin="0,4,0,0" LastChildFill="True">
                                            <TextBlock Text="A1" Width="28" VerticalAlignment="Center"
                                                       Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                                            <Grid x:Name="AudioTrack1Host" Height="22" Background="#12FFFFFF"
                                                  PreviewMouseLeftButtonDown="AudioTrack_PreviewMouseLeftButtonDown"
                                                  Tag="A1">
                                                <Canvas x:Name="AudioTrack1Canvas" Height="18" VerticalAlignment="Center"/>
                                            </Grid>
                                        </DockPanel>

                                        <!-- A2 (music / mute lane) -->
                                        <DockPanel Grid.Row="3" Margin="0,4,0,0" LastChildFill="True">
                                            <TextBlock Text="A2" Width="28" VerticalAlignment="Center"
                                                       Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                                            <Grid x:Name="AudioTrack2Host" Height="22" Background="#12FFFFFF"
                                                  AllowDrop="True"
                                                  PreviewMouseLeftButtonDown="AudioTrack_PreviewMouseLeftButtonDown"
                                                  Tag="A2"
                                                  ToolTip="Drop or move clips here for music / mute lane">
                                                <Canvas x:Name="AudioTrack2Canvas" Height="18" VerticalAlignment="Center"/>
                                            </Grid>
                                        </DockPanel>

                                        <!-- CC captions track -->
                                        <DockPanel Grid.Row="4" Margin="0,6,0,0" LastChildFill="True">
                                            <TextBlock Text="CC" Width="28" VerticalAlignment="Center"
                                                       Foreground="{StaticResource Accent2Brush}" FontSize="11" FontWeight="Bold"/>
                                            <Grid x:Name="CaptionTrackHost" Height="28" Background="#12FFFFFF"
                                                  ToolTip="Caption cues — drag to shift timing">
                                                <Canvas x:Name="CaptionTrackCanvas" Height="24" VerticalAlignment="Center"/>
                                            </Grid>
                                        </DockPanel>
                                    </Grid>
                                </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border x:Name="LoadingOverlay" Visibility="Collapsed">
                        <Border.Background>
                            <SolidColorBrush Color="#10141C" Opacity="0.72"/>
                        </Border.Background>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Border Padding="28,20" CornerRadius="16" BorderBrush="#38FFFFFF" BorderThickness="1"
                                    Background="#28FFFFFF">
                                <StackPanel>
                                    <TextBlock Text="Loading…"
                                               FontFamily="{StaticResource DisplayFont}"
                                               Foreground="{StaticResource TextBrush}"
                                               FontSize="17" FontWeight="SemiBold"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="LoadingText" Text=""
                                               FontFamily="{StaticResource BodyFont}"
                                               Foreground="{StaticResource MutedBrush}"
                                               FontSize="12" Margin="0,8,0,0"
                                               HorizontalAlignment="Center"/>
                                    <ProgressBar x:Name="LoadingProgress" Height="4" Margin="0,14,0,0"
                                                   Minimum="0" Maximum="100" Value="0"
                                                   Visibility="Collapsed"
                                                   Foreground="{StaticResource Accent2Brush}"
                                                   Background="#28FFFFFF"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                    </Grid>
                    </Border>
                </Grid>
                </Border>

                <controls:ChatPanel x:Name="ChatPanel" Grid.Column="2" Visibility="Collapsed"/>
            </Grid>
        </Grid>
            </Grid>
        </Border>
    </Border>
</Window>
