                                <MenuItem Header="_View">
                                    <MenuItem Header="Previous page" Click="DocPrev_Click"/>
                                    <MenuItem Header="Next page" Click="DocNext_Click"/>
                                    <MenuItem Header="Fit page" Click="DocFit_Click"/>
                                    <MenuItem Header="Zoom in" Click="DocZoomIn_Click"/>
                                    <MenuItem Header="Zoom out" Click="DocZoomOut_Click"/>
                                    <Separator/>
                                    <MenuItem Header="Page thumbnails" Click="DocThumbsToggle_Click"/>
                                </MenuItem>
                                <MenuItem Header="_Help">
                                    <MenuItem Header="Settings…" Click="SetupHelpButton_Click"/>
                                </MenuItem>
                            </Menu>
                        </DockPanel>
                    </Border>
                    <Border Height="36" BorderBrush="#E8E8E8" BorderThickness="0,0,0,1">
                        <DockPanel Margin="8,0,12,0">
                            <Button x:Name="DocHomeTab" DockPanel.Dock="Left" Content="Home"
                                    Style="{StaticResource DocTabBtn}" Click="EditInAppButton_Click"
                                    ToolTip="Leave workbench"/>
                            <Button x:Name="DocToolsTab" DockPanel.Dock="Left" Content="Tools"
                                    Style="{StaticResource DocTabOn}" Click="DocToolsTab_Click"
                                    ToolTip="Document tools on the right"/>
                            <Border x:Name="DocFileTab" DockPanel.Dock="Left"
                                    Background="#FFFFFF" BorderBrush="#0B5CAB" BorderThickness="1,1,1,0"
                                    Padding="12,6" Margin="8,6,0,0" CornerRadius="4,4,0,0"
                                    VerticalAlignment="Bottom">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="✕" Width="18" Height="18" Margin="8,0,0,0"
                                            Style="{StaticResource DocIconBtn}" FontFamily="Segoe UI" FontSize="10"
                                            Click="EditInAppButton_Click" ToolTip="Close this document"/>
                                    <TextBlock x:Name="DocFileTabText" Text="Document"
                                               FontFamily="{StaticResource BodyFont}"
                                               Foreground="#2C2C2C" FontSize="12" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" MaxWidth="280"
                                               VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                            <Border/>
                        </DockPanel>
                    </Border>
                </DockPanel>
                </Grid>
            </Border>

            <!-- Preview summary OR native editor ribbon (Apple morph swap) -->
            <Border x:Name="RibbonBand" Grid.Row="1" BorderBrush="{StaticResource GlassHighlight}" BorderThickness="0,0,0,1"
                    Background="#16000000" AllowDrop="True"
                    DragOver="PdfChrome_DragOver" Drop="Window_Drop">
                <DockPanel>
                    <Border x:Name="DocNavBar" DockPanel.Dock="Top" Visibility="Collapsed"
                            Background="#F3F3F3" BorderBrush="#D6D6D6" BorderThickness="0,0,0,1"
                            Padding="8,4">
                        <DockPanel>
                            <Button x:Name="DocShareBtn" DockPanel.Dock="Right" Content="Share"
                                    Style="{StaticResource DocShareBtn}" Click="ShareButton_Click"
                                    Visibility="Collapsed"
                                    ToolTip="Share this file or a converted copy"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="PdfSaveStampsButton" Content="&#xE74E;"
                                        Style="{StaticResource DocIconBtn}" Click="PdfSaveStamps_Click"
                                        ToolTip="Save — write signatures, typed text, and highlights into this PDF"/>
                                <Button Content="&#xE721;" Style="{StaticResource DocIconBtn}"
                                        Click="DocMenuFind_Click" ToolTip="Find in PDF"/>
                                <TextBox x:Name="DocSearchBox" Width="148" Height="28" Margin="4,0,8,0"
                                         VerticalContentAlignment="Center" FontSize="12"
                                         BorderBrush="#D6D6D6" BorderThickness="1" Padding="8,2"
                                         ToolTip="Find in PDF" KeyDown="DocSearchBox_KeyDown"/>
                                <Border Width="1" Height="22" Background="#D6D6D6" Margin="4,0" VerticalAlignment="Center"/>
                                <Button x:Name="DocPrevBtn" Content="&#xE70E;" Style="{StaticResource DocIconBtn}"
                                        Click="DocPrev_Click" ToolTip="Previous page"/>
                                <TextBox x:Name="DocPageBox" Width="36" Height="28" Margin="4,0,2,0"
                                         Text="1" TextAlignment="Center" VerticalContentAlignment="Center"
                                         FontSize="12" BorderBrush="#D6D6D6" BorderThickness="1"
                                         KeyDown="DocPageBox_KeyDown"/>
                                <TextBlock x:Name="DocPageTotal" Text="/ 1" VerticalAlignment="Center"
                                           Foreground="#6E6E6E" FontSize="12" Margin="0,0,4,0"/>
                                <Button x:Name="DocNextBtn" Content="&#xE70D;" Style="{StaticResource DocIconBtn}"
                                        Click="DocNext_Click" ToolTip="Next page"/>
                                <Border Width="1" Height="22" Background="#D6D6D6" Margin="8,0" VerticalAlignment="Center"/>
                                <Button x:Name="DocZoomOutBtn" Content="&#xE738;" Style="{StaticResource DocIconBtn}"
                                        Click="DocZoomOut_Click" ToolTip="Zoom out"/>
                                <TextBlock x:Name="DocZoomLabel" Text="100%" VerticalAlignment="Center"
                                           Foreground="#2C2C2C" FontSize="12" FontWeight="SemiBold"
                                           MinWidth="44" TextAlignment="Center"/>
