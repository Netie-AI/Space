<Window x:Class="NetieSpace.Views.StartupHud"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NETIE SPACE"
        Width="360" Height="96"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        Loaded="Window_Loaded">

    <Border x:Name="Root" Margin="0" Background="Transparent">
        <Border CornerRadius="14" BorderThickness="1"
                BorderBrush="{StaticResource GlassBorder}" Padding="16,12" ClipToBounds="True">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#A8181C28" Offset="0"/>
                    <GradientStop Color="#78101420" Offset="0.55"/>
                    <GradientStop Color="#90101828" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="40" Height="40" CornerRadius="12" Margin="0,0,12,0"
                        Background="#10141C" ClipToBounds="True">
                    <Image Source="pack://application:,,,/Assets/netie-icon.png"
                           Stretch="UniformToFill"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="NETIE SPACE"
                               FontFamily="{StaticResource DisplayFont}"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"/>
                    <TextBlock x:Name="ProviderText" Text="AI · READY"
                               FontFamily="{StaticResource BodyFont}"
                               FontSize="11" FontWeight="Medium" Foreground="{StaticResource MutedBrush}"
                               Margin="0,4,0,0"/>
                    <TextBlock Text="SELECT A FILE · PRESS SPACE"
                               FontFamily="{StaticResource BodyFont}"
                               FontSize="10" FontWeight="Medium" Foreground="{StaticResource Accent2Brush}"
                               Margin="0,4,0,0" Opacity="0.85"/>
                </StackPanel>
            </Grid>
        </Border>
    </Border>
</Window>
