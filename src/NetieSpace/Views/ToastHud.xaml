<Window x:Class="NetieSpace.Views.ToastHud"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NETIE SPACE" Width="400" Height="118"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        Loaded="Window_Loaded" MouseLeftButtonUp="Root_MouseLeftButtonUp"
        Cursor="Hand">
    <Border x:Name="Root" Margin="0" Background="Transparent">
        <Border CornerRadius="14" BorderBrush="{StaticResource GlassBorder}" BorderThickness="1"
                Padding="16,12" ClipToBounds="True">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#A8181C28" Offset="0"/>
                    <GradientStop Color="#78101420" Offset="0.55"/>
                    <GradientStop Color="#90101828" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="36" Height="36" CornerRadius="10" Margin="0,0,12,0"
                        Background="{StaticResource AccentBrush}">
                    <TextBlock Text="✓" FontSize="18" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" Text="Export complete"
                               FontFamily="{StaticResource DisplayFont}"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"/>
                    <TextBlock x:Name="BodyText" Text=""
                               FontFamily="{StaticResource BodyFont}"
                               FontSize="12" Foreground="{StaticResource MutedBrush}"
                               Margin="0,4,0,0" TextWrapping="Wrap"/>
                    <TextBlock Text="Click to open folder · auto-dismiss"
                               FontFamily="{StaticResource BodyFont}"
                               FontSize="10.5" Foreground="{StaticResource Accent2Brush}"
                               Margin="0,6,0,0" Opacity="0.85"/>
                </StackPanel>
            </Grid>
        </Border>
    </Border>
</Window>
