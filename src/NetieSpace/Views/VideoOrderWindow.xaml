<Window x:Class="NetieSpace.Views.VideoOrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clip order — NETIE SPACE"
        Width="520" Height="440"
        MinWidth="400" MinHeight="320"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        Topmost="True"
        ResizeMode="CanResizeWithGrip"
        Loaded="Window_Loaded">

    <Border x:Name="RootBorder" Margin="0" Background="Transparent">
        <Border CornerRadius="16" BorderThickness="1"
                BorderBrush="{StaticResource GlassBorder}" ClipToBounds="True">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1" Opacity="0.90">
                    <GradientStop Color="#E6181C28" Offset="0"/>
                    <GradientStop Color="#D0101420" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="48"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" BorderBrush="#28FFFFFF" BorderThickness="0,0,0,1"
                        Background="#F0141820"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid Margin="16,0">
                        <TextBlock Text="V1 — clip order" FontFamily="{StaticResource DisplayFont}"
                                   Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <Button Content="X" Style="{StaticResource IconCloseButton}"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Click="CloseButton_Click"/>
                    </Grid>
                </Border>

                <TextBlock Grid.Row="1" Margin="16,10,16,6"
                           Text="Top clip plays first. Drag or use Up/Down. Export uses this packed order (Fade/Wipe still join mixed files)."
                           Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap"/>

                <Border Grid.Row="2" Margin="12,0,12,6" CornerRadius="4" Background="#F00E1218"
                        BorderBrush="#33FFFFFF" BorderThickness="1" ClipToBounds="True">
                    <ListBox x:Name="ClipList" Background="Transparent" BorderThickness="0" Padding="6"
                             AllowDrop="True"
                             PreviewMouseLeftButtonDown="ClipList_PreviewMouseLeftButtonDown"
                             PreviewMouseMove="ClipList_PreviewMouseMove"
                             DragOver="ClipList_DragOver"
                             Drop="ClipList_Drop">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,2"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="bd" CornerRadius="4" Padding="10,8"
                                                    Background="#18FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#445EC4B8"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Badge}" Foreground="{StaticResource Accent2Brush}"
                                               FontSize="12" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Title}"
                                               Foreground="{StaticResource TextBrush}" FontSize="13.5"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Duration}"
                                               Foreground="{StaticResource MutedBrush}" FontSize="12"
                                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <WrapPanel Grid.Row="3" Margin="12,4,12,6">
                    <Button Content="Up" Style="{StaticResource EditorChip}" Click="MoveUp_Click" Margin="0,0,8,6"/>
                    <Button Content="Down" Style="{StaticResource EditorChip}" Click="MoveDown_Click" Margin="0,0,8,6"/>
                </WrapPanel>

                <DockPanel Grid.Row="4" Margin="12,0,12,12" LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
                        <Button Content="Cancel" Style="{StaticResource EditorChip}" Margin="0,0,8,0"
                                IsCancel="True" Click="CloseButton_Click"/>
                        <Button Content="Apply order" Style="{StaticResource EditorChipPrimary}"
                                IsDefault="True" Click="Apply_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="StatusText"
                               Foreground="{StaticResource Accent2Brush}" FontSize="12"
                               VerticalAlignment="Center" TextWrapping="Wrap"/>
                </DockPanel>
            </Grid>
        </Border>
    </Border>
</Window>
