<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Windows: the WinRT TFM plus WPF, so engine code under Apps/Tools is tested against
      the same surface the WinExe ships (WinRtSmokeTests proves the TFM move is real).
      Linux (scripts/ci-cursor.sh): plain net8.0, WinRT tests compile out under #if WINDOWS.
    -->
    <!-- -p:NetieWindowsTests=true compile-checks the Windows shape from Linux (no run). -->
    <NetieWindowsTests Condition="'$(NetieWindowsTests)' == ''">$([MSBuild]::IsOSPlatform('Windows'))</NetieWindowsTests>
    <TargetFramework Condition="'$(NetieWindowsTests)' == 'true'">net8.0-windows10.0.19041.0</TargetFramework>
    <TargetFramework Condition="'$(NetieWindowsTests)' != 'true'">net8.0</TargetFramework>
    <UseWPF Condition="'$(NetieWindowsTests)' == 'true'">true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>NetieSpace.Tests</RootNamespace>
    <!-- Linked DPAPI sources are Windows-only; this suite only ever runs on Windows. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="8.0.1" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="PdfSharpCore" Version="1.3.65" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- UseWPF drops these two from the implicit usings; the suite is written against them. -->
  <ItemGroup Condition="'$(NetieWindowsTests)' == 'true'">
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
  </ItemGroup>

  <!--
    Do not ProjectReference the WPF WinExe. testhost loads App.xaml, takes the
    single-instance mutex, and hangs Restore/build/test on windows-latest.
  -->
  <ItemGroup>
    <Compile Include="..\..\src\NetieSpace\GlobalUsings.cs" Link="Linked\GlobalUsings.cs" />
    <Compile Include="..\..\src\NetieSpace\Services\VideoEditSession.cs" Link="Linked\VideoEditSession.cs" />
    <Compile Include="..\..\src\NetieSpace\Services\Timeline\TimelineProject.cs" Link="Linked\TimelineProject.cs" />
    <Compile Include="..\..\src\NetieSpace\Services\CortexWasmPolicy.cs" Link="Linked\CortexWasmPolicy.cs" />
    <Compile Include="..\..\src\NetieSpace\Services\FfmpegExportGraph.cs" Link="Linked\FfmpegExportGraph.cs" />
    <Compile Include="..\..\src\NetieSpace\Services\FfmpegService.cs" Link="Linked\FfmpegService.cs" />
    <Compile Include="..\..\src\NetieSpace\Helpers\AppLogger.cs" Link="Linked\AppLogger.cs" />
    <Compile Include="..\..\src\NetieSpace\Helpers\ProjectRoot.cs" Link="Linked\ProjectRoot.cs" />
    <Compile Include="..\..\src\NetieSpace\Services\ComfyUiClient.cs" Link="Linked\ComfyUiClient.cs" />
    <Compile Include="..\..\src\NetieSpace\Services\WindowsAiClient.cs" Link="Linked\WindowsAiClient.cs" />
    <Compile Include="..\..\src\NetieSpace\Services\PdfCmsSigner.cs" Link="Linked\PdfCmsSigner.cs" />
    <Compile Include="..\..\src\NetieSpace\Services\PdfClassicXref.cs" Link="Linked\PdfClassicXref.cs" />
    <Compile Include="..\..\src\NetieSpace\Services\Licensing\LicenseOffline.cs" Link="Linked\LicenseOffline.cs" />
    <Compile Include="..\..\src\NetieSpace\Helpers\EnvLoader.cs" Link="Linked\EnvLoader.cs" />
    <Compile Include="..\..\src\NetieSpace\Services\FillProfileStore.cs" Link="Linked\FillProfileStore.cs" />
    <Compile Include="..\..\src\NetieSpace\Services\FillProfileHarvest.cs" Link="Linked\FillProfileHarvest.cs" />
    <Compile Include="..\..\src\NetieSpace\Apps\Shell\AppIdentity.cs" Link="Linked\Apps\Shell\AppIdentity.cs" />
    <Compile Include="..\..\src\NetieSpace\Apps\Shell\AppLaunch.cs" Link="Linked\Apps\Shell\AppLaunch.cs" />
    <Compile Include="..\..\src\NetieSpace\Apps\Tools\**\*.cs" Link="Linked\Apps\Tools\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Fixtures\xrefstream-mupdf.pdf" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\NetieSpace\Assets\pdfjs\sample.pdf" Link="Fixtures\sample.pdf" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\tests\fixtures\preview\Q3_Report.pdf" Link="Fixtures\Q3_Report.pdf" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
